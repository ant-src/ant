// Parallel CPU work: N goroutines each compute fib(28) with no shared state. N is the first
// argument (default 8). With true parallelism the wall time stays flat as N grows up to the
// core count; under a global lock it grows linearly.
func fib(n: int): int { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }

func main(): void {
  var args = Os.args()
  var n = 8
  if Array.length(args) > 0 {
    var r = Json.parse(args[0])
    if r is Ok {
      var v = r.value
      if v is float64 { n = int(v) }
    }
  }
  var wg = WaitGroup.new()
  var lock = Mutex.new()
  var total = 0
  for i in Iter.range(0, n) {
    WaitGroup.add(wg, 1)
    go {
      defer { WaitGroup.done(wg) }
      var f = fib(28)
      Mutex.withLock(lock, { total += f })
    }
  }
  WaitGroup.wait(wg)
  print(total)
}
