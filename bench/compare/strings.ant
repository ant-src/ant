// Template strings, concatenation, join, and code point functions.
func main(): void {
  var parts: Array[string] = []
  for i in Iter.range(0, 50000) { Array.push(parts, `item-${i}`) }
  var joined = String.join(parts, ",")
  var acc = ""
  for i in Iter.range(0, 5000) { acc = acc + String.from(i % 10) }
  var upper = String.toUpper(joined)
  print(String.length(joined) + String.length(acc) + Array.length(String.split(upper, ",")))
}
