// Array push, index reads and writes, and the library's map and filter.
func main(): void {
  var xs: Array[int] = []
  for i in Iter.range(0, 200000) { Array.push(xs, i) }
  var total = 0
  var i = 0
  while i < Array.length(xs) {
    xs[i] = xs[i] * 2
    total += xs[i]
    i += 1
  }
  var evens = Array.filter(Array.map(xs, { x + 1 }), { x % 2 == 0 })
  print(total + Array.length(evens))
}
