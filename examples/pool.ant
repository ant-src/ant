// spec: 9 Waiting; stdlib Http
//! A worker pool: the URLs named on the command line go down a channel to three workers, each
//! request bounded by one context with a two-second deadline, and the results come back up
//! another channel, in whatever order they finish, to be printed in the order they were given.
//! Try:
//!   ant run examples/pool.ant https://go.dev https://example.com https://nowhere.invalid

type Fetched = { index: int, url: string, outcome: string }
type Job = { index: int, url: string }

func fetch(job: Job, ctx: Context): Fetched {
  var response = Http.get(job.url, ctx: ctx)
  var outcome = if response is Ok { String.from(response.value.status) } else { response.error.message }
  Fetched{ index: job.index, url: job.url, outcome }
}

var urls = Os.args()
var jobs: Channel[Job] = Channel.new()
var results: Channel[Fetched] = Channel.new(len(urls))
var deadline = Context.new(Time.duration(seconds: 2))
var wg = WaitGroup.new()
for w in Array.range(0, 3) {
  WaitGroup.add(wg, 1)
  go {
    defer { WaitGroup.done(wg) }
    for job in Channel.values(jobs) { Channel.send(results, fetch(job, deadline)) }
  }
}
for { index, value } in Array.entries(urls) { Channel.send(jobs, Job{ index, url: value }) }
Channel.close(jobs)
WaitGroup.wait(wg)
Channel.close(results)
for f in Iter.toArray(Channel.values(results)) | Array.sortBy({ x.index }) {
  println(`${f.outcome}  ${f.url}`)
}
