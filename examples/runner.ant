// spec: stdlib Os; stdlib Json; stdlib Time; stdlib File
// A task runner: a JSON array of tasks arrives on standard input, each a name, a program and
// its arguments; each is run in order without a shell, how long it took goes to standard
// error, what it did to standard output, and the status is 1 when any failed. Try:
//   echo '[{"name": "version", "program": "go", "args": ["version"]}]' | ant run examples/runner.ant
type Task = { name: string, program: string, args: Array[string] }

func field(object: Map[string, Json.Value], name: string): Result[Json.Value, Error] {
  var v = object[name]
  if v == null { Result.err(Error{ message: `missing field ${name}` }) } else { Result.ok(v) }
}

func text(v: Json.Value, what: string): Result[string, Error] {
  if v is string { Result.ok(v) } else { Result.err(Error{ message: `${what} must be a string` }) }
}

func taskOf(object: Map[string, Json.Value]): Result[Task, Error] {
  var name = try text(try field(object, "name"), "name")
  var program = try text(try field(object, "program"), "program")
  var args: Array[string] = []
  var given = object["args"]
  if given != null {
    if given is Array {
      for a in given { Array.push(args, try text(a, `${name}: an argument`)) }
    } else {
      return Result.err(Error{ message: `${name}: args must be an array` })
    }
  }
  Result.ok(Task{ name: name, program: program, args: args })
}

func task(v: Json.Value): Result[Task, Error] {
  if v is Map { taskOf(v) } else { Result.err(Error{ message: "a task must be an object" }) }
}

func plural(n: int, word: string): string {
  if n == 1 { `${n} ${word}` } else { `${n} ${word}s` }
}

// run runs one task and reports it; true when it succeeded.
func run(t: Task): bool {
  var started = Time.monotonic()
  var result = Os.exec(t.program, t.args)
  File.writeLine(Os.stderr(), `${t.name} took ${Time.monotonic() - started} ms`)
  if result is Ok {
    var output = result.value
    var lines = if output.stdout == "" { 0 } else { Array.length(String.split(String.trim(output.stdout), "\n")) }
    if output.status == 0 {
      println(`${t.name}: ok, ${plural(lines, "line")} of output`)
      true
    } else {
      println(`${t.name}: failed with status ${output.status}`)
      false
    }
  } else {
    println(`${t.name}: could not start`)
    false
  }
}

func tasks(parsed: Result[Json.Value, Error]): Array[Json.Value] {
  if parsed is Ok {
    var list = parsed.value
    if list is Array { list } else { println("the task list must be an array"); Os.exit(2) }
  } else {
    println(`bad task list: ${parsed.error.message}`)
    Os.exit(2)
  }
}

func main(): void {
  var items = tasks(Json.parse(Result.unwrap(File.readAll(Os.stdin()))))
  var failed = 0
  for item in items {
    var t = task(item)
    if t is Ok {
      if !run(t.value) { failed += 1 }
    } else {
      println(`skipped: ${t.error.message}`)
      failed += 1
    }
  }
  println(`${Array.length(items) - failed} of ${plural(Array.length(items), "task")} succeeded`)
  if failed > 0 { Os.exit(1) }
}

// expect
// stdin: [{"name": "version", "program": "go", "args": ["version"]},
// stdin:  {"name": "nonsense", "program": "go", "args": ["nonsense"]},
// stdin:  {"name": "missing", "program": "ant-no-such-program-xyz"},
// stdin:  7]
// exit: 1
// out: version: ok, 1 line of output
// out: nonsense: failed with status 2
// out: missing: could not start
// out: skipped: a task must be an object
// out: 1 of 4 tasks succeeded
// err: took
