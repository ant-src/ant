// spec: 5 HTML expressions; 11 Html; stdlib Http; stdlib Url; 9 Waiting
//! A guestbook served as HTML: GET / renders the page from components, and POST /sign takes a
//! form and redirects back. Every name, message, and link is escaped or checked as it goes into
//! the markup, so a visitor who signs as <script> shows up as text, and a javascript: link goes
//! nowhere. Try:
//!   ant run examples/guestbook.ant 8080
//! and open http://localhost:8080 in a browser.

type Signature = { name: string, message: string, website: string | null }

var entries: Array[Signature] = []
var lock = Mutex.new()

func layout(title: string, children: Html): Html {
  <html lang="en">
    <head>
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>{title}</title>
      <style>
        html { color-scheme: light dark; font: 16px system-ui; }
        body { max-width: 40rem; margin: 2rem auto }
        input, textarea { display: block; font: 16px system-ui; }
        .entry > b { color: #6b4f2a }
      </style>
    </head>
    <body>{children}</body>
  </html>
}

func entry(e: Signature): Html {
  <li class="entry">
    <b>{if e.website != null { <a href={e.website}>{e.name}</a> } else { e.name }}</b>
    wrote: {e.message}
  </li>
}

func signForm(): Html {
  <form method="post" action="/sign">
    <input name="name" placeholder="Name" required />
    <input name="website" placeholder="https://..." />
    <textarea name="message" required></textarea>
    <button type="submit">Sign</button>
  </form>
}

func page(list: Array[Signature]): Html {
  layout(title: "Guestbook (${len(list)})", children: <>
    <h1>Guestbook</h1>
    {if len(list) == 0 { <p>Nobody has signed yet.</p> } else { <ul>{Array.map(list, entry)}</ul> }}
    {signForm()}
  </>)
}

func html(status: int, body: Html): Http.Reply {
  Http.Reply{
    status,
    headers: Map{ "Content-Type": "text/html; charset=utf-8" },
    body: "<!doctype html>${body}",
  }
}

// field returns the first value of a form field, trimmed, or null when it is missing or empty.
func field(form: Map[string, Array[string]], name: string): string | null {
  var value = String.trim(form[name]?.[0] ?? "")
  if value == "" { null } else { value }
}

func handle(req: Http.Request): Http.Reply {
  if req.method == "GET" && req.path == "/" {
    return html(200, page(Mutex.withLock(lock, { Array.slice(entries, 0, len(entries)) })))
  }
  if req.method == "POST" && req.path == "/sign" {
    var form = Url.parseQuery(req.body)
    if form is Err { return html(400, <p>That form could not be read.</p>) }
    var name = field(form.value, "name")
    var message = field(form.value, "message")
    if name == null || message == null {
      return html(400, layout(title: "Guestbook", children: <p>A name and a message are needed. <a href="/">Back</a></p>))
    }
    var e = Signature{ name, message, website: field(form.value, "website") }
    Mutex.withLock(lock, { Array.push(entries, e) })
    return Http.Reply{ status: 303, headers: Map{ "Location": "/" }, body: "" }
  }
  html(404, layout(title: "Not found", children: <p>No page at <code>{req.path}</code>.</p>))
}

var port = Array.get(Os.args(), 0) ?? "8080"
var listener = Result.unwrap(Net.listen("127.0.0.1:${port}"))
println("listening on ${Net.address(listener)}")
Result.unwrap(Http.serve(listener, handle, Os.interrupt()))
