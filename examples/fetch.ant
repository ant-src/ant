// spec: stdlib Http; stdlib Json; 8 try; 8 Result; 11 Map
//! A JSON fetcher: it gets the URL in the first argument, checks the status, parses the body,
//! and prints the value at a dotted path such as owner.login, or the whole document when no path
//! is given. Every failure is an Err that try carries up to one report, never a panic. Try:
//!   ant run examples/fetch.ant https://api.github.com/repos/golang/go owner.login

func fail[T](message: string): Result[T, Error] { Result.err(Error{ message }) }

func getJson(url: string): Result[Json.Value, Error] {
  var r = try Http.get(url, headers: Map{ "Accept": "application/json" }, timeout: Time.duration(seconds: 10))
  if r.status != 200 { return fail("status ${r.status}") }
  Json.parse(r.body)
}

// lookup follows a path of object keys and array indexes, such as items.0.name.
func lookup(doc: Json.Value, path: string): Result[Json.Value, Error] {
  var at = doc
  for key in String.split(path, ".") {
    if at is Map {
      if !Map.has(at, key) { return fail("no field ${key}") }
      at = at[key]
    } else if at is Array {
      var i = String.toInt(key) ?? return fail("${key} is not an index")
      if i < 0 || i >= len(at) { return fail("no index ${i}") }
      at = at[i]
    } else {
      return fail("cannot look up ${key} in ${Json.stringify(at)}")
    }
  }
  Result.ok(at)
}

func fetch(url: string, path: string | null): Result[Json.Value, Error] {
  var doc = try getJson(url)
  if path == null { Result.ok(doc) } else { lookup(doc, path) }
}

var args = Os.args()
if len(args) == 0 || len(args) > 2 {
  eprintln("usage: ant run ${Os.program()} <url> [path]")
  Os.exit(2)
}
var result = fetch(args[0], Array.get(args, 1))
if result is Err {
  eprintln("${args[0]}: ${result.error.message}")
  Os.exit(1)
}
var v = result.value
if v is string { println(v) } else { println(Json.stringify(v, indent: "  ")) }
