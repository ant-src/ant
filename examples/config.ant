// spec: stdlib Json; 8 try; 8 Result; 7 Narrowing; 5 is
//! A configuration decoder, the way stdlib.md describes one: Json.parse gives a Json.Value tree,
//! a function per record type narrows it with is, and try propagates the first error, which
//! carries the path of the offending value such as $.servers[1].port.

type Server = { host: string, port: int, tls: bool }
type Config = { name: string, servers: Array[Server], limits: Map[string, int] }

func fail[T](path: string, what: string): Result[T, Error] {
  Result.err(Error{ message: `${path}: ${what}` })
}

func kind(v: Json.Value): string {
  if v is null { "null" }
  else if v is bool { "a bool" }
  else if v is float64 { "a number" }
  else if v is string { "a string" }
  else if v is Array { "an array" }
  else { "an object" }
}

func field(obj: Map[string, Json.Value], key: string, path: string): Result[Json.Value, Error] {
  if !Map.has(obj, key) { return fail(path, `missing field ${key}`) }
  Result.ok(obj[key])
}

func decodeString(v: Json.Value, path: string): Result[string, Error] {
  if v is string { Result.ok(v) } else { fail(path, `expected a string, got ${kind(v)}`) }
}

func decodeBool(v: Json.Value, path: string): Result[bool, Error] {
  if v is bool { Result.ok(v) } else { fail(path, `expected a bool, got ${kind(v)}`) }
}

func decodeInt(v: Json.Value, path: string): Result[int, Error] {
  if !(v is float64) { return fail(path, `expected a number, got ${kind(v)}`) }
  var n = Math.toInt(v) ?? return fail(path, `expected an integer, got ${v}`)
  Result.ok(n)
}

func decodeServer(v: Json.Value, path: string): Result[Server, Error] {
  if !(v is Map) { return fail(path, `expected an object, got ${kind(v)}`) }
  var host = try decodeString(try field(v, "host", path), `${path}.host`)
  var port = try decodeInt(try field(v, "port", path), `${path}.port`)
  var tls = if Map.has(v, "tls") { try decodeBool(v["tls"], `${path}.tls`) } else { false }
  if port < 1 || port > 65535 { return fail(`${path}.port`, `${port} is out of range`) }
  Result.ok(Server{ host: host, port: port, tls: tls })
}

func decodeConfig(v: Json.Value, path: string): Result[Config, Error] {
  if !(v is Map) { return fail(path, `expected an object, got ${kind(v)}`) }
  var name = try decodeString(try field(v, "name", path), `${path}.name`)
  var list = try field(v, "servers", path)
  if !(list is Array) { return fail(`${path}.servers`, `expected an array, got ${kind(list)}`) }
  var servers: Array[Server] = []
  for { index, value } in Array.entries(list) {
    Array.push(servers, try decodeServer(value, `${path}.servers[${index}]`))
  }
  var limits: Map[string, int] = Map{}
  if Map.has(v, "limits") {
    var raw = v["limits"]
    if !(raw is Map) { return fail(`${path}.limits`, `expected an object, got ${kind(raw)}`) }
    for { key, value } in raw {
      Map.set(limits, key, try decodeInt(value, `${path}.limits.${key}`))
    }
  }
  Result.ok(Config{ name: name, servers: servers, limits: limits })
}

func load(text: string): Result[Config, Error] {
  var tree = try Json.parse(text)
  decodeConfig(tree, "$")
}

func report(text: string): void {
  var loaded = load(text)
  if loaded is Ok {
    var c = loaded.value
    println(`${c.name}: ${Array.length(c.servers)} servers, limits ${c.limits}`)
    for s in c.servers { println(`  ${s.host}:${s.port}${if s.tls { " (tls)" } else { "" }}`) }
  } else {
    println(`error: ${loaded.error.message}`)
  }
}

report(`{
    "name": "api",
    "servers": [
      { "host": "a.example", "port": 443, "tls": true },
      { "host": "b.example", "port": 8080 }
    ],
    "limits": { "rps": 100, "burst": 250 }
  }`)
report(`{ "name": "bare", "servers": [] }`)
report(`{ "name": "oops", "servers": [ { "host": "a", "port": 80 }, { "host": "b", "port": "81" } ] }`)
report(`{ "name": "frac", "servers": [ { "host": "a", "port": 80.5 } ] }`)
report(`{ "name": "range", "servers": [ { "host": "a", "port": 70000 } ] }`)
report(`{ "name": "nohost", "servers": [ { "port": 1 } ] }`)
report(`{ "name": 7, "servers": [] }`)
report(`{ "servers": [] }`)
report(`{ "name": "limits", "servers": [], "limits": { "rps": true } }`)
report(`[1, 2, 3]`)
report(`{ "name": "broken"`)
println(Json.stringify(Server{ host: "h", port: 1, tls: false }))

// expect
// out: api: 2 servers, limits Map{ "rps": 100, "burst": 250 }
// out:   a.example:443 (tls)
// out:   b.example:8080
// out: bare: 0 servers, limits Map{}
// out: error: $.servers[1].port: expected a number, got a string
// out: error: $.servers[0].port: expected an integer, got 80.5
// out: error: $.servers[0].port: 70000 is out of range
// out: error: $.servers[0]: missing field host
// out: error: $.name: expected a string, got a number
// out: error: $: missing field name
// out: error: $.limits.rps: expected a number, got a bool
// out: error: $: expected an object, got an array
// out: error: unexpected end of JSON input
// out: {"host":"h","port":1,"tls":false}
