// spec: 4 Records; 4 Primitives; 5 Loops; 11 Math and Bits; 11 Array
//! The n-body benchmark: five bodies under gravity, advanced with a symplectic Euler step. Records
//! are mutable through a reference, floats are float64 throughout, and the energy before and
//! after a thousand steps matches the reference values of the benchmark to nine places.

type Body = { x: float64, y: float64, z: float64, vx: float64, vy: float64, vz: float64, mass: float64 }

var PI = 3.141592653589793
var SOLAR_MASS = 4.0 * PI * PI
var DAYS_PER_YEAR = 365.24

func bodies(): Array[Body] {
  var d = DAYS_PER_YEAR
  [
    Body{ x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: SOLAR_MASS },
    Body{
      x: 4.84143144246472090e+00,
      y: -1.16032004402742839e+00,
      z: -1.03622044471123109e-01,
      vx: 1.66007664274403694e-03 * d,
      vy: 7.69901118419740425e-03 * d,
      vz: -6.90460016972063023e-05 * d,
      mass: 9.54791938424326609e-04 * SOLAR_MASS,
    },
    Body{
      x: 8.34336671824457987e+00,
      y: 4.12479856412430479e+00,
      z: -4.03523417114321381e-01,
      vx: -2.76742510726862411e-03 * d,
      vy: 4.99852801234917238e-03 * d,
      vz: 2.30417297573763929e-05 * d,
      mass: 2.85885980666130812e-04 * SOLAR_MASS,
    },
    Body{
      x: 1.28943695621391310e+01,
      y: -1.51111514016986312e+01,
      z: -2.23307578892655734e-01,
      vx: 2.96460137564761618e-03 * d,
      vy: 2.37847173959480950e-03 * d,
      vz: -2.96589568540237556e-05 * d,
      mass: 4.36624404335156298e-05 * SOLAR_MASS,
    },
    Body{
      x: 1.53796971148509165e+01,
      y: -2.59193146099879641e+01,
      z: 1.79258772950371181e-01,
      vx: 2.68067772490389322e-03 * d,
      vy: 1.62824170038242295e-03 * d,
      vz: -9.51592254519715870e-05 * d,
      mass: 5.15138902046611451e-05 * SOLAR_MASS,
    },
  ]
}

func offsetMomentum(bs: Array[Body]): void {
  var px = 0.0
  var py = 0.0
  var pz = 0.0
  for b in bs {
    px += b.vx * b.mass
    py += b.vy * b.mass
    pz += b.vz * b.mass
  }
  var sun = bs[0]
  sun.vx = -px / SOLAR_MASS
  sun.vy = -py / SOLAR_MASS
  sun.vz = -pz / SOLAR_MASS
}

func advance(bs: Array[Body], dt: float64): void {
  var n = Array.length(bs)
  for i in Iter.range(0, n) {
    var a = bs[i]
    for j in Iter.range(i + 1, n) {
      var b = bs[j]
      var dx = a.x - b.x
      var dy = a.y - b.y
      var dz = a.z - b.z
      var d2 = dx * dx + dy * dy + dz * dz
      var mag = dt / (d2 * Math.sqrt(d2))
      a.vx -= dx * b.mass * mag
      a.vy -= dy * b.mass * mag
      a.vz -= dz * b.mass * mag
      b.vx += dx * a.mass * mag
      b.vy += dy * a.mass * mag
      b.vz += dz * a.mass * mag
    }
  }
  for b in bs {
    b.x += dt * b.vx
    b.y += dt * b.vy
    b.z += dt * b.vz
  }
}

func energy(bs: Array[Body]): float64 {
  var e = 0.0
  var n = Array.length(bs)
  for i in Iter.range(0, n) {
    var a = bs[i]
    e += 0.5 * a.mass * (a.vx * a.vx + a.vy * a.vy + a.vz * a.vz)
    for j in Iter.range(i + 1, n) {
      var b = bs[j]
      var dx = a.x - b.x
      var dy = a.y - b.y
      var dz = a.z - b.z
      e -= a.mass * b.mass / Math.sqrt(dx * dx + dy * dy + dz * dz)
    }
  }
  e
}

func nine(x: float64): float64 { Math.round(x * 1000000000.0) / 1000000000.0 }

func main(): void {
  var bs = bodies()
  offsetMomentum(bs)
  println(nine(energy(bs)))
  for _ in Iter.range(0, 1000) { advance(bs, 0.01) }
  println(nine(energy(bs)))
  var sun = bs[0]
  println(`sun moved to ${nine(sun.x)}, ${nine(sun.y)}, ${nine(sun.z)}`)
}

// expect
// out: -0.169075164
// out: -0.169087605
// out: sun moved to 0.007413153, 0.003009803, -0.000266704
