// spec: stdlib Http; stdlib Os; stdlib Crypto; stdlib Encoding; stdlib Json; stdlib Time
//! A webhook delivery: a JSON event is signed with an HMAC over its bytes, the signature goes in
//! a header the receiver checks, and the request is sent with a timeout. The first argument is
//! the receiver's URL. Try:
//!   ant run examples/webhook.ant http://localhost:8080/hook

type Event = { id: string, kind: string, amount: float64 }

var secret = String.toBytes(Os.env("WEBHOOK_SECRET") ?? "shared-secret")

func sign(body: Bytes): string {
  "sha256=" + Encoding.toHex(Crypto.hmacSha256(secret, body))
}

var url = Array.get(Os.args(), 0) ?? "http://localhost:8080/hook"
var body = Json.stringify(Event{ id: "evt_1", kind: "payment", amount: 12.5 })
var headers = Map{ "Content-Type": "application/json", "X-Signature": sign(String.toBytes(body)) }
var response = Http.request("POST", url, body, headers, Time.duration(seconds: 5))
if response is Err {
  File.writeLine(Os.stderr(), `delivery failed: ${response.error.message}`)
  Os.exit(1)
}
var r = response.value
println(`delivered: ${r.status}`)
if r.status < 200 || r.status > 299 { Os.exit(1) }
