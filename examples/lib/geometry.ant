// Vectors and points, imported by the shapes modules. Not a test itself.
export type Point = { x: float64, y: float64 }

export var origin = Point{ x: 0.0, y: 0.0 }

export func Point.add(a: Point, b: Point): Point { Point{ x: a.x + b.x, y: a.y + b.y } }

export func Point.scale(p: Point, k: float64): Point { Point{ x: p.x * k, y: p.y * k } }

export func distance(a: Point, b: Point): float64 {
  var dx = a.x - b.x
  var dy = a.y - b.y
  Math.sqrt(dx * dx + dy * dy)
}

export var created = 0

export func make(x: float64, y: float64): Point {
  created += 1
  Point{ x: x, y: y }
}
