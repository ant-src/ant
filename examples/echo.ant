// spec: stdlib Net; stdlib File; 9 Waiting
//! A line server over a socket: every connection is served on its own goroutine and each line
//! is answered in upper case until the client closes. Ctrl-C stops the server and every session
//! through one context. Try:
//!   ant run examples/echo.ant 7000
//! and in another terminal:
//!   nc localhost 7000

func session(c: File.Handle, stop: Context): void {
  defer { File.close(c) }
  var next = Result.unwrapOr(File.readLine(c, stop), null)
  while next != null {
    if File.writeLine(c, String.toUpper(next)) is Err { return }
    next = Result.unwrapOr(File.readLine(c, stop), null)
  }
}

var port = Array.get(Os.args(), 0) ?? "7000"
var listener = Result.unwrap(Net.listen(`127.0.0.1:${port}`))
var stop = Context.new(parent: Os.interrupt())
var sessions = WaitGroup.new()
println(`listening on ${Net.address(listener)}`)
var conn = Net.accept(listener, stop)
while conn is Ok {
  var c = conn.value
  WaitGroup.add(sessions, 1)
  go {
    defer { WaitGroup.done(sessions) }
    session(c, stop)
  }
  conn = Net.accept(listener, stop)
}
WaitGroup.wait(sessions)
Net.close(listener)
println("stopped")
