// spec: stdlib Http; stdlib Net; stdlib Json; stdlib Os; 9 Waiting
//! A small HTTP API: GET /health, GET /items, and POST /items with a JSON body, the items kept
//! in an array under a mutex, served until Ctrl-C, when the server drains and the program says
//! why it stopped. Try:
//!   ant run examples/api.ant 8080
//!   curl -X POST localhost:8080/items -d '{"name": "ant"}'

type Item = { id: int, name: string }

var items: Array[Item] = []
var lock = Mutex.new()

func json(status: int, body: string): Http.Reply {
  Http.Reply{ status, headers: Map{ "Content-Type": "application/json" }, body }
}

func handle(req: Http.Request): Http.Reply {
  if req.method == "GET" && req.path == "/health" { return json(200, "{\"ok\": true}") }
  if req.method == "GET" && req.path == "/items" {
    return json(200, Mutex.withLock(lock, { Json.stringify(items) }))
  }
  if req.method == "POST" && req.path == "/items" {
    var parsed = Json.parse(req.body)
    if parsed is Err { return json(400, Json.stringify(Map{ "error": parsed.error.message })) }
    var body = parsed.value
    if body is Map {
      var name = body["name"]
      if name is string {
        var item = Mutex.withLock(lock, {
          var next = Item{ id: Array.length(items) + 1, name }
          Array.push(items, next)
          next
        })
        return json(201, Json.stringify(item))
      }
    }
    return json(400, "{\"error\": \"a name is required\"}")
  }
  json(404, "{\"error\": \"no such route\"}")
}

var port = Array.get(Os.args(), 0) ?? "8080"
var listener = Result.unwrap(Net.listen(`127.0.0.1:${port}`))
var stop = Context.new(parent: Os.interrupt())
println(`listening on ${Net.address(listener)}`)
var served = Http.serve(listener, handle, stop)
println(`stopped: ${served} (${Context.reason(stop) ?? "?"})`)
