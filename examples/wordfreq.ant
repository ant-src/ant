// spec: stdlib File; stdlib Os; 9 Goroutines; 9 Synchronization; 9 Sharing results; 11 Map; 11 Array
//! A word counter: one goroutine per file named on the command line, each counting into its own
//! map, merged under a mutex, then ranked with a comparator. A file that cannot be read is an
//! Err, reported and skipped, not a panic. Try:
//!   ant run examples/wordfreq.ant ../spec/*.md

func words(text: string): Array[string] {
  var out: Array[string] = []
  var current = ""
  for ch in String.toLower(text) {
    if ch >= "a" && ch <= "z" || ch == "'" {
      current = current + ch
    } else if current != "" {
      Array.push(out, current)
      current = ""
    }
  }
  if current != "" { Array.push(out, current) }
  out
}

func countFile(path: string): Result[Map[string, int], Error] {
  var text = try File.read(path)
  var counts: Map[string, int] = Map{}
  for w in words(text) { counts[w] = (counts[w] ?? 0) + 1 }
  Result.ok(counts)
}

func byCountThenWord(a: Entry[string, int], b: Entry[string, int]): int {
  if a.value != b.value { b.value - a.value }
  else if a.key < b.key { -1 }
  else if a.key > b.key { 1 }
  else { 0 }
}

var paths = Os.args()
if Array.isEmpty(paths) {
  File.writeLine(Os.stderr(), "usage: ant run examples/wordfreq.ant file...")
  Os.exit(2)
}
var totals: Map[string, int] = Map{}
var files = 0
var lock = Mutex.new()
var wg = WaitGroup.new()
for path in paths {
  WaitGroup.add(wg, 1)
  go {
    defer { WaitGroup.done(wg) }
    var counted = countFile(path)
    if counted is Ok {
      var counts = counted.value
      Mutex.withLock(lock, {
        files += 1
        for { key, value } in counts { totals[key] = (totals[key] ?? 0) + value }
      })
    } else {
      File.writeLine(Os.stderr(), `skipped: ${counted.error.message}`)
    }
  }
}
WaitGroup.wait(wg)
var ranked = Array.sortWith(Map.entries(totals), byCountThenWord)
for e in Array.slice(ranked, 0, Math.min(10, len(ranked))) { println(`${String.padStart(String.fromInt(e.value), 6)} ${e.key}`) }
println(`${files} files, ${Map.size(totals)} distinct words, ${Array.sum(Map.values(totals)) ?? 0} in all`)
