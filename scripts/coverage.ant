#!/usr/bin/env ant

//! Coverage reads a Go coverage profile and fails when statement coverage is below the
//! thresholds: the first number is the minimum overall, the second the minimum per package.
//!
//!     ant scripts/coverage.ant [-run] <profile> [overall-min] [package-min]
//!
//! With -run the script first runs go test -coverpkg=./... -coverprofile=<profile> ./... in the
//! working directory, with the terminal's streams, and exits with the test's status when it is not
//! zero. This is how the check workflow runs it.
//!
//! Coverage is statement-weighted, computed from the profile: a package's figure is the share of
//! its statements that some test ran, not an average over its functions. A block that several
//! test binaries report is counted once.

var modulePath = "github.com/ant-src/ant"

// Block is one line of the profile: a block of statements and how often a test binary ran it.
type Block = { id: string, statements: int, count: int }

// Tally counts statements, each block once, and those of them some test ran.
type Tally = { statements: int = 0, covered: int = 0 }

// fail writes the message to standard error and exits with status 2, the status of a bad
// invocation.
func fail(message: string): never {
  eprintln(message)
  Os.exit(2)
}

func threshold(arg: string | null, fallback: int): int {
  var text = arg ?? return fallback
  String.toInt(text) ?? fail("not a number: ${text}")
}

// parseBlock reads a line such as github.com/ant-src/ant/value/numeric.go:12.30,14.2 3 1, or
// gives null when the line is not one.
func parseBlock(line: string): Block | null {
  var fields = String.fields(line)
  if len(fields) != 3 { return null }
  var [id, statements, count] = fields
  Block{
    id,
    statements: String.toInt(statements) ?? return null,
    count: String.toInt(count) ?? return null,
  }
}

// packageOf gives the package of a block relative to the module, or (root) for the module itself.
func packageOf(block: Block): string {
  var file = String.cut(block.id, ":")?.before ?? block.id
  var dir = String.slice(file, 0, String.lastIndexOf(file, "/") ?? 0)
  if dir == modulePath { "(root)" } else { String.trimPrefix(dir, "${modulePath}/") }
}

func percent(t: Tally): float64 {
  if t.statements == 0 { 0.0 } else { 100.0 * float64(t.covered) / float64(t.statements) }
}

// report prints a row for the tally and gives whether it is below min, as printed with one
// decimal.
func report(name: string, t: Tally, min: int): bool {
  var pct = percent(t)
  var below = pct + 0.05 < float64(min)
  var mark = if below { "  BELOW ${min}%" } else { "" }
  println("${String.padEnd(name, 22)} ${String.padStart(String.fromFloat(pct, 1), 5)}%${mark}")
  below
}

var args = Os.args()
var run = Array.first(args) == "-run"
if run { args = Array.slice(args, 1, len(args)) }
var profile = Array.get(args, 0) ??
  fail("usage: ${Os.program()} [-run] <profile> [overall-min] [package-min]")
var overallMin = threshold(Array.get(args, 1), 90)
var packageMin = threshold(Array.get(args, 2), 80)

if run {
  var test = Cmd.new("go", ["test", "-coverpkg=./...", "-coverprofile=${profile}", "./..."])
  var status = try Cmd.run(test)
  if status != 0 { Os.exit(status) }
}

var packages: Map[string, Tally] = Map{}
var total = Tally{}
var seen: Set[string] = Set.of([])
var hit: Set[string] = Set.of([])
for line in String.lines(try File.read(profile)) {
  if line == "" || String.startsWith(line, "mode:") { continue }
  var block = parseBlock(line) ??
    return Result.err(Error{ message: "malformed profile line: ${line}" })
  var pkg = packageOf(block)
  var tally = packages[pkg] ?? Tally{}
  packages[pkg] = tally
  if Set.add(seen, block.id) {
    tally.statements += block.statements
    total.statements += block.statements
  }
  if block.count > 0 && Set.add(hit, block.id) {
    tally.covered += block.statements
    total.covered += block.statements
  }
}

var below = false
for { key: name, value: tally } in Map.entries(packages) | Array.sortBy({ x.key }) {
  if report(name, tally, packageMin) { below = true }
}
if report("total", total, overallMin) { below = true }
if below { return Result.err(Error{ message: "coverage below the minimum" }) }
