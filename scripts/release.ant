#!/usr/bin/env ant

//! Release builds the binaries of a release: ant cross-compiled for every target into
//! dist/ant_<version>_<os>_<arch>, with .exe for windows, next to checksums.txt with their SHA-256
//! digests in sha256sum's format.
//!
//!     ant scripts/release.ant <version>
//!
//! Run it from the repository root, with go on PATH. The publish workflow runs it with the tag as
//! the version. Every target is pure Go, so one host builds them all.

var targets = [
  "linux/amd64",
  "linux/arm64",
  "darwin/amd64",
  "darwin/arm64",
  "windows/amd64",
  "windows/arm64",
]

var version = Array.get(Os.args(), 0) ??
  return Result.err(Error{ message: "usage: ${Os.program()} <version>" })

try File.removeAll("dist")
try File.mkdir("dist")

for target in targets {
  var [os, arch] = String.split(target, "/")
  var ext = if os == "windows" { ".exe" } else { "" }
  var output = "dist/ant_${version}_${os}_${arch}${ext}"
  var env = Os.environ()
  env["CGO_ENABLED"] = "0"
  env["GOOS"] = os
  env["GOARCH"] = arch
  var build = Cmd.new("go", ["build", "-trimpath", "-ldflags=-s -w", "-o", output, "./cmd/ant"], env: env)
  var status = try Cmd.run(build)
  if status != 0 {
    return Result.err(Error{ message: "${Cmd.string(build)}: exit status ${status}" })
  }
  println(output)
}

var sums = ""
for file in try File.list("dist") {
  var digest = Crypto.sha256(try File.readBytes(Path.join(["dist", file]))) | Encoding.toHex()
  sums += "${digest}  ${file}\n"
}
try File.write("dist/checksums.txt", sums)
