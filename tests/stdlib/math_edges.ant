// spec: 11 Math and Bits

// From math_edges.
// Math at its documented edges: round is half away from zero, floor, ceil and trunc on
// negatives, toInt is int(x) without the panic, pow, sqrt of a negative is NaN, min and max on
// strings and sized integers, abs on floats, and the constants.
Math.round(2.5)                               // => 3.0
Math.round(-2.5)                              // => -3.0
Math.round(0.49)                              // => 0.0
Math.floor(-1.5)                              // => -2.0
Math.ceil(-1.5)                               // => -1.0
Math.trunc(-1.5)                              // => -1.0
Math.trunc(1.9)                               // => 1.0
Math.toInt(3.0)                               // => 3
Math.toInt(3.5)                               // => null
Math.toInt(1e30)                              // => null
Math.toInt(0.0 / 0.0)                         // => null
Math.toInt(1.0 / 0.0)                         // => null
Math.toInt(-9223372036854775808.0)            // => -9223372036854775808
Math.pow(2.0, 10.0)                           // => 1024.0
Math.sqrt(16.0)                               // => 4.0
Math.sqrt(-1.0)                               // => NaN
Math.min("b", "a")                            // => "a"
Math.max(1.5, -2.0)                           // => 1.5
Math.min(int8(3), int8(-3))                   // => -3
Math.abs(-2.5)                                // => 2.5
Math.abs(int8(-127))                          // => 127
Math.abs(-0.0) == 0.0                         // => true
Math.PI > 3.14 && Math.PI < 3.15 && Math.E > 2.71 && Math.E < 2.72 // => true
Math.minInt                                   // => -9223372036854775808
Math.maxInt                                   // => 9223372036854775807
Math.minInt == -Math.maxInt - 1               // => true
