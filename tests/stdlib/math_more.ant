// spec: 11 Math and Bits

// From math_more.
// More Math functions: logarithms and exp, the trigonometry in radians, hypot and
// cbrt, the NaN and finiteness tests, clamp on any Ordered type with NaN passing through,
// randomInt in its half-open range, and the float constants. The float functions follow IEEE
// 754 and never panic.
Math.log(Math.E)                              // => 1.0
Math.log(1.0)                                 // => 0.0
Math.log(0.0)                                 // => -Infinity
Math.log(-1.0)                                // => NaN
Math.log2(8.0)                                // => 3.0
Math.log10(1000.0)                            // => 3.0
Math.exp(0.0)                                 // => 1.0
Math.exp(1.0) == Math.E                       // => true
Math.sin(0.0)                                 // => 0.0
Math.cos(0.0)                                 // => 1.0
Math.tan(0.0)                                 // => 0.0
Math.round(Math.asin(1.0) * 1000.0)           // => 1571.0
Math.acos(1.0)                                // => 0.0
Math.atan(0.0)                                // => 0.0
Math.round(Math.atan2(1.0, 1.0) * 1000000.0)  // => 785398.0
Math.round(Math.atan2(0.0, -1.0) * 1000000.0) // => 3141593.0
Math.hypot(3.0, 4.0)                          // => 5.0
Math.hypot(Math.maxFloat64, Math.maxFloat64) == Math.Infinity // => true
Math.cbrt(27.0)                               // => 3.0
Math.cbrt(-8.0)                               // => -2.0
Math.isNaN(0.0 / 0.0)                         // => true
Math.isNaN(Math.NaN)                          // => true
Math.isNaN(1.0)                               // => false
Math.isFinite(1.0)                            // => true
Math.isFinite(1.0 / 0.0)                      // => false
Math.isFinite(-Math.Infinity)                 // => false
Math.isFinite(Math.NaN)                       // => false
Math.clamp(5, 1, 3)                           // => 3
Math.clamp(-5, 1, 3)                          // => 1
Math.clamp(2, 1, 3)                           // => 2
Math.clamp(2, 2, 2)                           // => 2
Math.clamp(2.5, 1.0, 2.0)                     // => 2.0
Math.clamp("m", "a", "f")                     // => "f"
Math.clamp(Math.NaN, 1.0, 2.0)                // => NaN
Math.clamp(byte(200), byte(0), byte(100))     // => 100
Math.randomInt(5, 6)                          // => 5
Array.every(Array.range(0, 200), { var r = Math.randomInt(-2, 2); r >= -2 && r < 2 }) // => true
Math.randomInt(Math.minInt, Math.maxInt) >= Math.minInt // => true
Math.NaN                                      // => NaN
Math.Infinity                                 // => Infinity
-Math.Infinity                                // => -Infinity
Math.maxFloat64                               // => 1.7976931348623157e+308
Math.maxFloat64 * 2.0                         // => Infinity
