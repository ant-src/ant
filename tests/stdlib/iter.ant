// spec: 11 Iter; 12 Runtime panics
// Iter (section 11): lazy sequences; nothing runs until Iter.toArray or for; a sequence may be
// run more than once; take stops its source.
func evens(limit: int, log: Array[string]): Seq[int] {
  func(yield: func(int): bool): void {
    var i = 0
    while i < limit {
      if !yield(i) { Array.push(log, "stopped"); return }
      i += 2
    }
    Array.push(log, "exhausted")
  }
}
Iter.toArray(Iter.range(0, 5))                // => [0, 1, 2, 3, 4]
Iter.toArray(Iter.range(3, 3))                // => []
Iter.toArray(Iter.range(3, 1))                // => []
var s = Iter.fromArray([1, 2, 3])
Iter.toArray(s)                               // => [1, 2, 3]
Iter.toArray(s)                               // => [1, 2, 3]
var log: Array[string] = []
Iter.toArray(Iter.map(evens(5, log), { x * x })) // => [0, 4, 16]
log                                           // => ["exhausted"]
var mapped: Array[int] = []
var lazy = Iter.map(Iter.range(0, 3), { Array.push(mapped, x); x })
mapped                                        // => []
Iter.toArray(lazy)                            // => [0, 1, 2]
mapped                                        // => [0, 1, 2]
Iter.toArray(Iter.filter(Iter.range(0, 10), { x % 4 == 0 })) // => [0, 4, 8]
Iter.toArray(Iter.take(Iter.range(0, 100), 3)) // => [0, 1, 2]
Iter.toArray(Iter.take(Iter.range(0, 100), 0)) // => []
log = []
Iter.toArray(Iter.take(evens(100, log), 2))   // => [0, 2]
log                                           // => ["stopped"]
Iter.range(0, 1000) | Iter.filter({ x % 7 == 0 }) | Iter.take(5) | Iter.toArray() // => [0, 7, 14, 21, 28]
var got: Array[int] = []
log = []
for n in Iter.take(evens(100, log), 2) { Array.push(got, n) }
got                                           // => [0, 2]
log                                           // => ["stopped"]

// Iter.take with a negative count panics (section 11).
Iter.toArray(Iter.take(Iter.range(0, 10), 2)) // => [0, 1]
Iter.take(Iter.range(0, 10), -1)              // => panic: Iter.take needs a count of at least 0, got -1
