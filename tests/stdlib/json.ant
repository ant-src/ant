// spec: stdlib Json; 12 Runtime panics
// Json (stdlib.md): parse gives Json.Value trees, numbers as float64, objects as maps in
// document order; a decoder narrows with is; stringify renders records as objects without
// their tag, on one line or indented; a map key must be a string, a named primitive over one written without its tag.
type Server = { host: string, port: int }
func decodeServer(v: Json.Value, path: string): Result[Server, Error] {
  if !(v is Map) { return Result.err(Error{ message: `${path}: not an object` }) }
  var host = v["host"] ?? return Result.err(Error{ message: `${path}.host: missing` })
  if !(host is string) { return Result.err(Error{ message: `${path}.host: not a string` }) }
  var port = v["port"] ?? return Result.err(Error{ message: `${path}.port: missing` })
  if !(port is float64) { return Result.err(Error{ message: `${path}.port: not a number` }) }
  var p = Math.toInt(port) ?? return Result.err(Error{ message: `${path}.port: not an integer` })
  Result.ok(Server{ host: host, port: p })
}
Json.parse(`{"b": 1, "a": [true, null, "x", 2.5], "c": {"d": {}}}`) // => Ok{ value: Map{ "b": 1.0, "a": [true, null, "x", 2.5], "c": Map{ "d": Map{} } } }
Json.parse("[1, 2")                           // => Err{ error: Error{ message: "unexpected end of JSON input" } }
Json.parse("{} extra") is Err                 // => true
Json.parse("") is Err                         // => true
Json.parse(`"abc`)                            // => Err{ error: Error{ message: "unexpected end of JSON input" } }
Json.parse(`{"a":`)                           // => Err{ error: Error{ message: "unexpected end of JSON input" } }
Json.parse("42")                              // => Ok{ value: 42.0 }
var parsed = Json.parse(`{"host": "example.com", "port": 8080}`)
decodeServer(Result.unwrap(parsed), "$")      // => Ok{ value: Server{ host: "example.com", port: 8080 } }
var bad = Json.parse(`{"host": "example.com", "port": 80.5}`)
decodeServer(Result.unwrap(bad), "$")         // => Err{ error: Error{ message: "$.port: not an integer" } }
Json.stringify(Server{ host: "h", port: 1 })  // => "{\"host\":\"h\",\"port\":1}"
Json.stringify([1, "two", 3.5, null, true, Map{ k: [0] }]) // => "[1,\"two\",3.5,null,true,{\"k\":[0]}]"
Json.stringify("quote \" and \n newline")     // => "\"quote \\\" and \\n newline\""
Json.stringify(Map{ 1: "one" })               // => panic: Json.stringify: a map key must be a string, got int
Json.stringify(Map{ "1": "one" })             // => "{\"1\":\"one\"}"
type UserId = string
Json.stringify(Map{ UserId("u-1"): UserId("u-2") }) // => "{\"u-1\":\"u-2\"}"
var mixed: Map[UserId | string, int] = Map{ UserId("a"): 1, "a": 2 }
Json.stringify(mixed)                         // => panic: Json.stringify: map keys UserId("a") and "a" both give the property name "a"
type Meters = float64
Json.stringify(Map{ Meters(3.0): 1 })         // => panic: Json.stringify: a map key must be a string, got Meters
Json.stringify(1.0 / 0.0)                     // => "null"

// With an indent, one member per line, ": " after a name, empty containers kept on one line.
var noEntries: Map[string, int] = Map{}
var noTags: Array[string] = []
Json.stringify(Map{ "id": "x1", "tags": ["a"], "none": noTags, "e": noEntries }, indent: "  ") // => "{\n  \"id\": \"x1\",\n  \"tags\": [\n    \"a\"\n  ],\n  \"none\": [],\n  \"e\": {}\n}"
Json.stringify([[1], Server{ host: "h", port: 1 }], indent: "\t") // => "[\n\t[\n\t\t1\n\t],\n\t{\n\t\t\"host\": \"h\",\n\t\t\"port\": 1\n\t}\n]"
Json.stringify(1, indent: "  ")               // => "1"
Json.stringify([1, 2], indent: "")            // => "[1,2]"
Json.stringify([1], indent: "x")              // => panic: Json.stringify needs an indent of spaces and tabs, got "x"
var round = Json.parse(Json.stringify(Map{ x: [1.5, "s"] }))
round                                         // => Ok{ value: Map{ "x": [1.5, "s"] } }

// Json.stringify on a cyclic value panics: a value already being written has no JSON form, unlike
// String.from, which renders it as ... (SPEC-FEEDBACK.md).
type Node = { value: int, next: Node | null }
var a = Node{ value: 1, next: null }
Json.stringify(a)                             // => "{\"value\":1,\"next\":null}"
a.next = a
Json.stringify(a)                             // => panic: Json.stringify: cyclic value
