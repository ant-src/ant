// spec: stdlib Url
// Url: parse divides a reference into its parts, opaque included, with the path decoded and
// the query raw; stringify assembles them again, an IPv6 host in brackets; escape and
// unescape handle one query value; parseQuery keeps keys in order of first appearance and a
// repeated key's values together, and stringifyQuery writes the map back in its order.
var u = Result.unwrap(Url.parse("https://alice:s3cret@example.com:8443/a%20b/c?q=ant&tag=a&tag=b#top"))
u                                             // => Url.Parts{ scheme: "https", opaque: "", user: "alice:s3cret", host: "example.com", port: "8443", path: "/a b/c", query: "q=ant&tag=a&tag=b", fragment: "top" }
Url.stringify(u)                              // => "https://alice:s3cret@example.com:8443/a%20b/c?q=ant&tag=a&tag=b#top"
Url.parse("mailto:alice@example.com")         // => Ok{ value: Url.Parts{ scheme: "mailto", opaque: "alice@example.com", user: "", host: "", port: "", path: "", query: "", fragment: "" } }
Url.stringify(Result.unwrap(Url.parse("mailto:alice@example.com"))) // => "mailto:alice@example.com"
Url.parse("/relative/path?x=1")               // => Ok{ value: Url.Parts{ scheme: "", opaque: "", user: "", host: "", port: "", path: "/relative/path", query: "x=1", fragment: "" } }
Url.parse("http://[::1]:80/")                 // => Ok{ value: Url.Parts{ scheme: "http", opaque: "", user: "", host: "::1", port: "80", path: "/", query: "", fragment: "" } }
Url.stringify(Result.unwrap(Url.parse("http://[::1]:80/"))) // => "http://[::1]:80/"
Result.isOk(Url.parse("http://exa mple.com/")) // => false
Url.parse("%zz")                              // => Err{ error: Error{ message: "parse \"%zz\": invalid URL escape \"%zz\"", kind: null } }
var p = Result.unwrap(Url.parse("http://example.com/x"))
var q = Url.Parts{ ...p, path: "/y", query: Url.stringifyQuery(Map{ "q": ["a b"] }) }
Url.stringify(q)                              // => "http://example.com/y?q=a+b"
Url.escape("a b&c=d/é")                       // => "a+b%26c%3Dd%2F%C3%A9"
Url.unescape("a+b%26c")                       // => Ok{ value: "a b&c" }
Url.unescape("%zz")                           // => Err{ error: Error{ message: "invalid URL escape \"%zz\"", kind: null } }
Url.unescape("%ff")                           // => Err{ error: Error{ message: "the %XX escapes do not decode to UTF-8 text", kind: null } }
Url.unescape("%e2%82%ac")                     // => Ok{ value: "€" }
Url.parseQuery("q=%c3")                       // => Err{ error: Error{ message: "the %XX escapes do not decode to UTF-8 text", kind: null } }
Url.parse("/a%ff")                            // => Err{ error: Error{ message: "parse \"/a%ff\": the %XX escapes do not decode to UTF-8 text", kind: null } }
Url.parse("/a#%ff")                           // => Err{ error: Error{ message: "parse \"/a#%ff\": the %XX escapes do not decode to UTF-8 text", kind: null } }
Url.parseQuery("tag=a&q=ant&tag=b&empty=&flag") // => Ok{ value: Map{ "tag": ["a", "b"], "q": ["ant"], "empty": [""], "flag": [""] } }
Url.parseQuery("")                            // => Ok{ value: Map{} }
Result.isOk(Url.parseQuery("a=%zz"))          // => false
var params = Result.unwrap(Url.parseQuery("tag=a&q=ant&tag=b"))
Url.stringifyQuery(params)                    // => "tag=a&tag=b&q=ant"
Url.stringifyQuery(Map{ "k": ["v 1", "v&2"], "z": [] }) // => "k=v+1&k=v%262"
var none: Map[string, Array[string]] = Map{}
Url.stringifyQuery(none)                      // => ""
Url.parse("http://a%FFb/x")                   // => Err{ error: Error{ message: "parse \"http://a%FFb/x\": the %XX escapes do not decode to UTF-8 text", kind: null } }
Url.parse("http://a%C3%A9b/x") is Ok          // => true

// A path keeps %2F, a slash that is not a separator, and %25, a percent sign, escaped, so they
// survive a round trip and stay apart from what they decode to; every other % is escaped.
Url.parse("http://h/a%2Fb/c%20d%25e")         // => Ok{ value: Url.Parts{ scheme: "http", opaque: "", user: "", host: "h", port: "", path: "/a%2Fb/c d%25e", query: "", fragment: "" } }
Url.stringify(Result.unwrap(Url.parse("http://h/a%2Fb/c%20d%25e"))) // => "http://h/a%2Fb/c%20d%25e"
Url.stringify(Result.unwrap(Url.parse("http://h/a%252Fb"))) // => "http://h/a%252Fb"
Url.stringify(Url.Parts{ ...p, path: "/100% sure" }) // => "http://example.com/100%25%20sure"

// After the scheme, a single / starts the path, with no authority. stringify writes // before an
// empty authority only for a scheme that always has one, so x:///a comes back as x:/a, the same
// reference, while file:///etc/hosts comes back as written.
Url.parse("x:/a")                             // => Ok{ value: Url.Parts{ scheme: "x", opaque: "", user: "", host: "", port: "", path: "/a", query: "", fragment: "" } }
Url.stringify(Result.unwrap(Url.parse("x:/a"))) // => "x:/a"
Url.parse("x:///a")                           // => Ok{ value: Url.Parts{ scheme: "x", opaque: "", user: "", host: "", port: "", path: "/a", query: "", fragment: "" } }
Url.stringify(Result.unwrap(Url.parse("x:///a"))) // => "x:/a"
Url.parse("file:/etc/hosts")                  // => Ok{ value: Url.Parts{ scheme: "file", opaque: "", user: "", host: "", port: "", path: "/etc/hosts", query: "", fragment: "" } }
Url.stringify(Result.unwrap(Url.parse("file:///etc/hosts?x#y"))) // => "file:///etc/hosts?x#y"
Url.stringify(Result.unwrap(Url.parse("FILE:/etc/hosts"))) // => "file:///etc/hosts"
Url.stringify(Result.unwrap(Url.parse("http://h/p"))) // => "http://h/p"
Url.stringify(Result.unwrap(Url.parse("x://h/a"))) // => "x://h/a"
// A path that starts with // gets an empty authority before it, with or without a scheme, and
// parse reads a schemeless /// as that empty authority.
var noParts = Url.Parts{ scheme: "", opaque: "", user: "", host: "", port: "", path: "", query: "", fragment: "" }
Url.stringify(Url.Parts{ ...noParts, path: "//a/b" }) // => "////a/b"
Url.parse("////a/b") | Result.map({ x.path })  // => Ok{ value: "//a/b" }
Url.parse("///a?q") | Result.map({ "${x.host}|${x.path}|${x.query}" }) // => Ok{ value: "|/a|q" }
// Fix-ups where the parts do not fit together.
Url.stringify(Url.Parts{ ...noParts, scheme: "https", host: "h", path: "p" }) // => "https://h/p"
Url.stringify(Url.Parts{ ...noParts, path: "a:b" }) // => "./a:b"
// The host keeps its case; an IPv6 address is held without brackets.
Url.parse("http://[::1]:80/") | Result.map({ "${x.host} ${x.port}" }) // => Ok{ value: "::1 80" }
Url.stringify(Result.unwrap(Url.parse("http://[::1]:80/"))) // => "http://[::1]:80/"
Url.parse("http://Example.COM/") | Result.map({ x.host }) // => Ok{ value: "Example.COM" }
// Lenient outside the host: a raw space is kept.
Url.parse("http://h/a b?q=x y") | Result.map({ "${x.path}|${x.query}" }) // => Ok{ value: "/a b|q=x y" }
Url.parse("http://h/%FF")                       // => Err{ error: Error{ message: "parse \"http://h/%FF\": the %XX escapes do not decode to UTF-8 text", kind: null } }
// escape writes upper-case hex; unescape reads either case and keeps other characters.
Url.escape("é")                                 // => "%C3%A9"
Url.unescape("%c3%a9 x")                        // => Ok{ value: "é x" }
// parseQuery splits a pair at its first = and skips empty pairs.
Url.parseQuery("a=b=c&&=x&")                    // => Ok{ value: Map{ "a": ["b=c"], "": ["x"] } }
// A key with no values writes nothing.
Url.stringifyQuery(Map{ "a": [], "b": ["1"] })  // => "b=1"
