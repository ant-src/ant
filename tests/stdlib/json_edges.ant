// spec: stdlib Json; 12 Runtime panics
// Json at its edges: escapes, numbers that are not integers, duplicate keys, nesting,
// surrounding white space, malformed text as Err, and stringify of each kind and of a round
// trip.
Json.parse("\"\\u00e9\\n\"")                    // => Ok{ value: "é\n" }
Json.parse("1e30") | Result.map({ if x is float64 { Math.toInt(x) } else { -1 } }) // => Ok{ value: null }
Json.parse("-0") | Result.map({ x == 0.0 })   // => Ok{ value: true }
Json.parse("{\"a\": 1, \"a\": 2}")                // => Ok{ value: Map{ "a": 2.0 } }
Json.parse("[[[[1]]]]")                       // => Ok{ value: [[[[1.0]]]] }
Json.parse("  true  ")                        // => Ok{ value: true }
Json.parse("nul") is Err                      // => true
Json.parse("[1,]") is Err                     // => true
Json.parse("{\"a\": [1, {\"b\": null}]}")         // => Ok{ value: Map{ "a": [1.0, Map{ "b": null }] } }
Json.stringify(1.5)                           // => "1.5"
Json.stringify("é\n\"\\")                     // => "\"é\\n\\\"\\\\\""
Json.stringify(Map{ b: [true, null] })        // => "{\"b\":[true,null]}"
Json.stringify([1, "x"])                      // => "[1,\"x\"]"
Json.stringify(null)                          // => "null"
var roundTrip = Json.parse(Json.stringify(Map{ k: [1.5, "s", null, true] }))
roundTrip                                     // => Ok{ value: Map{ "k": [1.5, "s", null, true] } }
Json.stringify(Json.parse("{}") | Result.unwrapOr(null)) // => "{}"
Json.stringify(Json.parse("[]") | Result.unwrapOr(null)) // => "[]"

// A \u escape of a surrogate pair is the one code point it encodes; a lone surrogate escape,
// which encodes no text, becomes U+FFFD.
Json.parse("\"\\ud83d\\udc1c\"")              // => Ok{ value: "🐜" }
Result.unwrap(Json.parse("\"\\ud800x\"")) == "\u{FFFD}x"   // => true
Result.unwrap(Json.parse("\"\\udc1c\\ud83d\"")) == "\u{FFFD}\u{FFFD}"   // => true

// A repeated key keeps its first place and its last value. Nesting is allowed 10000 deep, no
// deeper, and the errors say where the text goes wrong in Ant's words.
Json.parse("{\"a\": 1, \"b\": 2, \"a\": 3}")        // => Ok{ value: Map{ "a": 3.0, "b": 2.0 } }
Json.parse(String.repeat("[", 10000) + String.repeat("]", 10000)) is Ok // => true
Json.parse(String.repeat("[", 10001) + String.repeat("]", 10001)) // => Err{ error: Error{ message: "arrays and objects nested deeper than 10000 levels" } }
Json.parse("1e400")                           // => Err{ error: Error{ message: "number 1e400 is too large for a float64" } }
Json.parse("1e-400")                          // => Ok{ value: 0.0 }
Json.parse("[1 2]")                           // => Err{ error: Error{ message: "expected ',' or ']' after an array element, found '2' at line 1, column 4" } }
Json.parse("{\n  \"a\" 1}")                   // => Err{ error: Error{ message: "expected ':' after an object key, found '1' at line 2, column 7" } }
Json.parse("{1: 2}")                          // => Err{ error: Error{ message: "expected a string key, found '1' at line 1, column 2" } }
Json.parse("[1] ]")                           // => Err{ error: Error{ message: "unexpected text after the JSON value" } }

// Like Bytes, a function, a reference such as a Random or a Mutex, and void have no JSON form,
// as a value or inside one; as a map key, any of them fails the rule that keys are strings.
func nothing(): void {}
Json.stringify(nothing)                       // => panic: Json.stringify: a function has no JSON form
Json.stringify(Map{ "f": nothing })           // => panic: Json.stringify: a function has no JSON form
Json.stringify(Map{ "r": Random.new(1) })     // => panic: Json.stringify: Random has no JSON form
Json.stringify(Map{ Random.new(1): 1 })       // => panic: Json.stringify: a map key must be a string, got Random
Json.stringify(Mutex.new())                   // => panic: Json.stringify: Mutex has no JSON form
Json.stringify(nothing())                     // => panic: Json.stringify: void has no JSON form
