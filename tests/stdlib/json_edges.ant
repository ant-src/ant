// spec: stdlib Json; 12 Runtime panics
// Json at its edges: escapes, numbers that are not integers, duplicate keys, nesting,
// surrounding white space, malformed text as Err, and stringify of each kind and of a round
// trip.
Json.parse("\"\\u00e9\\n\"")                    // => Ok{ value: "é\n" }
Json.parse("1e30") | Result.map({ if x is float64 { Math.toInt(x) } else { -1 } }) // => Ok{ value: null }
Json.parse("-0") | Result.map({ x == 0.0 })   // => Ok{ value: true }
Json.parse("[[[[1]]]]")                       // => Ok{ value: [[[[1.0]]]] }
Json.parse("  true  ")                        // => Ok{ value: true }
Json.parse("nul") is Err                      // => true
Json.parse("[1,]") is Err                     // => true
Json.parse("{\"a\": [1, {\"b\": null}]}")         // => Ok{ value: Map{ "a": [1.0, Map{ "b": null }] } }
Json.stringify(1.5)                           // => "1.5"
Json.stringify("é\n\"\\")                     // => "\"é\\n\\\"\\\\\""
Json.stringify(Map{ b: [true, null] })        // => "{\"b\":[true,null]}"
Json.stringify([1, "x"])                      // => "[1,\"x\"]"
Json.stringify(null)                          // => "null"
var roundTrip = Json.parse(Json.stringify(Map{ k: [1.5, "s", null, true] }))
roundTrip                                     // => Ok{ value: Map{ "k": [1.5, "s", null, true] } }
Json.stringify(Json.parse("{}") | Result.unwrapOr(null)) // => "{}"
Json.stringify(Json.parse("[]") | Result.unwrapOr(null)) // => "[]"

// A \u escape of a surrogate pair is the one code point it encodes; a surrogate escape outside
// a pair, which encodes no text, is Err.
Json.parse("\"\\ud83d\\udc1c\"")              // => Ok{ value: "🐜" }
Json.parse("\"\\ud800x\"")                    // => Err{ error: Error{ message: "unpaired surrogate \\ud800 at line 1, column 2", kind: null } }
Json.parse("\"a\\uDC1C\\ud83d\"")             // => Err{ error: Error{ message: "unpaired surrogate \\udc1c at line 1, column 3", kind: null } }
Json.parse("\"\\ud83d\\u0041\"")              // => Err{ error: Error{ message: "unpaired surrogate \\ud83d at line 1, column 2", kind: null } }
// A text that ends where the low half could still come is cut short; after a low half it is wrong.
Json.parse("\"\\ud83d")                        // => Err{ error: Error{ message: "unexpected end of JSON input", kind: null } }
Json.parse("\"\\ud83d\\")                      // => Err{ error: Error{ message: "unexpected end of JSON input", kind: null } }
Json.parse("\"\\ud83d\\udc")                   // => Err{ error: Error{ message: "unexpected end of JSON input", kind: null } }
Json.parse("\"\\udc1c")                        // => Err{ error: Error{ message: "unpaired surrogate \\udc1c at line 1, column 2", kind: null } }
Json.parse("\"\\ud83d\\uzz\"")                // => Err{ error: Error{ message: "unpaired surrogate \\ud83d at line 1, column 2", kind: null } }
Json.parse("\"\\ud83d\\ud83d\\udc1c\"")       // => Err{ error: Error{ message: "unpaired surrogate \\ud83d at line 1, column 2", kind: null } }
Json.parse("\"\\ud83dx\"")                    // => Err{ error: Error{ message: "unpaired surrogate \\ud83d at line 1, column 2", kind: null } }

// A repeated name is Err, at any depth, and two names are one when they are equal after their
// escapes are read. Nesting is allowed 10000 deep, no deeper, and the errors say where the text
// goes wrong in Ant's words.
Json.parse("{\"a\": 1, \"b\": 2, \"a\": 3}")        // => Err{ error: Error{ message: "duplicate name \"a\" at line 1, column 18", kind: null } }
Json.parse("[{\"k\": {\"x\": 1,\n \"\\u0078\": 2}}]") // => Err{ error: Error{ message: "duplicate name \"x\" at line 2, column 2", kind: null } }
Json.parse("{\"a\": {\"b\": 1}, \"c\": {\"b\": 2}}") is Ok // => true
Json.parse(String.repeat("[", 10000) + String.repeat("]", 10000)) is Ok // => true
Json.parse(String.repeat("[", 10001) + String.repeat("]", 10001)) // => Err{ error: Error{ message: "arrays and objects nested deeper than 10000 levels", kind: null } }
Json.parse("1e400")                           // => Err{ error: Error{ message: "number 1e400 is too large for a float64", kind: null } }
Json.parse("1e-400")                          // => Ok{ value: 0.0 }
Json.parse("[1 2]")                           // => Err{ error: Error{ message: "expected ',' or ']' after an array element, found '2' at line 1, column 4", kind: null } }
Json.parse("{\n  \"a\" 1}")                   // => Err{ error: Error{ message: "expected ':' after an object key, found '1' at line 2, column 7", kind: null } }
Json.parse("{1: 2}")                          // => Err{ error: Error{ message: "expected a string key, found '1' at line 1, column 2", kind: null } }
Json.parse("[1] ]")                           // => Err{ error: Error{ message: "unexpected text after the JSON value", kind: null } }

// Like Bytes, a function, a reference such as a Random or a Mutex, and void have no JSON form,
// as a value or inside one; as a map key, any of them fails the rule that keys are strings.
func nothing(): void {}
Json.stringify(nothing)                       // => panic: Json.stringify: a function has no JSON form
Json.stringify(Map{ "f": nothing })           // => panic: Json.stringify: a function has no JSON form
Json.stringify(Map{ "r": Random.new(1) })     // => panic: Json.stringify: Random has no JSON form
Json.stringify(Map{ Random.new(1): 1 })       // => panic: Json.stringify: a map key must be a string, got Random
Json.stringify(Mutex.new())                   // => panic: Json.stringify: Mutex has no JSON form
Json.stringify(nothing())                     // => panic: Json.stringify: void has no JSON form
// The indent is checked as the other panics are, with the same prefix.
Json.stringify([1], indent: "--")               // => panic: Json.stringify: the indent must be spaces and tabs, got "--"
