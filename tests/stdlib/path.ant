// spec: stdlib Path
// Path (stdlib.md): pure functions over paths in the host's convention, each a function of
// Go's path/filepath.
Path.join(["a", "b", "../c", "d.ant"])        // => "a/c/d.ant"
Path.join([])                                 // => "."
Path.join(["", ""])                           // => "."
Path.base("/x/y/z.ant")                       // => "z.ant"
Path.base("")                                 // => "."
Path.dir("/x/y/z.ant")                        // => "/x/y"
Path.dir("z.ant")                             // => "."
Path.ext("main.ant")                          // => ".ant"
Path.ext("README")                            // => ""
Path.clean("a//b/./c/..")                     // => "a/b"
Path.isAbs("/x")                              // => true
Path.isAbs("x")                               // => false
Path.abs("x") | Result.map({ Path.isAbs(x) }) // => Ok{ value: true }
Path.rel("/a/b", "/a/b/c/d")                  // => Ok{ value: "c/d" }
Path.rel("/a/b", "/a/c")                      // => Ok{ value: "../c" }
Path.rel("a", "/b") is Err                    // => true
Path.rel("/a", "b") is Err                    // => true
Path.rel("../a", "b")                         // => Err{ error: Error{ message: "no relative path leads from ../a to b" } }
Path.rel("../a", "../b")                      // => Ok{ value: "../b" }
// Path.match (stdlib.md, Path): Go's filepath.Match per element, ** across elements, [!...], and
// the shell's leading-dot rule.
Path.match("*.txt", "a.txt")                       // => Ok{ value: true }
Path.match("*.txt", "dir/a.txt")                   // => Ok{ value: false }
Path.match("*.txt", "./a.txt")                     // => Ok{ value: false }
Path.match("*", "")                                // => Ok{ value: true }
Path.match("?.ant", "é.ant")                       // => Ok{ value: true }
Path.match("[a-c]x", "bx")                         // => Ok{ value: true }
Path.match("[^a-c]x", "bx")                        // => Ok{ value: false }
Path.match("[!a-c]x", "dx")                        // => Ok{ value: true }
Path.match("a\\*", "a*")                           // => Ok{ value: true }
Path.match("a\\*", "ab")                           // => Ok{ value: false }
Path.match("[*]", "*")                             // => Ok{ value: true }
Path.match("*a*b", "xaab")                         // => Ok{ value: true }
Path.match("*.TXT", "a.txt")                       // => Ok{ value: false }
Path.match("**/*.ant", "a.ant")                    // => Ok{ value: true }
Path.match("**/*.ant", "x/y/a.ant")                // => Ok{ value: true }
Path.match("src/**", "src/a/b")                    // => Ok{ value: true }
Path.match("src/**", "src")                        // => Ok{ value: false }
Path.match("a**b", "a/b")                          // => Ok{ value: false }
Path.match("a**b", "axxb")                         // => Ok{ value: true }
Path.match("*", ".env")                            // => Ok{ value: false }
Path.match("?ab", ".ab")                           // => Ok{ value: false }
Path.match(".*", ".env")                           // => Ok{ value: true }
Path.match("*", ".env", hidden: true)              // => Ok{ value: true }
Path.match("**/*.ant", ".git/a.ant")               // => Ok{ value: false }
Path.match("**/*.ant", ".git/a.ant", hidden: true) // => Ok{ value: true }
Path.match("*", "..", hidden: true)                // => Ok{ value: false }
Path.match("../*.txt", "../a.txt")                 // => Ok{ value: true }
Path.match("*/", "src/")                           // => Ok{ value: true }
Path.match("*/", "src")                            // => Ok{ value: false }
Path.match("/x/*", "/x/y")                         // => Ok{ value: true }
Path.match("[a", "a")                              // => Err{ error: Error{ message: "malformed pattern [a: [ without ]" } }
Path.match("[z-a]", "a") is Err                    // => true
Path.match("[]", "a") is Err                       // => true
Path.match("[-a]", "a") is Err                     // => true
Path.match("a\\", "a") is Err                      // => true
Path.match("[]a]", "a")                            // => Err{ error: Error{ message: "malformed pattern []a]: ] first in a set; escape it, or the set is empty" } }
Path.match("[a-]]", "a")                           // => Err{ error: Error{ message: "malformed pattern [a-]]: ] ends a range; escape it" } }
Path.match("[\\]a]", "]")                          // => Ok{ value: true }
Path.match("a/**/b", "a/b")                        // => Ok{ value: true }
Path.match("a/**/b", "a/.x/b")                     // => Ok{ value: false }
Path.match("a/**/b", "a/.x/b", hidden: true)       // => Ok{ value: true }
Path.match("**/x/**/y", "p/x/q/x/y")               // => Ok{ value: true }
// Path.join skips empty parts; Path.clean's rules at the root, above a relative start, and at a
// trailing separator; Path.base and Path.dir at trailing separators and the root; Path.ext from
// the last dot after the last separator (stdlib.md, Path).
Path.join(["", "a"])                          // => "a"
Path.join(["a", "", "b"])                     // => "a/b"
Path.clean("/../a")                           // => "/a"
Path.clean("a/../..")                         // => ".."
Path.clean("a/b/")                            // => "a/b"
Path.clean("//a")                             // => "/a"
Path.base("photos//2024//")                   // => "2024"
Path.base("///")                              // => "/"
Path.dir("photos/2024/")                      // => "photos/2024"
Path.dir("/")                                 // => "/"
Path.dir("./a/b")                             // => "a"
Path.dir("a//b")                              // => "a"
Path.dir("a/../b/c")                          // => "b"
Path.dir("")                                  // => "."
Path.join([Path.dir("photos/2024/"), Path.base("photos/2024/")]) // => "photos/2024/2024"
Path.ext("a/b.tar.gz")                        // => ".gz"
Path.ext(".env")                              // => ".env"
Path.ext("draft.")                            // => "."
Path.ext("..")                                // => "."
Path.base("a.txt/")                           // => "a.txt"
Path.ext("a.txt/")                            // => ""
Path.isAbs("\\x")                             // => false
Path.isAbs("C:\\x")                           // => false
// Path.match: the empty path is one empty element, a trailing separator adds none, and a set is a
// wildcard for the leading-dot rule, even [.].
Path.match("**", "")                               // => Ok{ value: true }
Path.match("?", "")                                // => Ok{ value: false }
Path.match("src/*", "src/")                        // => Ok{ value: false }
Path.match("src/**", "src/")                       // => Ok{ value: false }
Path.match("[.]env", ".env")                       // => Ok{ value: false }
Path.match("[.]env", ".env", hidden: true)         // => Ok{ value: true }
Path.match(".env", ".env")                         // => Ok{ value: true }
