// spec: stdlib Encoding
// Encoding: base64 in the standard and the URL-safe alphabet, padded on the way out and with
// the padding optional and line breaks ignored on the way in; hex in lower case out and either
// case in; Err on a character outside the alphabet or an odd length.
var bytes = String.toBytes("hi there")
Encoding.toBase64(bytes)                      // => "aGkgdGhlcmU="
Encoding.toBase64(String.toBytes(""))         // => ""
Encoding.toBase64([byte(251), byte(255)])     // => "+/8="
Encoding.toBase64([byte(251), byte(255)], url: true) // => "-_8="
Encoding.fromBase64("aGkgdGhlcmU=")           // => Ok{ value: [104, 105, 32, 116, 104, 101, 114, 101] }
Encoding.fromBase64("aGkgdGhlcmU")            // => Ok{ value: [104, 105, 32, 116, 104, 101, 114, 101] }
Encoding.fromBase64("aGkg\ndGhlcmU=\n")       // => Ok{ value: [104, 105, 32, 116, 104, 101, 114, 101] }
Encoding.fromBase64("-_8=", url: true)        // => Ok{ value: [251, 255] }
Encoding.fromBase64("+/8=")                   // => Ok{ value: [251, 255] }
Encoding.fromBase64("-_8=")                   // => Err{ error: Error{ message: "illegal base64 data at input byte 0" } }
Result.isOk(Encoding.fromBase64("a"))         // => false
Encoding.fromBase64("aGkgdGhlcmU=") | Result.map(String.fromBytes) // => Ok{ value: "hi there" }
Encoding.toHex(bytes)                         // => "6869207468657265"
Encoding.toHex([])                            // => ""
Encoding.fromHex("6869")                      // => Ok{ value: [104, 105] }
Encoding.fromHex("6A6B") == Encoding.fromHex("6a6b") // => true
Result.isOk(Encoding.fromHex("abc"))          // => false
Encoding.fromHex("zz")                        // => Err{ error: Error{ message: "encoding/hex: invalid byte: U+007A 'z'" } }
Encoding.fromHex("0ñ")                        // => Err{ error: Error{ message: "encoding/hex: invalid byte: U+00F1 'ñ'" } }
