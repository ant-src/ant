// spec: 11 Array; 12 Runtime panics

// From array_lib.
// Array (section 11): every function, in the order of the listing; sorts are stable and
// return new arrays.
var xs = [3, 1, 2]
Array.length(xs)                              // => 3
Array.isEmpty(xs)                             // => false
var none: Array[int] = []
Array.isEmpty(none)                           // => true
Array.get(xs, 1)                              // => 1
Array.get(xs, 3)                              // => null
Array.get(xs, -1)                             // => null
Array.push(xs, 4)
xs                                            // => [3, 1, 2, 4]
Array.pop(xs)                                 // => 4
Array.pop(none)                               // => null
xs                                            // => [3, 1, 2]
Array.slice(xs, 1, 3)                         // => [1, 2]
Array.slice(xs, 0, 0)                         // => []
Array.concat(xs, [9])                         // => [3, 1, 2, 9]
xs                                            // => [3, 1, 2]
Array.map(xs, { x * 2 })                      // => [6, 2, 4]
Array.filter(xs, { x > 1 })                   // => [3, 2]
Array.reduce(xs, 10, func(acc: int, x: int): int { acc + x }) // => 16
Array.find(xs, { x < 3 })                     // => 1
Array.find(xs, { x > 5 })                     // => null
Array.some(xs, { x == 2 })                    // => true
Array.every(xs, { x > 0 })                    // => true
Array.every(xs, { x > 1 })                    // => false
Array.contains(xs, 2)                         // => true
Array.contains(xs, 7)                         // => false
Array.indexOf(xs, 2)                          // => 2
Array.indexOf(xs, 7)                          // => null
Array.sort(xs)                                // => [1, 2, 3]
Array.sort(["b", "a", "c"])                   // => ["a", "b", "c"]
xs                                            // => [3, 1, 2]
Array.sortBy(["ccc", "a", "bb"], { String.length(x) }) // => ["a", "bb", "ccc"]
Array.sortWith([1, 2, 3], func(a: int, b: int): int { b - a }) // => [3, 2, 1]
Array.sortBy([3, 1, 2, 1], { x % 2 })         // => [2, 3, 1, 1]
Array.reverse(xs)                             // => [2, 1, 3]
Array.entries(["a", "b"])                     // => [Indexed{ index: 0, value: "a" }, Indexed{ index: 1, value: "b" }]
Array.range(0, 4)                             // => [0, 1, 2, 3]
Array.range(3, 3)                             // => []
Array.filled(3, "x")                          // => ["x", "x", "x"]
Array.flatten([[1], [], [2, 3]])              // => [1, 2, 3]
Array.sum(xs)                                 // => 6
Array.sum(none)                               // => null
Array.sum([1.5, 2.5])                         // => 4.0
Array.sum(none) ?? 0                          // => 0
var ys = xs
Array.same(xs, ys)                            // => true
Array.same(xs, Array.concat(xs, []))          // => false
Array.contains([[1, 2]], [1, 2])              // => true

// From panic_chunk_size.
// A chunk size below 1 is a panic: no chunk could hold an element.
Array.chunk([1, 2, 3], 1)                     // => [[1], [2], [3]]
Array.chunk([1, 2, 3], 0)                     // => panic: Array.chunk needs a size of at least 1, got 0

// From panic_filled_negative.
// Array.filled with a negative count panics (section 11).
Array.filled(2, 7)                            // => [7, 7]
Array.filled(-1, 7)                           // => panic: Array.filled needs a count of at least 0, got -1

// From panic_insert_range.
// insert takes an index from 0 up to and including the length, where it appends; beyond that
// is a panic, as is a negative index.
xs = [1, 2]
Array.insert(xs, 2, 3)
xs                                            // => [1, 2, 3]
Array.insert(xs, 4, 5)                        // => panic: Array.insert: the index 4 is not within 0..3
xs                                            // => [1, 2, 3]

// From panic_remove_at_range.
// removeAt takes an index from 0 up to but excluding the length; the length itself
// panics, as does a negative index.
xs = [1, 2]
Array.removeAt(xs, 1)                         // => 2
xs                                            // => [1]
Array.removeAt(xs, 1)                         // => panic: Array.removeAt: the index 1 is out of range for a length of 1

// From panic_slice.
// Array.slice with a range outside the array panics (section 11).
xs = [1, 2, 3]
Array.slice(xs, 0, 3)                         // => [1, 2, 3]
Array.slice(xs, 2, 1)                         // => panic: Array.slice: the range 2..1 is not within 0..3

// From panic_sum_overflow.
// Array.sum panics when the sum does not fit the kind (section 11).
Array.sum([int8(100), int8(27)])              // => 127
Array.sum([int8(100), int8(28)])              // => panic: Array.sum: integer overflow
