// spec: stdlib Time
// Time values (stdlib.md): instants, zones, the plain types and zoned date-times as Temporal
// has them: construction and parsing, RFC 9557 rendering, fields, conversions between the
// types, gaps and overlaps resolved by disambiguation, equality by value and compare by
// instant, with the examples of Temporal's documentation.
func describe(t: Time.Dated): string {
  if t is Time.PlainDate { "date ${t}" }
  else if t is Time.ZonedDateTime { "zoned in ${Time.zoneId(Time.zoneOf(t))}" }
  else { "date-time on ${Time.toPlainDate(t)}" }
}
var ny = Result.unwrap(Time.zone("America/New_York"))
ny                                            // => America/New_York
Time.zoneId(Result.unwrap(Time.zone("europe/stockholm"))) // => "Europe/Stockholm"
Time.zone("Mars/Olympus") is Err              // => true
Time.zone("") is Err                          // => true
Time.zone("Asia/Calcutta") == Time.zone("Asia/Kolkata") // => true
Time.zone("Europe/Stockholm") == Time.zone("Europe/Berlin") // => false
Result.unwrap(Time.zone("US/Eastern")) == ny  // => true
Time.zoneId(Result.unwrap(Time.zone("+0530"))) // => "+05:30"
Time.utc                                      // => UTC
Time.zoneId(Time.localZone()) != ""           // => true
var i = Result.unwrap(Time.parseInstant("2026-10-22T14:03:05.5Z"))
i                                             // => 2026-10-22T14:03:05.5Z
Time.epochMillis(i)                           // => 1792677785500
Time.epochNanos(i)                            // => 1792677785500000000
Time.fromEpochMillis(1792677785500) == Time.fromEpochNanos(1792677785500000000) // => true
Time.fromEpochMillis(0)                       // => 1970-01-01T00:00:00Z
Result.unwrap(Time.parseInstant("2026-10-22T16:03:05.5+02:00[Europe/Stockholm]")) == i // => true
Time.parseInstant("2026-10-22T14:03:05") is Err // => true
var z = Result.unwrap(Time.parseZoned("2024-11-03T01:00:00-04:00[America/New_York]"))
z                                             // => 2024-11-03T01:00:00-04:00[America/New_York]
Time.offset(z)                                // => "-04:00"
Time.offsetSeconds(z)                         // => -14400
Time.hoursInDay(z)                            // => 25.0
Time.zoneOf(z) == ny                          // => true
Time.toInstant(z)                             // => 2024-11-03T05:00:00Z
Time.inZone(Time.toInstant(z), Time.utc)      // => 2024-11-03T05:00:00+00:00[UTC]
Time.withZone(z, Result.unwrap(Time.zone("Asia/Tokyo"))) // => 2024-11-03T14:00:00+09:00[Asia/Tokyo]
Time.toPlainDateTime(z)                       // => 2024-11-03T01:00:00
Time.toPlainDate(z)                           // => 2024-11-03
Time.toPlainTime(z)                           // => 01:00:00
Time.startOfDay(z)                            // => 2024-11-03T00:00:00-04:00[America/New_York]
Time.parseZoned("2024-11-03T01:05:00[America/New_York]") // => Ok{ value: 2024-11-03T01:05:00-04:00[America/New_York] }
Time.parseZoned("2024-11-03T01:05:00[America/New_York]", Time.Later{}) // => Ok{ value: 2024-11-03T01:05:00-05:00[America/New_York] }
Time.parseZoned("2024-03-10T02:05:00[America/New_York]") // => Ok{ value: 2024-03-10T03:05:00-04:00[America/New_York] }
Time.parseZoned("2019-12-23T12:00:00-02:00[America/Sao_Paulo]") is Err // => true
Time.parseZoned("2026-10-22T16:03:05+02:00") is Err // => true
// A date alone is the start of that day, which is 01:00 where midnight falls in a gap.
Time.parseZoned("2024-09-08[America/Santiago]") // => Ok{ value: 2024-09-08T01:00:00-03:00[America/Santiago] }
Time.parseZoned("2024-09-08[America/Santiago]", Time.Earlier{}) // => Ok{ value: 2024-09-08T01:00:00-03:00[America/Santiago] }
Time.parseZoned("2024-11-03[America/New_York]") // => Ok{ value: 2024-11-03T00:00:00-04:00[America/New_York] }
var gap = Result.unwrap(Time.parsePlainDateTime("2024-03-10T02:30:00"))
Time.toZoned(gap, ny)                         // => 2024-03-10T03:30:00-04:00[America/New_York]
Time.toZoned(gap, ny, Time.Earlier{})         // => 2024-03-10T01:30:00-05:00[America/New_York]
Time.toZoned(gap, ny, disambiguation: Time.Later{}) // => 2024-03-10T03:30:00-04:00[America/New_York]
Array.length(Time.possibleInstants(gap, ny))  // => 0
var overlap = Result.unwrap(Time.parsePlainDateTime("2024-11-03T01:30:00"))
Time.possibleInstants(overlap, ny)            // => [2024-11-03T05:30:00Z, 2024-11-03T06:30:00Z]
Time.toZoned(overlap, ny, Time.Compatible{})  // => 2024-11-03T01:30:00-04:00[America/New_York]
Time.toZoned(overlap, ny, Time.Later{})       // => 2024-11-03T01:30:00-05:00[America/New_York]
Time.hoursInDay(Time.toZoned(gap, ny))        // => 23.0
Time.hoursInDay(Result.unwrap(Time.parseZoned("2024-10-06T12:00[Australia/Lord_Howe]"))) // => 23.5
var d = Time.plainDate(2026, 10, 22)
d                                             // => 2026-10-22
[Time.year(d), Time.month(d), Time.day(d), Time.dayOfWeek(d), Time.dayOfYear(d),
  Time.weekOfYear(d), Time.yearOfWeek(d), Time.daysInMonth(d), Time.daysInYear(d)] // => [2026, 10, 22, 4, 295, 43, 2026, 31, 365]
Time.inLeapYear(d)                            // => false
Time.yearOfWeek(Time.plainDate(2021, 1, 1))   // => 2020
var t = Time.plainTime(14, 3, 5, 123, 456, 789)
t                                             // => 14:03:05.123456789
[Time.hour(t), Time.minute(t), Time.second(t), Time.millisecond(t), Time.microsecond(t), Time.nanosecond(t)] // => [14, 3, 5, 123, 456, 789]
Time.plainTime()                              // => 00:00:00
Time.plainTime(9, second: 30)                 // => 09:00:30
var dt = Time.plainDateTime(d, t)
dt                                            // => 2026-10-22T14:03:05.123456789
Time.year(dt) + Time.hour(dt)                 // => 2040
Time.year(z)                                  // => 2024
Time.hour(z)                                  // => 1
Time.parsePlainDate("2024-11-03T01:00:00-04:00[America/New_York]") // => Ok{ value: 2024-11-03 }
Time.parsePlainDate("2024-02-30") is Err      // => true
Time.parsePlainTime("14:03:05.123")           // => Ok{ value: 14:03:05.123 }
Time.parsePlainDateTime("2024-11-03T01:00:00Z") is Err // => true
// Parsing takes the grammar as stated and nothing more: an uppercase T and Z, a point before the
// fraction, an offset ±HH:MM, no critical flag, no leap second; a year beyond 9999 with its sign.
Time.parsePlainDateTime("2024-11-03 01:00:00.5") // => Ok{ value: 2024-11-03T01:00:00.5 }
Time.parsePlainDateTime("2024-11-03t01:00:00") is Err // => true
Time.parseInstant("2024-11-03T01:00:00z") is Err // => true
Time.parsePlainTime("01:00:00,5") is Err      // => true
Time.parseInstant("2024-11-03T01:00:00+05") is Err // => true
Time.parseInstant("2024-11-03T01:00:00+0530") is Err // => true
Time.parseZoned("2024-11-03T01:00:00-04:00[!America/New_York]") is Err // => true
Time.parsePlainTime("23:59:60") is Err        // => true
// Nor an offset with seconds, which a zoned value renders rounded to the minute, a T before a
// bare time, an annotation other than the zone and [u-ca=iso8601], or the calendar in capitals.
Time.parseInstant("2024-11-03T01:00:00+05:30:00") is Err // => true
Time.parseZoned("1883-11-18T12:00:00-04:56:02[America/New_York]") is Err // => true
Time.parseZoned("1883-11-18T12:00:00-04:56[America/New_York]") // => Ok{ value: 1883-11-18T12:00:00-04:56[America/New_York] }
Time.parsePlainTime("T14:03") is Err          // => true
Time.parsePlainDateTime("2024-11-03T01:00:00[foo=bar]") is Err // => true
Time.parsePlainDateTime("2024-11-03T01:00:00[u-ca=ISO8601]") is Err // => true
Time.parsePlainDateTime("2024-11-03T01:00:00[u-ca=iso8601]") // => Ok{ value: 2024-11-03T01:00:00 }
Time.parseZoned("2024-11-03T01:00:00-04:00[America/New_York][u-ca=iso8601]") // => Ok{ value: 2024-11-03T01:00:00-04:00[America/New_York] }
Time.parsePlainDate("+010000-01-01")          // => Ok{ value: +010000-01-01 }
Time.plainDate(-100000, 1, 1)                 // => -100000-01-01
var a = Result.unwrap(Time.parseZoned("2021-07-01T12:34:56+05:30[Asia/Kolkata]"))
var b = Result.unwrap(Time.parseZoned("2021-07-01T12:34:56+05:30[Asia/Calcutta]"))
var c = Result.unwrap(Time.parseZoned("2021-07-01T07:04:56+00:00[UTC]"))
a == b                                        // => true
a == c                                        // => false
d == Time.plainDate(2026, 10, 22) && t == Time.plainTime(14, 3, 5, 123, 456, 789) && dt == Time.plainDateTime(d, t) // => true
Time.compare(a, c)                            // => 0
Time.compare(Time.plainDate(2024, 2, 29), d)  // => -1
Time.compare(t, Time.plainTime(14))           // => 1
var seen: Map[Time.Instant, string] = Map{}
seen[Time.toInstant(a)] = "a"
seen[Time.toInstant(c)]                       // => "a"
Json.stringify([d, t, a])                     // => "[\"2026-10-22\",\"14:03:05.123456789\",\"2021-07-01T12:34:56+05:30[Asia/Kolkata]\"]"
describe(d)                                   // => "date 2026-10-22"
describe(z)                                   // => "zoned in America/New_York"
describe(dt)                                  // => "date-time on 2026-10-22"
Time.epochMillis(Time.now()) > 1700000000000  // => true
Time.year(Time.nowIn(Time.utc)) >= 2026       // => true

// Dates are in the ISO 8601 calendar, the proleptic Gregorian one with a year 0 and negative
// years; a leap year is divisible by 4, except a century year not divisible by 400.
Time.inLeapYear(Time.plainDate(2000, 2, 1))   // => true
Time.inLeapYear(Time.plainDate(1900, 2, 1))   // => false
Time.inLeapYear(Time.plainDate(0, 2, 1))      // => true
Time.inLeapYear(Time.plainDate(-100, 2, 1))   // => false
Time.daysInMonth(Time.plainDate(1900, 2, 1))  // => 28
Time.daysInYear(Time.plainDate(-4, 1, 1))     // => 366
Time.plainDate(1900, 2, 29)                   // => panic: Time.plainDate: no such date: 1900-02-29

// The day of the year runs from 1 to 365, or 366 in a leap year; plainTime's fields have the
// ranges of a clock.
Time.dayOfYear(Time.plainDate(2026, 1, 1))    // => 1
Time.dayOfYear(Time.plainDate(2028, 12, 31))  // => 366
Time.plainTime(second: 60)                    // => panic: Time.plainTime: second out of range: 60
Time.plainTime(millisecond: 1000)             // => panic: Time.plainTime: millisecond out of range: 1000
Time.plainTime(minute: -1)                    // => panic: Time.plainTime: minute out of range: -1

// An offset zone is below 24 hours, and a zero offset is written with +.
Time.zone("+23:59")                           // => Ok{ value: +23:59 }
Time.zone("+24:00") is Err                    // => true
Time.zoneId(Result.unwrap(Time.zone("-00:00"))) // => "+00:00"

// A bracketed zone is read in any letter case and renders as the database spells it.
Time.parseZoned("2026-10-22T16:03:05+02:00[europe/stockholm]") // => Ok{ value: 2026-10-22T16:03:05+02:00[Europe/Stockholm] }

// The plain parsers keep their own part of any form, but the whole string must be well formed;
// the bracketed zone's name is not looked up.
Time.parsePlainDate("2026-10-22 trailing") is Err // => true
Time.parsePlainDate("2026-10-22T25:00") is Err // => true
Time.parsePlainTime("2026-02-30T10:00") is Err // => true
Time.parsePlainDateTime("2026-02-30T10:00") is Err // => true
Time.parsePlainDate("2026-10-22T10:00+24:00") is Err // => true
Time.parsePlainDate("2026-10-22T10:00[Nowhere/Zone]") // => Ok{ value: 2026-10-22 }

// Lord Howe Island moves its clocks by half an hour, so its change days are 23.5 and 24.5 hours.
Time.hoursInDay(Result.unwrap(Time.parseZoned("2026-04-05T12:00[Australia/Lord_Howe]"))) // => 24.5

// In a gap, Earlier reads the time with the offset from after the change, moving it back.
var nyGap = Result.unwrap(Time.zone("America/New_York"))
var spring = Result.unwrap(Time.parsePlainDateTime("2026-03-08T02:30"))
Time.toZoned(spring, nyGap, disambiguation: Time.Earlier{}) // => 2026-03-08T01:30:00-05:00[America/New_York]
Time.toZoned(spring, nyGap, disambiguation: Time.Later{}) // => 2026-03-08T03:30:00-04:00[America/New_York]

// A PlainTime that rounds up to 24:00 wraps to midnight; a PlainDateTime moves to the next day.
Time.round(Time.plainTime(23, 50), Time.Hour{}) // => 00:00:00
Time.round(Time.plainDateTime(Time.plainDate(2026, 1, 1), Time.plainTime(23, 50)), Time.Hour{}) // => 2026-01-02T00:00:00
