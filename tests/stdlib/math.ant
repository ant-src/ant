// spec: 11 Math and Bits; 12 Runtime panics

// From math_lib.
// Math (section 11): every function and constant; round is half away from zero; toInt is int
// without the panic.
Math.abs(-5)                                  // => 5
Math.abs(5)                                   // => 5
Math.abs(-2.5)                                // => 2.5
Math.abs(int8(-3))                            // => 3
Math.min(1, 2)                                // => 1
Math.max(1, 2)                                // => 2
Math.min("b", "a")                            // => "a"
Math.max(1.5, -1.5)                           // => 1.5
Math.pow(2.0, 10.0)                           // => 1024.0
Math.sqrt(16.0)                               // => 4.0
Math.floor(-1.5)                              // => -2.0
Math.ceil(-1.5)                               // => -1.0
Math.round(2.5)                               // => 3.0
Math.round(-2.5)                              // => -3.0
Math.round(2.4)                               // => 2.0
Math.trunc(-2.7)                              // => -2.0
int(Math.trunc(-2.7))                         // => -2
Math.toInt(3.0)                               // => 3
Math.toInt(3.5)                               // => null
Math.toInt(1e30)                              // => null
Math.toInt(0.0 / 0.0)                         // => null
Math.PI > 3.14 && Math.PI < 3.15              // => true
Math.E > 2.71 && Math.E < 2.72                // => true
Math.minInt                                   // => -9223372036854775808
Math.maxInt                                   // => 9223372036854775807
Math.maxInt == 9223372036854775807            // => true
Math.random() >= 0.0 && Math.random() < 1.0   // => true

// From panic_abs_min.
// Math.abs of the most negative integer panics (section 11).
Math.abs(Math.minInt + 1)                     // => 9223372036854775807
Math.abs(Math.minInt)                         // => panic: Math.abs: integer overflow

// From panic_clamp_bounds.
// clamp with lo above hi is a panic: there is no value within the range.
Math.clamp(5, 1, 3)                           // => 3
Math.clamp(5, 3, 1)                           // => panic: Math.clamp needs lo <= hi, got 3 and 1

// From panic_clamp_nan.
// A NaN bound in Math.clamp panics, since NaN compares as neither above nor below anything and
// the bound would hold nothing.
Math.clamp(5, 1, 3)                           // => 3
Math.clamp(0.5, Math.NaN, 1.0)                // => panic: Math.clamp needs bounds that are not NaN, got NaN and 1.0

// From panic_random_int_range.
// randomInt with to at or below from is a panic: the range is empty.
Math.randomInt(3, 4)                          // => 3
Math.randomInt(3, 3)                          // => panic: Math.randomInt needs from < to, got 3 and 3
