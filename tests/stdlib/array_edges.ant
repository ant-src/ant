// spec: 11 Array

// From array_edges.
// Each Array function at its documented edges: get and pop give null, ranges are half-open
// and may be empty, concat, reverse and sort return new arrays, contains and indexOf compare
// with ==, sorts are stable, sortWith puts a before b when cmp is negative, filled repeats one
// value, sum of an empty array is null, and same is identity.
type P = { n: int }
type Item = { key: int, tag: string }
var xs = [3, 1, 2]
Array.get(xs, 2)                              // => 2
Array.get(xs, 3)                              // => null
Array.get(xs, -1)                             // => null
var e: Array[int] = []
Array.pop(e)                                  // => null
Array.isEmpty(e)                              // => true
Array.slice(xs, 3, 3)                         // => []
Array.slice(xs, 0, 0)                         // => []
Array.slice(xs, 1, 3)                         // => [1, 2]
var c = Array.concat(xs, [9])
c                                             // => [3, 1, 2, 9]
xs                                            // => [3, 1, 2]
var ps = [P{ n: 1 }, P{ n: 2 }]
Array.contains(ps, P{ n: 2 })                 // => true
Array.indexOf(ps, P{ n: 2 })                  // => 1
Array.indexOf(ps, P{ n: 3 })                  // => null
var items = [Item{ key: 2, tag: "a" }, Item{ key: 1, tag: "b" }, Item{ key: 2, tag: "c" }]
Array.map(Array.sortBy(items, { x.key }), { x.tag }) // => ["b", "a", "c"]
Array.map(Array.sortWith(items, func(a: Item, b: Item): int { b.key - a.key }), { x.tag }) // => ["a", "c", "b"]
Array.map(items, { x.tag })                   // => ["a", "b", "c"]
Array.sort([3, 1, 2])                         // => [1, 2, 3]
Array.sort(["b", "a", "B"])                   // => ["B", "a", "b"]
Array.sort([2.5, -1.0])                       // => [-1.0, 2.5]
var r = Array.reverse(xs)
r                                             // => [2, 1, 3]
xs                                            // => [3, 1, 2]
Array.entries(["a", "b"])                     // => [Indexed{ index: 0, value: "a" }, Indexed{ index: 1, value: "b" }]
Array.range(0, 3)                             // => [0, 1, 2]
Array.range(3, 3)                             // => []
Array.range(3, 0)                             // => []
var filled = Array.filled(2, P{ n: 0 })
Record.same(filled[0], filled[1])             // => true
Array.flatten([[1], [], [2, 3]])              // => [1, 2, 3]
Array.sum(e)                                  // => null
Array.sum([1.5, 2.5])                         // => 4.0
Array.sum([int8(1), int8(2)])                 // => 3
Array.some(xs, { x > 2 })                     // => true
Array.every(xs, { x > 2 })                    // => false
Array.find(xs, { x < 3 })                     // => 1
Array.find(xs, { x > 9 })                     // => null
Array.reduce(xs, "", func(acc: string, n: int): string { acc + String.from(n) }) // => "312"
Array.filter(xs, { x % 2 == 1 })              // => [3, 1]
Array.same(xs, xs) && !Array.same(xs, Array.concat(xs, e)) // => true
Array.length(Array.filled(0, 1))              // => 0
