// spec: stdlib Http; stdlib Time
// Http.request with any method, headers and a timeout, and get and post as its forms: a
// response of any status is Ok; a timeout that passes is Err with the message timeout; a
// timeout in days converts at 24 hours, one with months or weeks, zero or negative is Err
// before anything is sent, and one beyond the host's range is taken as that range; an
// invalid method is Err.
func main(): void {
  var base = Os.args()[0]
  var put = Result.unwrap(Http.request("PUT", `${base}/echo`, "data", Map{ "X-Token": "t" }))
  print(put.status)
  print(put.body)
  print(put.headers["X-Method"])
  print(put.headers["X-Token"])
  var del = Result.unwrap(Http.request("DELETE", `${base}/echo`))
  print(del.headers["X-Method"])
  print(del.body == "")
  var got = Result.unwrap(Http.get(`${base}/echo`, Map{ "X-Token": "g" }, Time.duration(seconds: 5)))
  print(got.headers["X-Token"])
  print(got.headers["X-Method"])
  var posted = Result.unwrap(Http.post(`${base}/echo`, "p"))
  print(posted.body)
  print(posted.headers["X-Method"])
  print(Http.request("PUT", `${base}/slow`, timeout: Time.duration(milliseconds: 200)))
  print(Http.get(`${base}/slow`, timeout: Time.duration(milliseconds: 100)))
  print(Result.isOk(Http.get(`${base}/hello`, timeout: Time.duration(days: 1))))
  print(Http.get(`${base}/hello`, timeout: Time.duration(months: 1)))
  print(Http.get(`${base}/hello`, timeout: Time.duration(weeks: 1)))
  print(Http.get(`${base}/hello`, timeout: Time.duration()))
  print(Http.get(`${base}/hello`, timeout: Time.duration(seconds: -1)))
  print(Result.isOk(Http.get(`${base}/hello`, timeout: Time.duration(days: 4294967295))))
  print(Result.isOk(Http.request("BAD METHOD", `${base}/hello`)))
  print(Result.isOk(Http.request("GET", "http://127.0.0.1:1/unreachable", timeout: Time.duration(seconds: 5))))
}

// expect
// args: $HTTP
// out: 200
// out: data
// out: PUT
// out: t
// out: DELETE
// out: true
// out: g
// out: GET
// out: p
// out: POST
// out: Err{ error: Error{ message: "timeout" } }
// out: Err{ error: Error{ message: "timeout" } }
// out: true
// out: Err{ error: Error{ message: "the timeout has years, months or weeks, which have no fixed length" } }
// out: Err{ error: Error{ message: "the timeout has years, months or weeks, which have no fixed length" } }
// out: Err{ error: Error{ message: "the timeout is zero or negative" } }
// out: Err{ error: Error{ message: "the timeout is zero or negative" } }
// out: true
// out: false
// out: false
