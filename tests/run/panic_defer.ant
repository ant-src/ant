// spec: 8 defer; 8 panic; 12 Deferred blocks and panics
// A panic unwinds every block, running deferred blocks in reverse order, then the program exits
// with status 1 and the message on standard error (sections 8, 12).
func work(): void {
  defer { println("defer 1") }
  defer { println("defer 2") }
  println("working")
  panic("boom")
}

defer { println("main defer") }
work()
println("unreachable")

// expect
// out: working
// out: defer 2
// out: defer 1
// out: main defer
// exit: 1
// err: boom
