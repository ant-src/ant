// spec: 11 Map
// Map (section 11): every function, insertion order throughout, a stored null told from a
// missing key by Map.has, and Record.same.
type P = { x: int }

func main(): void {
  var m = Map{ b: 2, a: 1 }
  print(Map.size(m))
  print(Map.isEmpty(m))
  var empty: Map[string, int] = Map{}
  print(Map.isEmpty(empty))
  print(Map.has(m, "a"))
  print(Map.has(m, "z"))
  print(Map.get(m, "a"))
  print(Map.get(m, "z"))
  Map.set(m, "c", 3)
  Map.set(m, "a", 10)
  print(m)
  print(Map.remove(m, "b"))
  print(Map.remove(m, "b"))
  print(m)
  print(Map.keys(m))
  print(Map.values(m))
  print(Map.entries(m))
  print(Map.fromEntries([Entry{ key: "x", value: 1 }, Entry{ key: "y", value: 2 }, Entry{ key: "x", value: 3 }]))
  print(Map.map(m, { x.value * 2 }))
  print(Map.filter(m, { x.key == "c" }))
  print(Map.merge(Map{ x: 1, y: 2 }, Map{ z: 3, x: 9 }))
  var n = m
  print(Map.same(m, n))
  print(Map.same(m, Map.merge(m, empty)))
  var stored: Map[string, int | null] = Map{ k: null }
  print(Map.has(stored, "k"))
  print(stored["k"] == null)
  print(Map.has(stored, "missing"))
  var p = P{ x: 1 }
  var q = p
  print(Record.same(p, q))
  print(Record.same(p, P{ x: 1 }))
  print(p == P{ x: 1 })
}

// expect
// out: 2
// out: false
// out: true
// out: true
// out: false
// out: 1
// out: null
// out: Map{ "b": 2, "a": 10, "c": 3 }
// out: 2
// out: null
// out: Map{ "a": 10, "c": 3 }
// out: ["a", "c"]
// out: [10, 3]
// out: [Entry{ key: "a", value: 10 }, Entry{ key: "c", value: 3 }]
// out: Map{ "x": 3, "y": 2 }
// out: Map{ "a": 20, "c": 6 }
// out: Map{ "c": 3 }
// out: Map{ "x": 9, "y": 2, "z": 3 }
// out: true
// out: false
// out: true
// out: true
// out: false
// out: true
// out: false
// out: true
