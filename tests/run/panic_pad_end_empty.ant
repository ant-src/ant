// spec: 11 String; 12 Runtime panics
// panics: String.padEnd; library-value
// An empty pad is a ◆ panic, on the right as on the left.
func main(): void {
  print(String.padEnd("7", 3, "0"))
  print(String.padEnd("7", 3, ""))
}

// expect
// exit: 1
// out: 700
// err: String.padEnd needs a pad that is not empty
