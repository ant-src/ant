// spec: 12 Runtime panics; 5 Destructuring
// panics: destructuring-short
// An array destructuring with fewer elements than positions panics (section 5).
func main(): void {
  var one = [1]
  var [a, b] = one
  println(a + b)
}

// expect
// exit: 1
// err: a destructuring needs 2 elements, got 1
