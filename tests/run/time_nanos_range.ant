// spec: stdlib Time
// panics: Time.epochNanos; library-value
// epochNanos is a ◆ panic outside 1677 to 2262, where the nanoseconds do not fit an int.
func main(): void {
  var last = Result.unwrap(Time.parseInstant("2262-04-11T23:47:16.854775807Z"))
  print(Time.epochNanos(last))
  var far = Result.unwrap(Time.parseInstant("2300-01-01T00:00:00Z"))
  print(Time.epochNanos(far))
}

// expect
// exit: 1
// out: 9223372036854775807
// err: Time.epochNanos: the nanoseconds do not fit an int; the instant is outside 1677 to 2262
