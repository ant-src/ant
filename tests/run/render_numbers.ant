// String.from on numbers (section 11): integers render in decimal; floats as the shortest
// decimal that reads back to the same value, with .0 added when integral, and as NaN, Infinity,
// or -Infinity.
func main(): void {
  print(42)
  print(-7)
  print(0)
  print(int8(-128))
  print(uint8(255))
  print(3.5)
  print(2.0)
  print(-0.5)
  print(0.1 + 0.2)
  print(1.0 / 3.0)
  print(float32(0.1))
  print(1.0 / 0.0)
  print(-1.0 / 0.0)
  print(0.0 / 0.0)
  print(100.0)
  print(1e3)
  print(2.5e-3)
}

// expect
// out: 42
// out: -7
// out: 0
// out: -128
// out: 255
// out: 3.5
// out: 2.0
// out: -0.5
// out: 0.30000000000000004
// out: 0.3333333333333333
// out: 0.1
// out: Infinity
// out: -Infinity
// out: NaN
// out: 100.0
// out: 1000.0
// out: 0.0025
