// spec: 11 Synchronization
// panics: RwMutex.withWrite; library-value
// The release at the end of a with form is the unlock call, so it panics when the function
// already released the lock.
let l = RwMutex.new()
l.withWrite({ l.writeUnlock() })
println("unreached")

// expect
// exit: 1
// err: RwMutex.withWrite: the RwMutex is not write-locked
