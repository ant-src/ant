// spec: 9 Synchronization; 11 Synchronization
// Atomic: load, store, add, and compareAndSwap, which compares with == (sections 9, 11).
type Point = { x: int, y: int }

var a = Atomic.new(1)
println(Atomic.compareAndSwap(a, 1, 2))
println(Atomic.compareAndSwap(a, 1, 3))
println(Atomic.load(a))
println(Atomic.add(a, 10))
var p = Atomic.new(Point{ x: 1, y: 2 })
println(Atomic.compareAndSwap(p, Point{ x: 1, y: 2 }, Point{ x: 0, y: 0 }))
println(Atomic.load(p))
var f = Atomic.new(1.5)
println(Atomic.add(f, 1.0))
var wg = WaitGroup.new()
var winners = Atomic.new(0)
var flag = Atomic.new(false)
for _ in Iter.range(0, 50) {
  WaitGroup.add(wg, 1)
  go {
    defer { WaitGroup.done(wg) }
    if Atomic.compareAndSwap(flag, false, true) { _ = Atomic.add(winners, 1) }
  }
}
WaitGroup.wait(wg)
println(Atomic.load(winners))

// expect
// out: true
// out: false
// out: 2
// out: 12
// out: true
// out: Point{ x: 0, y: 0 }
// out: 2.5
// out: 1
