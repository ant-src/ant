// spec: stdlib Os
// Processes (stdlib.md): Os.run shares the program's streams and returns the status; Os.output
// returns standard output without one final newline and fails on a nonzero status; Os.start runs a
// child beside the program, with handles and pipes as its streams, and Os.wait, Os.kill and
// Os.stop end it; a signal's status is 128 + n. Run in a temporary directory given as the
// first argument.
var dir = Os.args()[0]

println("before")
println(Os.run("sh", ["-c", "echo from the child; exit 3"]))
println(Os.run("ant-no-such-program-xyz") is Err)

println(Os.output("printf", ["a\\n\\n"]))
println(Os.output("printf", ["crlf\\r\\n"]))
println(Os.output("sh", ["-c", "echo partial; echo broke >&2; exit 2"]))
println(Os.output("sh", ["-c", "exit 4"]))
println(Os.output("cat", stdin: "fed"))

println(Os.which("sh") != null)
println(Os.which("ant-no-such-program-xyz"))

// Output as it comes, both streams into one pipe.
var out = Result.unwrap(Os.openPipe())
var lines = Result.unwrap(Os.start("sh", ["-c", "echo one; echo two >&2; echo three"], stdout: out.write, stderr: out.write))
File.close(out.write)
var seen: Array[string] = []
while true {
  var line = Result.unwrap(File.readLine(out.read))
  if line == null { break }
  Array.push(seen, line)
}
println(Array.length(seen))
println(Os.wait(lines))
println(Os.wait(lines))

// Two children joined by a pipe, the last one's output captured by another.
var p = Result.unwrap(Os.openPipe())
var captured = Result.unwrap(Os.openPipe())
var log = Result.unwrap(Os.start("printf", ["fix a\\nnope\\nfix b\\n"], stdout: p.write))
var grep = Result.unwrap(Os.start("grep", ["fix"], stdin: p.read, stdout: captured.write))
File.close(p.write)
File.close(p.read)
File.close(captured.write)
println(File.readAll(captured.read))
println(Os.wait(log))
println(Os.wait(grep))

// A file as output, written after what the program wrote first, and as input, after what the
// program read from it.
var path = `${dir}/dump.txt`
var dump = Result.unwrap(File.create(path))
File.writeLine(dump, "header")
println(Os.wait(Result.unwrap(Os.start("echo", ["body"], stdout: dump))))
File.close(dump)
var input = Result.unwrap(File.open(path))
println(File.readLine(input))
var rest = Result.unwrap(Os.openPipe())
println(Os.wait(Result.unwrap(Os.start("cat", stdin: input, stdout: rest.write))))
File.close(rest.write)
println(File.readAll(rest.read))
println(Os.wait(Result.unwrap(Os.start("cat", stdout: null))))

// Ending a child: a signal's status is 128 + n, a name the host lacks is Err, and a context that
// ends kills it.
var sleeper = Result.unwrap(Os.start("sleep", ["30"]))
println(Os.pid(sleeper) > 0)
println(Os.kill(sleeper, "SIGNOPE"))
println(Os.stop(sleeper))
println(Os.kill(sleeper))
var stubborn = Result.unwrap(Os.start("sh", ["-c", "trap '' TERM; sleep 30"], stdout: null))
Time.sleep(Time.duration(milliseconds: 200))
println(Os.stop(stubborn, grace: Time.duration(milliseconds: 100)))
var interrupted = Result.unwrap(Os.start("sleep", ["30"]))
println(Os.kill(interrupted, "SIGINT"))
println(Os.wait(interrupted))
var bounded = Result.unwrap(Os.start("sleep", ["30"], ctx: Context.new(timeout: Time.duration(milliseconds: 50))))
println(Os.wait(bounded))
var waited = Result.unwrap(Os.start("sleep", ["30"]))
println(Os.wait(waited, ctx: Context.new(timeout: Time.duration(milliseconds: 50))))
println(Os.stop(waited))

// A pipe end handed to a child still ends a read when its context does; a handle the program
// has read ahead goes through a copy, which ends when the child does, and the program reads the
// handle again after.
var given = Result.unwrap(Os.openPipe())
println(Os.wait(Result.unwrap(Os.start("true", stdin: given.read))))
println(File.readLine(given.read, ctx: Context.new(timeout: Time.duration(milliseconds: 50))))
File.writeLine(given.write, "a")
File.writeLine(given.write, "b")
println(File.readLine(given.read))
println(Os.wait(Result.unwrap(Os.start("head", ["-n", "1"], stdin: given.read, stdout: null))))
File.writeLine(given.write, "c")
println(File.readLine(given.read, ctx: Context.new(timeout: Time.duration(seconds: 2))))

// expect
// args: $TMP
// out: before
// out: from the child
// out: Ok{ value: 3 }
// out: true
// out: Ok{ value: "a\n" }
// out: Ok{ value: "crlf" }
// out: Err{ error: Error{ message: "sh: exit status 2: broke" } }
// out: Err{ error: Error{ message: "sh: exit status 4" } }
// out: Ok{ value: "fed" }
// out: true
// out: null
// out: 3
// out: Ok{ value: 0 }
// out: Ok{ value: 0 }
// out: Ok{ value: "fix a\nfix b\n" }
// out: Ok{ value: 0 }
// out: Ok{ value: 0 }
// out: Ok{ value: 0 }
// out: Ok{ value: "header" }
// out: Ok{ value: 0 }
// out: Ok{ value: "body\n" }
// out: Ok{ value: 0 }
// out: true
// out: Err{ error: Error{ message: "unknown signal SIGNOPE" } }
// out: Ok{ value: 143 }
// out: Ok{ value: void }
// out: Ok{ value: 137 }
// out: Ok{ value: void }
// out: Ok{ value: 130 }
// out: Err{ error: Error{ message: "timeout" } }
// out: Err{ error: Error{ message: "timeout" } }
// out: Ok{ value: 143 }
// out: Ok{ value: 0 }
// out: Err{ error: Error{ message: "timeout" } }
// out: Ok{ value: "a" }
// out: Ok{ value: 0 }
// out: Ok{ value: "c" }
