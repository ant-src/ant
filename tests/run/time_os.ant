// spec: stdlib Time; stdlib Os
// Time.now is an instant, sleep takes milliseconds and monotonic measures them; Os.env reads a set variable and gives null for an unset one.
func main(): void {
  println(Time.epochMillis(Time.now()) > 1600000000000)
  var t0 = Time.monotonic()
  Time.sleep(Time.duration(milliseconds: 5))
  println(Time.monotonic() - t0 >= 5)
  println(Os.env("PATH") != null)
  println(Os.env("ANT_UNSET_VARIABLE_93F1") == null)
  println(Array.length(Os.args()))
}

// expect
// out: true
// out: true
// out: true
// out: true
// out: 0
