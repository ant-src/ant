// out: owner: u-1
// out: key: aGVsbG8=
// out: env:
// out:   HOME: /root
// out:   "YES": "yes"
// out:   NUM: "123"
// out: ports:
// out:   - 80
// out:   - 443
// out: config round trip: true
// out: Reading{ sensor: "s1", value: Celsius(21.5), seen: Map{ 1: Celsius(20.0), 2: Celsius(21.0) } }
// out: sensor: s1
// out: value: 21.5
// out: seen:
// out:   1: 20.0
// out:   2: 21.0
// out: reading round trip: true
// out: [Box{ value: 1, label: "box" }, Box{ value: 2, label: "two" }]
// out: Box{ value: Box{ value: ["x", "y"], label: "box" }, label: "outer" }
// out: value:
// out:   value:
// out:     - x
// out:     - "y"
// out:   label: box
// out: label: outer
// out: value: 1
// out: children:
// out:   - value: 2
// out:     children: []
// out:   - value: 3
// out:     children:
// out:       - value: 4
// out:         children: []
// out: tree round trip: true
// out: Mixed{ a: 12, b: 1.5, c: "yes", d: null, e: null }
// out: Mixed{ a: "12", b: 7.0, c: true, d: "null value", e: [1, 2] }
// out: a: 12
// out: b: 1.5
// out: c: "yes"
// out: d: null
// out: e: null
// out: mixed round trip: true
// out: - "yes"
// out: - "123"
// out: - ""
// out: - " pad"
// out: - "a: b"
// out: - "- x"
// out: - "null"
// out: - "1e3"
// out: - "#x"
// out: - "line\nbreak"
// out: - 日本
// out: - it's
// out: - 😀
// out: - "tab\there"
// out: - "{}"
// out: - ".inf"
// out: strings round trip: true
// out: Wide{ small: Level(-128), big: 18446744073709551615, f: 0.1, inf: -Infinity }
// out: small: -128
// out: big: 18446744073709551615
// out: f: 0.1
// out: "inf": -.inf
// out: wide round trip: true
// out: [[1, 2], [], [3]]
// out: - - 1
// out:   - 2
// out: - []
// out: - - 3
// out: Map{ "text": "one\n  two\n\nthree\n", "after": "x" }
// out: shapes:
// out:   - Circle:
// out:       radius: 1.0
// out:   - Rect:
// out:       width: 2.0
// out:       height: 3.0
// out: fill:
// out:   Green: {}
// out: json:
// out:   a:
// out:     - 1.0
// out:     - x
// out:     - null
// out:     - true
// out:     - {}
// out: drawing round trip: true
// out: Err{ error: Error{ message: "$.Ok (line 1): want a mapping for Ok[int], got \"1\"" } }
// out: Err{ error: "yaml: cannot encode a cyclic value" }
// out: Err{ error: Error{ message: "$ (line 1): missing field name" } }
// out: Err{ error: Error{ message: "$.limits.cpu (line 4): want float64, got \"lots\"" } }
// out: Err{ error: Error{ message: "$ (line 3): unknown field extra in Config" } }
// out: Err{ error: Error{ message: "line 2: duplicate key name" } }
// out: Err{ error: Error{ message: "$.small (line 1): \"200\" does not fit int8" } }
// out: Err{ error: Error{ message: "$.big (line 2): \"-1\" does not fit uint64" } }
// out: Err{ error: Error{ message: "line 1: want , or ] in a flow sequence" } }
// out: Err{ error: Error{ message: "line 2: unexpected indentation" } }
// out: Err{ error: Error{ message: "$.key (line 1): illegal base64 data at input byte 0" } }
// out: Err{ error: Error{ message: "$.count (line 1): want int, got a quoted string" } }
// out: Err{ error: Error{ message: "$ (line 1): cannot build the anonymous record type { a: int }" } }
// out: Err{ error: Error{ message: "$[0] (line 1): want int, got \"x\"" } }
// out: Err{ error: Error{ message: "$.shapes[0] (line 2): unknown tag Square, want one of Circle, Rect" } }
