// spec: 12 Runtime panics; 5 Loops
// panics: for-yield
// A sequence that calls yield again after it returned false panics (section 12).
func bad(yield: func(int): bool): void {
  _ = yield(1)
  _ = yield(2)
  println("not reached")
}

for v in bad {
  println(v)
  break
}

// expect
// out: 1
// exit: 1
// err: yield called after the sequence ended
