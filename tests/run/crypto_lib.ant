// spec: stdlib Crypto; stdlib Encoding
// Crypto against the known vectors: the FIPS 180-4 digests of "abc" and of nothing, RFC 2202
// and RFC 4231 HMAC cases, equal in constant time with different lengths unequal, random
// bytes of the asked length, and a version 4 UUID in its form.
func hex(bytes: Array[byte]): string { Encoding.toHex(bytes) }

func main(): void {
  var abc = String.toBytes("abc")
  print(hex(Crypto.sha256(abc)))
  print(hex(Crypto.sha512(abc)))
  print(hex(Crypto.sha1(abc)))
  print(hex(Crypto.md5(abc)))
  print(hex(Crypto.sha256(String.toBytes(""))))
  print(Array.length(Crypto.sha512(abc)))
  var key = String.toBytes("Jefe")
  var data = String.toBytes("what do ya want for nothing?")
  print(hex(Crypto.hmacSha1(key, data)))
  print(hex(Crypto.hmacSha256(key, data)))
  print(hex(Crypto.hmacSha512(key, data)))
  print(hex(Crypto.hmacSha256(Array.filled(20, byte(11)), String.toBytes("Hi There"))))
  print(Crypto.equal(Crypto.sha256(abc), Crypto.sha256(String.toBytes("abc"))))
  print(Crypto.equal(Crypto.sha256(abc), Crypto.sha1(abc)))
  print(Crypto.equal(abc, String.toBytes("abd")))
  print(Crypto.equal([], []))
  print(Array.length(Crypto.randomBytes(16)))
  print(Crypto.randomBytes(0))
  print(Crypto.randomBytes(8) == Crypto.randomBytes(8))
  var id = Crypto.uuid()
  print(String.length(id))
  print(Regex.test(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/, id))
  print(Crypto.uuid() == Crypto.uuid())
  print(Crypto.sha256(String.toBytes("abc")) | Encoding.toHex())
}

