// spec: 8 defer; 8 try; stdlib File
// The copy function of section 8: a deferred close runs when try leaves the function early with
// an Err, and in reverse order of registration when it succeeds. The explicit close of output
// reports the final flush, and the deferred close after it does nothing and is Ok.
func copy(src: string, dst: string): Result[void, Error] {
  var input = try File.open(src)
  defer { println("closing input"); File.close(input) }
  var output = try File.create(dst)
  defer { println("closing output again: ${File.close(output)}") }
  try File.pipe(input, output)
  File.close(output)
}

var dir = Os.args()[0]
println(File.write("${dir}/a.txt", "payload\n"))
println(copy("${dir}/a.txt", "${dir}/b.txt"))
println(File.read("${dir}/b.txt"))
println(copy("${dir}/missing.txt", "${dir}/c.txt") is Err)
println(File.exists("${dir}/c.txt"))
println(copy("${dir}/a.txt", "${dir}/nodir/c.txt") is Err)

// expect
// out: Ok{ value: void }
// out: closing output again: Ok{ value: void }
// out: closing input
// out: Ok{ value: void }
// out: Ok{ value: "payload\n" }
// out: true
// out: false
// out: closing input
// out: true
// args: $TMP
