// spec: 11 Synchronization; 12 Runtime panics
// panics: WaitGroup.add; library-value
// WaitGroup.add that would take the counter below zero panics (section 11).
func main(): void {
  var wg = WaitGroup.new()
  WaitGroup.add(wg, 2)
  WaitGroup.add(wg, -2)
  println("balanced")
  WaitGroup.add(wg, -1)
}

// expect
// out: balanced
// exit: 1
// err: negative
