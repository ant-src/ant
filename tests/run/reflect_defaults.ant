// spec: 11 Reflect; 4 Field defaults; 4 Type declarations
// Reflect.makeRecord evaluates a field default as a literal does: afresh on every call, in the
// scope of the declaration, for a generic record at each type argument, and for a local type.
var calls = 0
func next(): int { calls += 1; calls }
type Job = { name: string, id: int = next(), tags: Array[string] = [] }
type Bag[T] = { items: Array[T] = [] }

var jobT = Reflect.erase(type(Job))
var first = Reflect.to(Reflect.makeRecord(jobT, Map{ name: Reflect.valueOf(type(string), "a") }), type(Job))
var second = Reflect.to(Reflect.makeRecord(jobT, Map{ name: Reflect.valueOf(type(string), "b") }), type(Job))
println(first)
println(second)
println(Array.same(first.tags, second.tags))
var ints = Reflect.makeRecord(Reflect.erase(type(Bag[int])), Map{})
var strs = Reflect.makeRecord(Reflect.erase(type(Bag[string])), Map{})
println(Reflect.type(Reflect.field(ints, "items")))
println(Reflect.type(Reflect.field(strs, "items")))

func local(): Reflect.ErasedType {
  type Count = { word: string, n: int = 0 }
  Reflect.erase(type(Count))
}
println(Reflect.makeRecord(local(), Map{ word: Reflect.valueOf(type(string), "w") }))

// A given field never evaluates its default.
var given = Reflect.makeRecord(jobT, Map{ name: Reflect.valueOf(type(string), "c"), id: Reflect.valueOf(type(int), 7) })
println(given)
println(calls)

// expect
// out: Job{ name: "a", id: 1, tags: [] }
// out: Job{ name: "b", id: 2, tags: [] }
// out: false
// out: Array[int]
// out: Array[string]
// out: Reflect.Value(Count{ word: "w", n: 0 }: Count)
// out: Reflect.Value(Job{ name: "c", id: 7, tags: [] }: Job)
// out: 2
