// spec: 11 String; 12 Runtime panics
// panics: String.fromFloat; library-value
// A negative count of digits is a panic.
func main(): void {
  print(String.fromFloat(2.0, 0))
  print(String.fromFloat(2.0, -1))
}

// expect
// exit: 1
// out: 2
// err: String.fromFloat needs a count of digits of at least 0, got -1
