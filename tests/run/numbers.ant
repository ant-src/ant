// Numbers (sections 2, 5, 12): literal forms, integer division and remainder toward zero, float
// arithmetic by IEEE 754, the sized kinds, and conversions.
func main(): void {
  print(1_000_000)
  print(0xFF)
  print(0b1010)
  print(1e3)
  print(2.5e-3)
  print(7 / 2)
  print(-7 / 2)
  print(7 % 3)
  print(-7 % 3)
  print(7 % -3)
  print(7.5 % 2.0)
  print(-7.5 % 2.0)
  print(1.0 / 0.0)
  print(0.0 / 0.0 == 0.0 / 0.0)
  print(float64(7) / 2.0)
  print(int(3.0))
  print(int8(127) + int8(-127))
  print(uint8(250) + uint8(5))
  print(uint64(1) + uint64(2))
  print(float32(0.1) + float32(0.2))
  print(0.1 + 0.2 == 0.3)
  print(-(-5))
  print(3 > 2 && 2 >= 2 && 1 < 2 && 1 <= 1)
  print("abc" < "abd")
  print("Z" < "a")
  print(int16(-32768))
  print(float64(int32(-5)))
  print(uint32(4294967295))
}

// expect
// out: 1000000
// out: 255
// out: 10
// out: 1000.0
// out: 0.0025
// out: 3
// out: -3
// out: 1
// out: -1
// out: 1
// out: 1.5
// out: -1.5
// out: Infinity
// out: false
// out: 3.5
// out: 3
// out: 0
// out: 255
// out: 3
// out: 0.3
// out: false
// out: 5
// out: true
// out: true
// out: true
// out: -32768
// out: -5.0
// out: 4294967295
