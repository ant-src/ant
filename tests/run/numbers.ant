// spec: 2 Literals; 5 Operators; 12 Expressions
// Numbers (sections 2, 5, 12): literal forms, integer division and remainder toward zero, float
// arithmetic by IEEE 754, the sized kinds, and conversions.
println(1_000_000)
println(0xFF)
println(0b1010)
println(1e3)
println(2.5e-3)
println(7 / 2)
println(-7 / 2)
println(7 % 3)
println(-7 % 3)
println(7 % -3)
println(7.5 % 2.0)
println(-7.5 % 2.0)
println(1.0 / 0.0)
println(0.0 / 0.0 == 0.0 / 0.0)
println(float64(7) / 2.0)
println(int(3.0))
println(int8(127) + int8(-127))
println(uint8(250) + uint8(5))
println(uint64(1) + uint64(2))
println(float32(0.1) + float32(0.2))
println(0.1 + 0.2 == 0.3)
println(-(-5))
println(3 > 2 && 2 >= 2 && 1 < 2 && 1 <= 1)
println("abc" < "abd")
println("Z" < "a")
println(int16(-32768))
println(float64(int32(-5)))
println(uint32(4294967295))

// expect
// out: 1000000
// out: 255
// out: 10
// out: 1000.0
// out: 0.0025
// out: 3
// out: -3
// out: 1
// out: -1
// out: 1
// out: 1.5
// out: -1.5
// out: Infinity
// out: false
// out: 3.5
// out: 3
// out: 0
// out: 255
// out: 3
// out: 0.3
// out: false
// out: 5
// out: true
// out: true
// out: true
// out: -32768
// out: -5.0
