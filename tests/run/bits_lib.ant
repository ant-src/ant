// spec: 11 Math and Bits
// Bits (section 11): bitwise operations and wrapping arithmetic, each within its kind's width;
// shiftRight is arithmetic for signed kinds and logical for unsigned ones.
func main(): void {
  print(Bits.and(12, 10))
  print(Bits.or(12, 10))
  print(Bits.xor(12, 10))
  print(Bits.not(0))
  print(Bits.not(byte(0)))
  print(Bits.shiftLeft(1, 10))
  print(Bits.shiftLeft(byte(1), 7))
  print(Bits.shiftLeft(byte(255), 1))
  print(Bits.shiftRight(-16, 2))
  print(Bits.shiftRight(byte(255), 4))
  print(Bits.shiftRight(int8(-128), 7))
  print(Bits.popCount(255))
  print(Bits.popCount(byte(255)))
  print(Bits.popCount(-1))
  print(Bits.wrapAdd(Math.maxInt, 1))
  print(Bits.wrapSub(byte(0), byte(1)))
  print(Bits.wrapMul(byte(16), byte(16)))
  print(Bits.wrapAdd(int8(127), int8(1)))
}

// expect
// out: 8
// out: 14
// out: 6
// out: -1
// out: 255
// out: 1024
// out: 128
// out: 254
// out: -4
// out: 15
// out: -1
// out: 8
// out: 8
// out: 64
// out: -9223372036854775808
// out: 255
// out: 0
// out: -128
