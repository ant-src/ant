// spec: 11 Synchronization
// panics: Mutex.withLock; library-value
// The release at the end of a with form is the unlock call, so it panics when the function
// already released the lock.
let l = Mutex.new()
l.withLock({ l.unlock() })
println("unreached")

// expect
// exit: 1
// err: Mutex.withLock: the Mutex is not locked
