// spec: 11 Result and Record
// Each Result function on both cases, all stopping at the first Err or giving Ok of every
// value, and Record.same as identity against == as structure.
type P = { n: int }

func main(): void {
  var ok: Result[int, Error] = Result.ok(2)
  var err: Result[int, Error] = Result.err(Error{ message: "bad" })
  var second: Result[int, Error] = Result.err(Error{ message: "second" })
  print(Result.isOk(ok))
  print(Result.isOk(err))
  print(Result.map(ok, { x * 2 }))
  print(Result.map(err, { x * 2 }))
  print(Result.mapErr(ok, { x.message }))
  print(Result.mapErr(err, { x.message }))
  print(Result.unwrapOr(ok, 0))
  print(Result.unwrapOr(err, 0))
  print(Result.unwrap(ok))
  print(Result.all([ok, ok]))
  print(Result.all([ok, err, second]))
  var none: Array[Result[int, Error]] = []
  print(Result.all(none))
  var p = P{ n: 1 }
  var q = P{ n: 1 }
  print(Record.same(p, p))
  print(Record.same(p, q))
  print(p == q)
  var typed: Result[string, int] = Result.err(404)
  print(typed)
  print(Result.map(typed, { String.length(x) }))
}

// expect
// out: true
// out: false
// out: Ok{ value: 4 }
// out: Err{ error: Error{ message: "bad" } }
// out: Ok{ value: 2 }
// out: Err{ error: "bad" }
// out: 2
// out: 0
// out: 2
// out: Ok{ value: [2, 2] }
// out: Err{ error: Error{ message: "bad" } }
// out: Ok{ value: [] }
// out: true
// out: false
// out: true
// out: Err{ error: 404 }
// out: Err{ error: 404 }
