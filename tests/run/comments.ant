// spec: 2 Comments
// Line comments run to the end of the line, block comments to the first */ and do not nest, and
// neither is seen inside a string or a raw string.
/* a block comment
   spanning lines */
// trailing comment
var x = 1 /* inline */ + 2
println(x) // prints 3
/* block comments do not nest: /* this does not open another */
println("after the comment")
println("// not a comment")
println("/* not a comment either */")
/**/ println("empty comment")

// expect
// out: 3
// out: after the comment
// out: // not a comment
// out: /* not a comment either */
// out: empty comment
