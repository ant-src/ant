// spec: 12 Expressions; 5 Loops
// yield runs the body only on the loop's goroutine, where a return in it can leave the loop's
// function. A call from another goroutine panics there without running the body, and the sequence
// returning after it makes the loop panic, so first does not return 0 as though the sequence had
// been empty.
func elsewhere(yield: func(int): bool): void {
  var wg = WaitGroup.new()
  WaitGroup.add(wg, 1)
  go {
    defer { WaitGroup.done(wg) }
    _ = yield(1)
    println("not reached")
  }
  WaitGroup.wait(wg)
}

func first(seq: Seq[int]): int {
  for n in seq { return n }
  0
}

var r = Panic.catch({ first(elsewhere) })
if r is Err { println(r.error.message) }

// expect
// out: the sequence called yield on a goroutine other than the loop's
// err: yield called on a goroutine other than its loop's
