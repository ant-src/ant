// spec: 11 Synchronization; 12 Runtime panics
// panics: Select.wait; library-value
// A wait with no clause could never return, and two otherwise clauses have no order: both are
// a ◆ panic.
func main(): void {
  print(Select.wait([Select.otherwise({ "idle" })]))
  var none: Array[Select.Case[string]] = []
  print(Select.wait(none))
}

// expect
// exit: 1
// out: idle
// err: Select.wait needs at least one clause
