// spec: stdlib File
// Files and directories (stdlib.md): stat, mkdir with its parents, append, walk in lexical
// order with relative paths, of a directory given through a symbolic link too, rename, tempDir
// and removeAll, in a temporary directory given as the first argument.
func main(): void {
  var dir = Os.args()[0]
  println(File.mkdir(`${dir}/a/b`))
  println(File.mkdir(`${dir}/a/b`))
  println(File.write(`${dir}/a/one.txt`, "1"))
  println(File.write(`${dir}/a/b/two.txt`, "22"))
  var out = Result.unwrap(File.append(`${dir}/a/one.txt`))
  println(File.writeText(out, "11"))
  File.close(out)
  println(File.read(`${dir}/a/one.txt`))
  var info = Result.unwrap(File.stat(`${dir}/a/one.txt`))
  println(info.name)
  println(info.size)
  println(info.isDir)
  println(Time.epochMillis(info.modified) > 1700000000000)
  println(Result.unwrap(File.stat(`${dir}/a`)).isDir)
  println(File.stat(`${dir}/nope`) is Err)
  println(File.walk(`${dir}/a`))
  println(File.walk(`${dir}/a/one.txt`) is Err)
  println(File.rename(`${dir}/a/one.txt`, `${dir}/a/b/moved.txt`))
  println(File.walk(`${dir}/a`))
  var linked = Os.exec("ln", ["-s", `${dir}/a`, `${dir}/link`])
  println(File.walk(`${dir}/link`))
  var tmp = Result.unwrap(File.tempDir("ant-"))
  println(String.contains(Path.base(tmp), "ant-"))
  println(File.removeAll(tmp))
  println(File.exists(tmp))
  println(File.remove(`${dir}/a`) is Err)
  println(File.removeAll(`${dir}/a`))
  println(File.removeAll(`${dir}/a`))
  println(File.exists(`${dir}/a`))
  println(File.append(`${dir}/zz/none.txt`) is Err)
  println(File.rename(`${dir}/none`, `${dir}/other`) is Err)
}

