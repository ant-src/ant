// spec: stdlib File
// A read ended by its context keeps what it consumed: the line that arrives late is read whole
// by the next read, and readAll returns what it had together with the rest. The writer waits on
// a channel for each read to time out before it writes more, so no ordering rests on a sleep.
var l = Result.unwrap(Net.listen("127.0.0.1:0"))
var timedOut: Channel[bool] = Channel.new()
go {
  var s = Result.unwrap(Net.accept(l))
  _ = File.writeText(s, "hel")
  _ = Channel.receive(timedOut)
  _ = File.writeText(s, "lo\nsecond\nabc")
  _ = Channel.receive(timedOut)
  _ = File.writeText(s, "def")
  _ = File.close(s)
}
var c = Result.unwrap(Net.dial(Net.address(l)))
println(File.readLine(c, Context.new(Time.duration(milliseconds: 200))))
_ = Channel.send(timedOut, true)
println(File.readLine(c))
println(File.readLine(c))
println(File.readAll(c, Context.new(Time.duration(milliseconds: 200))))
_ = Channel.send(timedOut, true)
println(File.readAll(c))

// expect
// out: Err{ error: Error{ message: "timeout" } }
// out: Ok{ value: "hello" }
// out: Ok{ value: "second" }
// out: Err{ error: Error{ message: "timeout" } }
// out: Ok{ value: "abcdef" }
