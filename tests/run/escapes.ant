// spec: 2 Literals
// Every escape, \u{...} up to the last scalar value, a plain string on one line, a template over
// several lines with lambdas and record literals inside ${...}, and the literal forms of numbers.
type P = { x: int }

func main(): void {
  println("tab:\t|")
  println("quote:\" backslash:\\")
  println("backtick:\` dollar:\$")
  println("line\nbreak")
  println("a\rb" == "a" + "\r" + "b")
  println("\u{41}\u{e9}\u{1F600}")
  println(String.length("\u{1F600}\u{10FFFF}"))
  println("\u{10FFFF}" == "\u{10ffff}")
  println(`backtick: \` dollar: \$ brace: \${x}`)
  println(`doubled: ${Array.map([1, 2], { x * 2 })} point: ${P{ x: 5 }.x} nested: ${`in ${1 + 1}`}`)
  println(`multi
line template`)
  println(1_000 + 0x10 + 0b11)
  println(0xff == 255 && 0b1 == 1 && 0x1 == 1)
  println(1e3)
  println(2.5e-3)
  println(1.5e2)
  println(0.5 + 0.25)
  println(0 + 0x0F + 0b0)
  println(0e-400 == 0.0 && 5e-324 > 0.0)
  var big: int = 9_223_372_036_854_775_807
  println(big)
  println(Math.minInt)
  println(byte(255))
  println(float32(1.5))
  println(true && !false)
  var nothing: int | null = null
  println(nothing)
}

// expect
// out: tab:	|
// out: quote:" backslash:\
// out: backtick:` dollar:$
// out: line
// out: break
// out: true
// out: Aé😀
// out: 2
// out: true
// out: backtick: ` dollar: $ brace: ${x}
// out: doubled: [2, 4] point: 5 nested: in 2
// out: multi
// out: line template
// out: 1019
// out: true
// out: 1000.0
// out: 0.0025
// out: 150.0
// out: 0.75
// out: 15
// out: true
// out: 9223372036854775807
// out: -9223372036854775808
// out: 255
// out: 1.5
// out: true
// out: null
