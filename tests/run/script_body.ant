// spec: 10 Scripts; 10
//! A script's top-level var initializers and statements run in source order as one body: a
//! function reads a var declared below it once that var is bound, a var declared in a top-level
//! block is that block's own, the deferred blocks run when the body ends, and the value of the
//! last expression, an Err here, is discarded, so the program exits 0.
func report(): string { `${count} after ${steps}` }

var count = 0
defer { println("deferred last") }
defer { println(`deferred first: ${report()}`) }
var steps = 0
for n in [1, 2, 3] {
  var doubled = n * 2
  count += doubled
  steps += 1
}
println(report())
if count > 10 {
  var count = "shadowed in the block"
  println(count)
}
Err{ error: "discarded" }

// expect
// out: 12 after 3
// out: shadowed in the block
// out: deferred first: 12 after 3
// out: deferred last
