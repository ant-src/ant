// spec: stdlib Http; stdlib Net; 9 Waiting; 12 Runtime panics
// panics: Http.serve; library-value
// Http.serve on a listener taken on a free port, run on a goroutine and talked to with
// Http.request: the handler sees the method, the decoded path, the raw query, the headers and
// the body, and its response goes back as given, with its status, its headers and Content-Length
// and no Content-Type of its own, to a client that asks for no compression; a
// handler that panics answers 500 and is reported as a goroutine's panic; a status outside
// 200 to 599 panics, and the panic takes the same path; cancelling the context stops the server and
// serve returns Ok.
func handle(req: Http.Request): Http.Reply {
  if req.path == "/boom" { panic("boom") }
  if req.path == "/plain" {
    // the client adds no Accept-Encoding, and the server no Content-Type
    return Http.Reply{ status: 200, headers: Map{ "Content-Encoding": "x-test" }, body: req.headers["Accept-Encoding"] ?? "none" }
  }
  if req.path == "/bad" { return Http.Reply{ status: 999, headers: Map{}, body: "" } }
  var body = `${req.method} ${req.path} ${req.query} ${req.headers["X-Token"] ?? "-"} ${req.body}`
  Http.Reply{ status: 201, headers: Map{ "X-Served": "yes" }, body }
}

func main(): void {
  var listener = Result.unwrap(Net.listen("127.0.0.1:0"))
  var base = `http://${Net.address(listener)}`
  var stop = Context.new()
  var served: Channel[Result[void, Error]] = Channel.new(1)
  go { Channel.send(served, Http.serve(listener, handle, stop)) }
  var r = Result.unwrap(Http.request("PUT", `${base}/items/a%20b?x=1&y=2`, "payload", Map{ "X-Token": "t" }, Time.duration(seconds: 5)))
  println(r.status)
  println(r.body)
  println(r.headers["X-Served"])
  println(r.headers["Content-Length"])
  var plain = Result.unwrap(Http.get(`${base}/plain`, timeout: Time.duration(seconds: 5)))
  println(`${plain.body} ${plain.headers["Content-Type"] ?? "untyped"} ${plain.headers["Content-Encoding"] ?? "-"}`)
  var boom = Result.unwrap(Http.get(`${base}/boom`, timeout: Time.duration(seconds: 5)))
  println(boom.status)
  println(boom.body == "")
  var bad = Result.unwrap(Http.get(`${base}/bad`, timeout: Time.duration(seconds: 5)))
  println(bad.status)
  Context.cancel(stop)
  println(Channel.receive(served))
  println(Result.isOk(Http.get(`${base}/items`, timeout: Time.duration(seconds: 2))))
}

// expect
// out: 201
// out: PUT /items/a b x=1&y=2 t payload
// out: yes
// out: 32
// out: none untyped x-test
// out: 500
// out: true
// out: 500
// out: Ok{ value: void }
// out: false
// err: panic: boom
// err: Http.serve: the response status 999 is outside 200 to 599
