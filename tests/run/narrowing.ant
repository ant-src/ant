// spec: 7 Narrowing; 7
// Narrowing by a test, by the never branch of an if without else, by ?? return, by a while
// whose body has no break, and by assignment; where branches meet, a variable has the union of
// the branch types; a field path is read into a local first.
type Config = { name: string }
type Address = { city: string }
type User = { name: string, address: Address | null }

var attempts = 0

func load(): Config | null {
  attempts += 1
  if attempts < 3 { null } else { Config{ name: "loaded" } }
}

func find(id: int): User | null {
  if id <= 0 { return null }
  User{ name: `u${id}`, address: if id == 1 { Address{ city: "Paris" } } else { null } }
}

func firstName(id: int): string {
  var user = find(id)
  if user == null { return "nobody" }
  user.name
}

func cityOf(id: int): string {
  var user = find(id) ?? return "nobody"
  var address = user.address
  if address != null { address.city } else { "unknown" }
}

func main(): void {
  var c: Config | null = null
  while c == null { c = load() }
  println(c.name)
  println(attempts)
  var d: Config | null = null
  if d == null { d = Config{ name: "direct" } }
  println(d.name)
  println(firstName(1))
  println(firstName(0))
  println(cityOf(1))
  println(cityOf(2))
  println(cityOf(0))
  var v: int | string = 1
  v = "now a string"
  println(String.length(v))
  var w: int | null = 5
  if w != null { println(w + 1) } else { println("none") }
  var x: int | string | null = "s"
  if x is string || x == null { println("string or null") } else { println(x + 1) }
  if !(x is int) { println("not int") } else { println(x * 2) }
  var y: int | null = null
  var z = if y == null { 0 } else { y }
  println(z)
  var picked: int | string = if attempts > 1 { 1 } else { "one" }
  if picked is int { println(picked + 1) }
}

// expect
// out: loaded
// out: 3
// out: direct
// out: u1
// out: nobody
// out: Paris
// out: unknown
// out: nobody
// out: 12
// out: 6
// out: string or null
// out: not int
// out: 0
// out: 2
