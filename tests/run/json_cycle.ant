// spec: stdlib Json; 12 Runtime panics
// panics: Json.stringify; library-value
// Json.stringify on a cyclic value panics: a value already being written has no JSON form, unlike
// String.from, which renders it as ... (SPEC-FEEDBACK.md).
type Node = { value: int, next: Node | null }

func main(): void {
  var a = Node{ value: 1, next: null }
  print(Json.stringify(a))
  a.next = a
  print(Json.stringify(a))
}

// expect
// out: {"value":1,"next":null}
// exit: 1
// err: cyclic value
