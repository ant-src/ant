// spec: stdlib File; stdlib Net
// One goroutine reads a connection while another writes it, since a handle's reads and writes
// lock apart, and a close from a third goroutine ends a read in progress with an Err.
func serve(l: Net.Listener): void {
  var c = Result.unwrap(Net.accept(l))
  for i in [1, 2, 3] {
    var got = Result.unwrap(File.readLine(c))
    var x = File.writeLine(c, `echo ${got ?? ""}`)
  }
  File.close(c)
}

func main(): void {
  var l = Result.unwrap(Net.listen("127.0.0.1:0"))
  go { serve(l) }
  var c = Result.unwrap(Net.dial(Net.address(l)))
  var replies: Channel[string | null] = Channel.new()
  go {
    while true {
      var line = Result.unwrap(File.readLine(c))
      Channel.send(replies, line)
      if line == null { break }
    }
  }
  for word in ["a", "b", "c"] {
    var x = File.writeLine(c, word)
    println(Channel.receive(replies))
  }
  println(Channel.receive(replies))

  var l2 = Result.unwrap(Net.listen("127.0.0.1:0"))
  var done: Channel[bool] = Channel.new()
  go {
    var s = Result.unwrap(Net.accept(l2))
    Channel.receive(done)
    File.close(s)
  }
  var c2 = Result.unwrap(Net.dial(Net.address(l2)))
  var ended: Channel[bool] = Channel.new()
  go {
    var r = File.readLine(c2)
    Channel.send(ended, r is Err)
  }
  Time.sleep(Time.duration(milliseconds: 50))
  File.close(c2)
  println(`read ended: ${Channel.receive(ended) ?? false}`)
  println(File.readLine(c2))
  var sent = Channel.send(done, true)
}

// expect
// out: echo a
// out: echo b
// out: echo c
// out: null
// out: read ended: true
// out: Err{ error: Error{ message: "the file is not open for reading" } }
