// spec: 6 Closures and first-class values
// Closures (section 6): functions capture variables by reference, each loop iteration binds a
// fresh variable, and return inside a lambda returns from the lambda only.
func counter(): func(): int {
  var n = 0
  func() { n += 1; n }
}

var next = counter()
println(next())
println(next())
var other = counter()
println(other())
var fs: Array[func(): int] = []
for i in [1, 2, 3] {
  var k = i * 10
  fs = [...fs, func(): int { k + i }]
}
println(fs[0]())
println(fs[2]())
var early: func(int): int = { if x > 0 { return 1 }; 0 }
println(early(5))
println(early(-5))
var make = func(step: int): func(int): int { { x + step } }
println(make(3)(4))

// expect
// out: 1
// out: 2
// out: 1
// out: 11
// out: 33
// out: 1
// out: 0
// out: 7
