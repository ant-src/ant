// spec: 12 Runtime panics; stdlib Time
// panics: Time.addDuration; library-value
// addDuration sums exact units and days, balancing up to the larger of the largest units, and
// is a panic on years, months or weeks, whose length it cannot know.
func main(): void {
  print(Time.addDuration(Time.duration(minutes: 90), Time.duration(minutes: 30)))
  print(Time.addDuration(Time.duration(days: 1), Time.duration(hours: 25)))
  print(Time.addDuration(Time.duration(months: 1), Time.duration(hours: 1)))
}

// expect
// exit: 1
// out: PT120M
// out: P2DT1H
// err: Time.addDuration: years, months and weeks cannot be added without a starting point; add each to a date
