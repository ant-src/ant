// spec: 11 Prelude
// len counts an array's elements, a map's entries, a set's members, a string's code points and
// the values a channel buffers now; it unwraps a named primitive over string, takes a union or a
// bounded type parameter of these, and as a value takes its parameter type from the one expected.
type UserId = string

func size[T: string | Array[int]](x: T): int { len(x) }

func main(): void {
  print(len([1, 2, 3]))
  print(len(Array.filled(0, 1)))
  print(len(Map{ "a": 1, "b": 2 }))
  print(len(Set.of([1, 2, 2])))
  print(len("héllo"))
  print(len(""))
  var c: Channel[int] = Channel.new(4)
  Channel.send(c, 1)
  Channel.send(c, 2)
  print(len(c))
  print(len(UserId("u-1")))
  var u: string | Array[int] = [7]
  print(len(u))
  print(size("ab"))
  print(Array.map(["a", "bcd"], len))
  var f: func(string): int = len
  print(f("xyz"))
  var xs = [1, 2]
  print(len(xs) == Array.length(xs))
}

// expect
// out: 3
// out: 0
// out: 2
// out: 2
// out: 5
// out: 0
// out: 2
// out: 3
// out: 1
// out: 2
// out: [1, 3]
// out: 3
// out: true
