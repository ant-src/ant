// spec: 11 Regex
// The Regex namespace: compile builds the value a literal would, normalized and with its flags
// sorted, and returns Err on bad syntax or flags; a Match carries code point indices, the
// groups with null for one that took no part, and the named groups; findAll skips an empty
// match that abuts the one before; replace expands $1 and ${name} and takes a name as long as
// it can; replaceFirst touches the first match only; replaceWith inserts what f returns as
// written; split gives the pieces between matches; escape makes text match literally.
func main(): void {
  var p = Result.unwrap(Regex.compile("(\\d+)-(?<name>[a-z]+)", "i"))
  print(p)
  print(p == /(\d+)-(?<name>[a-z]+)/i)
  print(Result.unwrap(Regex.compile("a/b")) == /a\/b/)
  print(Regex.compile("a/b"))
  print(Regex.compile(""))
  print(Regex.compile("a", "si"))
  print(Regex.compile("("))
  print(Regex.compile("a", "g"))
  print(Regex.compile("a", "ii"))
  print(Regex.test(/^añ/, "añb"))
  print(Regex.test(/^b/, "añb"))
  print(Regex.find(/ñ(b)/, "añb"))
  print(Regex.find(/x/, "añb"))
  var m = Regex.find(/(?<year>\d{4})-(?<month>\d{2})/, "on 2026-10-22") ?? panic("no match")
  print(m.text)
  print(m.start)
  print(m.end)
  print(m.groups)
  print(m.named)
  print(String.slice("on 2026-10-22", m.start, m.end) == m.text)
  print(Regex.find(/(a)|(b)/, "b"))
  print(Array.map(Regex.findAll(/ñ/, "ñañaña"), { x.start }))
  print(Array.map(Regex.findAll(/a*/, "baaab"), { x.text }))
  print(Regex.findAll(/x/, "abc"))
  print(Regex.replace(/(\w+)@(\w+)/, "a@b c@d", "${2}@$1"))
  print(Regex.replace(/(?<user>\w+)@/, "a@b", "${user}!"))
  print(Regex.replace(/a/, "aaa", "$1x") == "")
  print(Regex.replace(/a/, "aaa", "${1}x"))
  print(Regex.replace(/a/, "aaa", "$$"))
  print(Regex.replace(/ñ/, "añb", "n"))
  print(Regex.replaceFirst(/a/, "aaa", "b"))
  print(Regex.replaceFirst(/(a)/, "xax", "[$1]"))
  print(Regex.replaceFirst(/z/, "aaa", "b"))
  print(Regex.replaceWith(/\d+/, "a1b22c", { `<${x.text}:${x.start}>` }))
  print(Regex.replaceWith(/a/, "aa", { "$0" }))
  print(Regex.replaceWith(/ñ/, "añbñ", { String.toUpper(x.text) + String.from(x.end) }))
  print(Regex.split(/,\s*/, "a, b,c"))
  print(Regex.split(/x/, "abc"))
  print(Regex.split(/x/, ""))
  print(Regex.split(/ñ/, "añb"))
  print(Regex.escape("a.b*c"))
  print(Regex.test(Result.unwrap(Regex.compile(Regex.escape("a.b"))), "axb"))
  print(Regex.test(Result.unwrap(Regex.compile(Regex.escape("a.b"))), "a.b"))
  print(Regex.source(/a\/b/i))
  print(Regex.flags(/a/smi))
  print(Regex.flags(/a/))
  print(Regex.source(Result.unwrap(Regex.compile(""))))
  var keyed: Map[Regex.Pattern, string] = Map{}
  keyed[Result.unwrap(Regex.compile("k"))] = "v"
  print(keyed[/k/])
}

// expect
// out: /(\d+)-(?<name>[a-z]+)/i
// out: true
// out: true
// out: Ok{ value: /a\/b/ }
// out: Ok{ value: /(?:)/ }
// out: Ok{ value: /a/is }
// out: Err{ error: Error{ message: "invalid regular expression: missing closing ): `(`" } }
// out: Err{ error: Error{ message: "there is no g flag: Regex.findAll and Regex.replace work on every match" } }
// out: Err{ error: Error{ message: "the flag i is repeated" } }
// out: true
// out: false
// out: Regex.Match{ text: "ñb", start: 1, end: 3, groups: ["ñb", "b"], named: Map{} }
// out: null
// out: 2026-10
// out: 3
// out: 10
// out: ["2026-10", "2026", "10"]
// out: Map{ "year": "2026", "month": "10" }
// out: true
// out: Regex.Match{ text: "b", start: 0, end: 1, groups: ["b", null, "b"], named: Map{} }
// out: [0, 2, 4]
// out: ["", "aaa", ""]
// out: []
// out: b@a d@c
// out: a!b
// out: true
// out: xxx
// out: $$$
// out: anb
// out: baa
// out: x[a]x
// out: aaa
// out: a<1:1>b<22:3>c
// out: $0$0
// out: aÑ2bÑ4
// out: ["a", "b", "c"]
// out: ["abc"]
// out: [""]
// out: ["a", "b"]
// out: a\.b\*c
// out: false
// out: true
// out: a/b
