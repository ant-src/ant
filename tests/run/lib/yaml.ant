//! yaml: a YAML subset into and out of declared types, as library code over Reflect.
//!
//! The subset: block mappings and sequences by indentation, flow `[a, b]` and `{a: 1}` on one
//! line, plain, single-quoted, and double-quoted scalars, literal block scalars `|`, `|-`, `|+`,
//! `#` comments, and `---` at the start. Decoding is type-directed: a scalar is read the way its
//! target type asks, so `yes` into a string is "yes" and `123` into a string is "123". A quoted
//! scalar is always a string. Unknown and duplicate keys are errors; a missing field takes its
//! default. A union tries the members whose kind fits the node first, in the order written.
//! Bytes are base64.

let BytesType = Reflect.erase(type(Bytes))
let maxUint64 = uint64(Math.maxInt) * uint64(2) + uint64(1)

// ---------------------------------------------------------------------------------------------
// The untyped tree.

type Scalar = { text: string, plain: bool, line: int }
type SeqNode = { items: Array[Node], line: int }
type MapNode = { pairs: Array[Pair], line: int }
type Pair = { key: Scalar, value: Node }
type Node = Scalar | SeqNode | MapNode

type Line = { num: int, indent: int, text: string, raw: string, blank: bool }
type Parser = { lines: Array[Line], pos: int }

func fail[T](line: int, message: string): Result[T, Error] {
  Result.err(Error{ message: "line ${line}: ${message}" })
}

func isSpace(c: string): bool { c == " " || c == "\t" }

// The text of a line before its comment, if any. A quote opens only at the start of a token, so
// the apostrophe in `don't` is a letter.
func stripComment(s: string): string {
  var cs = String.chars(s)
  var quote = ""
  var i = 0
  while i < len(cs) {
    var c = cs[i]
    var prev = if i == 0 { " " } else { cs[i - 1] }
    if quote == "\"" {
      if c == "\\" { i += 1 } else if c == "\"" { quote = "" }
    } else if quote == "'" {
      if c == "'" {
        if i + 1 < len(cs) && cs[i + 1] == "'" { i += 1 } else { quote = "" }
      }
    } else if (c == "\"" || c == "'") && (isSpace(prev) || prev == "[" || prev == "{" || prev == "," || prev == ":" || i == 0) {
      quote = c
    } else if c == "#" && (i == 0 || isSpace(prev)) {
      return String.trimEnd(String.slice(s, 0, i))
    }
    i += 1
  }
  String.trimEnd(s)
}

func splitLines(text: string): Result[Array[Line], Error] {
  var out: Array[Line] = []
  var num = 0
  for raw in String.lines(text) {
    num += 1
    var cs = String.chars(raw)
    var indent = 0
    while indent < len(cs) && cs[indent] == " " { indent += 1 }
    if indent < len(cs) && cs[indent] == "\t" && String.trim(stripComment(raw)) != "" {
      return fail(num, "tab in indentation")
    }
    var body = stripComment(String.slice(raw, indent, len(cs)))
    var blank = body == "" || (indent == 0 && (body == "---" || body == "..."))
    if indent == 0 && String.startsWith(body, "--- ") { body = String.trimStart(String.slice(body, 4, String.length(body))) }
    if indent == 0 && String.startsWith(body, "%") { blank = true }
    Array.push(out, Line{ num, indent, text: body, raw, blank })
  }
  Result.ok(out)
}

func skipBlank(p: Parser): void {
  while p.pos < len(p.lines) && p.lines[p.pos].blank { p.pos += 1 }
}

func current(p: Parser): Line | null {
  skipBlank(p)
  Array.get(p.lines, p.pos)
}

func isSeqItem(text: string): bool { text == "-" || String.startsWith(text, "- ") }

// The index of the `:` that ends a mapping key, outside quotes and flow brackets, or null.
func mapColon(text: string): int | null {
  var cs = String.chars(text)
  if len(cs) > 0 && (cs[0] == "[" || cs[0] == "{") { return null }
  var quote = ""
  var i = 0
  while i < len(cs) {
    var c = cs[i]
    if quote == "\"" {
      if c == "\\" { i += 1 } else if c == "\"" { quote = "" }
    } else if quote == "'" {
      if c == "'" { quote = "" }
    } else if (c == "\"" || c == "'") && i == 0 {
      quote = c
    } else if c == ":" && (i + 1 == len(cs) || isSpace(cs[i + 1])) {
      return i
    }
    i += 1
  }
  null
}

func nullScalar(line: int): Node { Scalar{ text: "", plain: true, line } }

func parseBlock(p: Parser, indent: int): Result[Node, Error] {
  var l = current(p) ?? return fail(0, "unexpected end")
  if isSeqItem(l.text) {
    parseSeq(p, indent)
  } else if mapColon(l.text) != null {
    parseMapping(p, indent)
  } else {
    p.pos += 1
    var n = try parseInline(l.text, l.num)
    var next = current(p)
    if next != null && next.indent > indent { return fail(next.num, "unexpected indentation") }
    Result.ok(n)
  }
}

func parseSeq(p: Parser, indent: int): Result[Node, Error] {
  var first = current(p) ?? return fail(0, "unexpected end")
  var items: Array[Node] = []
  while true {
    var l = current(p)
    if l == null || l.indent < indent { break }
    if l.indent > indent { return fail(l.num, "unexpected indentation") }
    if !isSeqItem(l.text) { break }
    var rest = String.slice(l.text, 1, String.length(l.text))
    var spaces = String.length(rest) - String.length(String.trimStart(rest))
    rest = String.trimStart(rest)
    if rest == "" {
      p.pos += 1
      var next = current(p)
      if next != null && next.indent > indent {
        Array.push(items, try parseBlock(p, next.indent))
      } else {
        Array.push(items, nullScalar(l.num))
      }
    } else {
      // `- key: value` and `- - x`: the rest of the line is a block at its own column.
      l.indent = indent + 1 + spaces
      l.text = rest
      Array.push(items, try parseBlock(p, l.indent))
    }
  }
  Result.ok(SeqNode{ items, line: first.num })
}

func parseKey(text: string, line: int): Result[Scalar, Error] {
  var n = try parseInline(text, line)
  if n is Scalar { Result.ok(n) } else { fail(line, "a key must be a scalar") }
}

func parseMapping(p: Parser, indent: int): Result[Node, Error] {
  var first = current(p) ?? return fail(0, "unexpected end")
  var pairs: Array[Pair] = []
  var seen: Set[string] = Set.of([])
  while true {
    var l = current(p)
    if l == null || l.indent < indent { break }
    if l.indent > indent { return fail(l.num, "unexpected indentation") }
    var colon = mapColon(l.text) ?? return fail(l.num, "want key: value")
    var key = try parseKey(String.trim(String.slice(l.text, 0, colon)), l.num)
    if !Set.add(seen, key.text) { return fail(l.num, "duplicate key ${key.text}") }
    var rest = String.trim(String.slice(l.text, colon + 1, String.length(l.text)))
    p.pos += 1
    var value: Node = nullScalar(l.num)
    if rest == "|" || rest == "|-" || rest == "|+" {
      value = blockScalar(p, indent, rest, l.num)
    } else if rest != "" {
      value = try parseInline(rest, l.num)
    } else {
      var next = current(p)
      if next != null && next.indent > indent {
        value = try parseBlock(p, next.indent)
      } else if next != null && next.indent == indent && isSeqItem(next.text) {
        value = try parseSeq(p, indent)
      }
    }
    Array.push(pairs, Pair{ key, value })
  }
  Result.ok(MapNode{ pairs, line: first.num })
}

// A literal block scalar: the raw lines indented deeper than the key, joined with newlines.
func blockScalar(p: Parser, indent: int, header: string, line: int): Node {
  var parts: Array[string] = []
  var col: int | null = null
  while p.pos < len(p.lines) {
    var l = p.lines[p.pos]
    if String.trim(l.raw) == "" {
      Array.push(parts, "")
      p.pos += 1
      continue
    }
    if l.indent <= indent { break }
    var c = col ?? l.indent
    col = c
    Array.push(parts, String.slice(l.raw, Math.min(c, l.indent), String.length(l.raw)))
    p.pos += 1
  }
  var trailing = 0
  while len(parts) > 0 && Array.last(parts) == "" {
    Array.pop(parts)
    trailing += 1
  }
  var text = String.join(parts, "\n")
  if header == "|" && len(parts) > 0 { text = text + "\n" }
  if header == "|+" { text = text + String.repeat("\n", trailing + if len(parts) > 0 { 1 } else { 0 }) }
  Scalar{ text, plain: false, line }
}

// ---------------------------------------------------------------------------------------------
// One line of inline syntax: flow collections and scalars.

type Cursor = { cs: Array[string], pos: int, line: int }

func peek(c: Cursor): string { Array.get(c.cs, c.pos) ?? "" }

func skipSpaces(c: Cursor): void {
  while c.pos < len(c.cs) && isSpace(c.cs[c.pos]) { c.pos += 1 }
}

func parseInline(text: string, line: int): Result[Node, Error] {
  var c = Cursor{ cs: String.chars(text), pos: 0, line }
  var n = try parseValue(c, false)
  skipSpaces(c)
  if c.pos < len(c.cs) { return fail(line, "unexpected ${String.from(peek(c))}") }
  Result.ok(n)
}

func parseValue(c: Cursor, flow: bool): Result[Node, Error] {
  skipSpaces(c)
  var ch = peek(c)
  if ch == "[" {
    c.pos += 1
    var items: Array[Node] = []
    while true {
      skipSpaces(c)
      if peek(c) == "]" { c.pos += 1; break }
      Array.push(items, try parseValue(c, true))
      skipSpaces(c)
      var sep = peek(c)
      c.pos += 1
      if sep == "]" { break }
      if sep != "," { return fail(c.line, "want , or ] in a flow sequence") }
    }
    Result.ok(SeqNode{ items, line: c.line })
  } else if ch == "{" {
    c.pos += 1
    var pairs: Array[Pair] = []
    var seen: Set[string] = Set.of([])
    while true {
      skipSpaces(c)
      if peek(c) == "}" { c.pos += 1; break }
      var key = try parseValue(c, true)
      if !(key is Scalar) { return fail(c.line, "a key must be a scalar") }
      if !Set.add(seen, key.text) { return fail(c.line, "duplicate key ${key.text}") }
      skipSpaces(c)
      var value: Node = nullScalar(c.line)
      if peek(c) == ":" {
        c.pos += 1
        skipSpaces(c)
        if peek(c) != "," && peek(c) != "}" { value = try parseValue(c, true) }
      }
      Array.push(pairs, Pair{ key, value })
      skipSpaces(c)
      var sep = peek(c)
      c.pos += 1
      if sep == "}" { break }
      if sep != "," { return fail(c.line, "want , or } in a flow mapping") }
    }
    Result.ok(MapNode{ pairs, line: c.line })
  } else if ch == "\"" {
    doubleQuoted(c)
  } else if ch == "'" {
    singleQuoted(c)
  } else {
    plain(c, flow)
  }
}

func plain(c: Cursor, flow: bool): Result[Node, Error] {
  var start = c.pos
  while c.pos < len(c.cs) {
    var ch = c.cs[c.pos]
    if flow {
      if ch == "," || ch == "]" || ch == "}" || ch == "[" || ch == "{" { break }
      if ch == ":" {
        var after = Array.get(c.cs, c.pos + 1) ?? " "
        if isSpace(after) || after == "," || after == "]" || after == "}" { break }
      }
    }
    c.pos += 1
  }
  var text = String.trim(String.concat(Array.slice(c.cs, start, c.pos)))
  if text == "" && flow { return fail(c.line, "empty value in a flow collection") }
  if String.startsWith(text, "&") || String.startsWith(text, "*") || String.startsWith(text, "!") {
    return fail(c.line, "anchors, aliases, and tags are not supported")
  }
  Result.ok(Scalar{ text, plain: true, line: c.line })
}

func singleQuoted(c: Cursor): Result[Node, Error] {
  c.pos += 1
  var parts: Array[string] = []
  while true {
    if c.pos >= len(c.cs) { return fail(c.line, "unterminated single-quoted string") }
    var ch = c.cs[c.pos]
    c.pos += 1
    if ch == "'" {
      if peek(c) == "'" { Array.push(parts, "'"); c.pos += 1 } else { break }
    } else {
      Array.push(parts, ch)
    }
  }
  Result.ok(Scalar{ text: String.concat(parts), plain: false, line: c.line })
}

func hexChar(c: Cursor, n: int): Result[string, Error] {
  if c.pos + n > len(c.cs) { return fail(c.line, "short escape") }
  var digits = String.concat(Array.slice(c.cs, c.pos, c.pos + n))
  c.pos += n
  var code = String.toInt(digits, 16) ?? return fail(c.line, "bad escape \\${digits}")
  // A JSON-style surrogate pair, a high then a low \u escape, is one character.
  if code >= 0xD800 && code < 0xDC00 && peek(c) == "\\" && Array.get(c.cs, c.pos + 1) == "u" {
    c.pos += 2
    var lowDigits = String.concat(Array.slice(c.cs, c.pos, Math.min(c.pos + 4, len(c.cs))))
    c.pos += 4
    var low = String.toInt(lowDigits, 16) ?? return fail(c.line, "bad escape \\${lowDigits}")
    code = 0x10000 + (code - 0xD800) * 0x400 + (low - 0xDC00)
  }
  var s = String.fromCodePoint(code) ?? return fail(c.line, "escape \\${digits} is not a scalar value")
  Result.ok(s)
}

func doubleQuoted(c: Cursor): Result[Node, Error] {
  c.pos += 1
  var parts: Array[string] = []
  while true {
    if c.pos >= len(c.cs) { return fail(c.line, "unterminated double-quoted string") }
    var ch = c.cs[c.pos]
    c.pos += 1
    if ch == "\"" { break }
    if ch != "\\" { Array.push(parts, ch); continue }
    var e = peek(c)
    c.pos += 1
    if e == "n" { Array.push(parts, "\n") }
    else if e == "t" { Array.push(parts, "\t") }
    else if e == "r" { Array.push(parts, "\r") }
    else if e == "0" { Array.push(parts, "\u{0}") }
    else if e == "b" { Array.push(parts, "\u{8}") }
    else if e == "f" { Array.push(parts, "\u{c}") }
    else if e == "\"" || e == "\\" || e == "/" || e == " " { Array.push(parts, e) }
    else if e == "x" { Array.push(parts, try hexChar(c, 2)) }
    else if e == "u" { Array.push(parts, try hexChar(c, 4)) }
    else if e == "U" { Array.push(parts, try hexChar(c, 8)) }
    else { return fail(c.line, "unknown escape \\${e}") }
  }
  Result.ok(Scalar{ text: String.concat(parts), plain: false, line: c.line })
}

func parseDocument(text: string): Result[Node, Error] {
  var p = Parser{ lines: try splitLines(text), pos: 0 }
  var first = current(p)
  if first == null { return Result.ok(nullScalar(1)) }
  if first.indent != 0 { return fail(first.num, "the document must start at column 0") }
  var n = try parseBlock(p, 0)
  var rest = current(p)
  if rest != null { return fail(rest.num, "unexpected content") }
  Result.ok(n)
}

// ---------------------------------------------------------------------------------------------
// Decoding: the tree read along a type.

export func decode[T](text: string, t: Reflect.Type[T]): Result[T, Error] {
  var tree = try parseDocument(text)
  var d = try decodeAt(Reflect.erase(t), tree, "$")
  Result.ok(Reflect.to(d, t))
}

func bad(n: Node, path: string, message: string): Result[Reflect.Value, Error] {
  Result.err(Error{ message: "${path} (line ${n.line}): ${message}" })
}

func describe(n: Node): string {
  if n is Scalar { if n.plain { Json.stringify(n.text) } else { "a quoted string" } }
  else if n is SeqNode { "a sequence" }
  else { "a mapping" }
}

func isNullText(s: string): bool { s == "" || s == "~" || s == "null" || s == "Null" || s == "NULL" }

func boolOf(s: string): bool | null {
  if s == "true" || s == "True" || s == "TRUE" { true }
  else if s == "false" || s == "False" || s == "FALSE" { false }
  else { null }
}

// An integer in YAML 1.2 core form: decimal with an optional sign, 0x hex, 0o octal. A value
// beyond int64 is read as uint64 when it fits there.
func intOf(s: string): int | uint64 | null {
  var neg = String.startsWith(s, "-")
  var body = if neg || String.startsWith(s, "+") { String.slice(s, 1, String.length(s)) } else { s }
  if body == "" { return null }
  var base = 10
  if String.startsWith(body, "0x") { base = 16; body = String.slice(body, 2, String.length(body)) }
  else if String.startsWith(body, "0o") { base = 8; body = String.slice(body, 2, String.length(body)) }
  if body == "" || String.startsWith(body, "+") || String.startsWith(body, "-") { return null }
  var v = String.toInt(if neg { "-" + body } else { body }, base)
  if v != null { return v }
  if neg { return null }
  // Too large for int: try uint64 digit by digit.
  var acc: uint64 = uint64(0)
  var b = uint64(base)
  for ch in body {
    var digit = String.toInt(ch, base) ?? return null
    var d = uint64(digit)
    if acc > (maxUint64 - d) / b { return null }
    acc = acc * b + d
  }
  acc
}

func floatOf(s: string): float64 | null {
  if s == ".inf" || s == ".Inf" || s == ".INF" || s == "+.inf" || s == "+.Inf" || s == "+.INF" { return Math.Infinity }
  if s == "-.inf" || s == "-.Inf" || s == "-.INF" { return -Math.Infinity }
  if s == ".nan" || s == ".NaN" || s == ".NAN" { return Math.NaN }
  // String.toFloat accepts "5." and ".5"; YAML does too.
  if String.startsWith(s, "0x") || String.startsWith(s, "0o") {
    var i = intOf(s)
    if i is int { return float64(i) }
    if i is uint64 { return float64(i) }
    return null
  }
  String.toFloat(s)
}

// What kind of value a plain or quoted scalar reads as when nothing directs it.
func naturalKind(n: Scalar): string {
  if !n.plain { "string" }
  else if isNullText(n.text) { "null" }
  else if boolOf(n.text) != null { "bool" }
  else if intOf(n.text) != null { "int" }
  else if floatOf(n.text) != null { "float" }
  else { "string" }
}

// The kind a type accepts, with named primitives seen through to their base.
func kindOf(t: Reflect.ErasedType): string {
  if t == BytesType { return "bytes" }
  var s = Reflect.shape(t)
  if s is Reflect.Tagged { kindOf(s.base) }
  else if s is Reflect.Null { "null" }
  else if s is Reflect.Bool { "bool" }
  else if s is Reflect.Int { "int" }
  else if s is Reflect.Float { "float" }
  else if s is Reflect.String { "string" }
  else if s is Reflect.Array || s is Reflect.Set { "seq" }
  else if s is Reflect.Map || s is Reflect.Record { "map" }
  else { "other" }
}

// How well a member fits a node: 0 first, then 1; 2 means it cannot take the node at all.
func fit(t: Reflect.ErasedType, n: Node): int {
  var k = kindOf(t)
  if n is SeqNode { if k == "seq" { 0 } else { 2 } }
  else if n is MapNode { if k == "map" { 0 } else { 2 } }
  else {
    var nat = naturalKind(n)
    if k == nat || (k == "bytes" && nat == "string") { 0 }
    else if k == "float" && nat == "int" { 1 }
    else if k == "string" && n.plain { 1 }
    else if k == "bytes" && n.plain { 1 }
    else { 2 }
  }
}

func decodeUnion(t: Reflect.ErasedType, members: Array[Reflect.ErasedType], n: Node, path: string): Result[Reflect.Value, Error] {
  var records = recordMembers(t)
  if n is MapNode && len(records) >= 2 {
    var names = String.join(Array.map(records, declName), ", ")
    if len(n.pairs) != 1 { return bad(n, path, "want a one-key mapping naming one of ${names}") }
    var pair = n.pairs[0]
    var m = Array.find(records, { declName(x) == pair.key.text }) ?? return bad(n, path, "unknown tag ${pair.key.text}, want one of ${names}")
    return decodeAt(m, pair.value, "${path}.${pair.key.text}")
  }
  var ranked = Array.sortBy(Array.filter(members, { fit(x, n) < 2 }), { fit(x, n) })
  if len(ranked) == 1 { return decodeAt(ranked[0], n, path) }
  for m in ranked {
    var r = decodeAt(m, n, path)
    if r is Ok { return r }
  }
  bad(n, path, "want ${t}, got ${describe(n)}")
}

func decodeAt(t: Reflect.ErasedType, n: Node, path: string): Result[Reflect.Value, Error] {
  if t == BytesType {
    if !(n is Scalar) { return bad(n, path, "want a base64 string, got ${describe(n)}") }
    var b = try (Encoding.fromBase64(n.text) | Result.wrapErr("${path} (line ${n.line})"))
    return Result.ok(Reflect.valueOf(type(Bytes), b))
  }
  var s = Reflect.shape(t)
  if s is Reflect.Union {
    decodeUnion(t, s.members, n, path)
  } else if s is Reflect.Tagged {
    Result.ok(Reflect.makeTagged(t, try decodeAt(s.base, n, path)))
  } else if s is Reflect.Null || s is Reflect.Bool || s is Reflect.Int || s is Reflect.Float || s is Reflect.String {
    decodeScalar(t, s, n, path)
  } else if s is Reflect.Array || s is Reflect.Set {
    if !(n is SeqNode) { return bad(n, path, "want a sequence for ${t}, got ${describe(n)}") }
    var elem = if s is Reflect.Array { s.element } else { s.member }
    var items: Array[Reflect.Value] = []
    for e in Array.entries(n.items) {
      Array.push(items, try decodeAt(elem, e.value, "${path}[${e.index}]"))
    }
    if s is Reflect.Array { Result.ok(Reflect.makeArray(t, items)) } else { Result.ok(Reflect.makeSet(t, items)) }
  } else if s is Reflect.Map {
    if !(n is MapNode) { return bad(n, path, "want a mapping for ${t}, got ${describe(n)}") }
    var entries: Array[Entry[Reflect.Value, Reflect.Value]] = []
    for pair in n.pairs {
      var at = "${path}.${pair.key.text}"
      var k = try decodeAt(s.key, pair.key, at)
      var v = try decodeAt(s.value, pair.value, at)
      Array.push(entries, Entry{ key: k, value: v })
    }
    Result.ok(Reflect.makeMap(t, entries))
  } else if s is Reflect.Record {
    if s.decl == null { return bad(n, path, "cannot build the anonymous record type ${t}") }
    if !(n is MapNode) { return bad(n, path, "want a mapping for ${t}, got ${describe(n)}") }
    var given: Map[string, Node] = Map{}
    for pair in n.pairs {
      if !Array.some(s.fields, { x.name == pair.key.text }) {
        return bad(pair.value, path, "unknown field ${pair.key.text} in ${t}")
      }
      given[pair.key.text] = pair.value
    }
    var fields: Map[string, Reflect.Value] = Map{}
    for f in s.fields {
      var v = given[f.name]
      if v != null {
        fields[f.name] = try decodeAt(f.type, v, "${path}.${f.name}")
      } else if !f.hasDefault {
        return bad(n, path, "missing field ${f.name}")
      }
    }
    Result.ok(Reflect.makeRecord(t, fields))
  } else {
    bad(n, path, "cannot decode ${t}")
  }
}

func decodeScalar(t: Reflect.ErasedType, s: Reflect.Shape, n: Node, path: string): Result[Reflect.Value, Error] {
  if !(n is Scalar) { return bad(n, path, "want ${t}, got ${describe(n)}") }
  var v: Reflect.Scalar = null
  if s is Reflect.String {
    v = n.text
  } else if !n.plain {
    return bad(n, path, "want ${t}, got a quoted string")
  } else if s is Reflect.Null {
    if !isNullText(n.text) { return bad(n, path, "want null, got ${describe(n)}") }
  } else if s is Reflect.Bool {
    v = boolOf(n.text) ?? return bad(n, path, "want bool, got ${describe(n)}")
  } else if s is Reflect.Int {
    var i = intOf(n.text)
    if i is int { v = i } else if i is uint64 { v = i } else { return bad(n, path, "want ${t}, got ${describe(n)}") }
  } else if s is Reflect.Float {
    v = floatOf(n.text) ?? return bad(n, path, "want ${t}, got ${describe(n)}")
  }
  var d = Reflect.makeScalar(t, v)
  if d == null { bad(n, path, "${describe(n)} does not fit ${t}") } else { Result.ok(d) }
}

// ---------------------------------------------------------------------------------------------
// Encoding: block style, two spaces per level.

export func encode[T](t: Reflect.Type[T], value: T): string {
  var d = Reflect.valueOf(t, value)
  var path: Array[Reflect.Value] = []
  var tag = unionTag(Reflect.erase(t), d)
  if tag != null {
    var lines: Array[string] = []
    entry(lines, quote(tag), d, Reflect.type(d), 0, path)
    String.join(lines, "\n") + "\n"
  } else if isInline(d) { inline(d) + "\n" } else { String.join(block(d, 0, path), "\n") + "\n" }
}

func isInline(d: Reflect.Value): bool {
  var t = Reflect.type(d)
  if t == BytesType { return true }
  var s = Reflect.shape(t)
  if s is Reflect.Array || s is Reflect.Set { len(Reflect.items(d)) == 0 }
  else if s is Reflect.Map { len(Reflect.entries(d)) == 0 }
  else if s is Reflect.Record { len(s.fields) == 0 }
  else { true }
}

func inline(d: Reflect.Value): string {
  var t = Reflect.type(d)
  if t == BytesType { return quote(Encoding.toBase64(Reflect.to(d, type(Bytes)))) }
  var s = Reflect.shape(t)
  if s is Reflect.Tagged { return inline(Reflect.payload(d)) }
  if s is Reflect.Array || s is Reflect.Set { return "[]" }
  if s is Reflect.Map || s is Reflect.Record { return "{}" }
  if s is Reflect.Null || s is Reflect.Bool || s is Reflect.Int || s is Reflect.Float || s is Reflect.String || s is Reflect.Void {
    var v = Reflect.scalar(d)
    if v is string { return quote(v) }
    if v is float64 { return floatText(v) }
    if v is float32 { return if Math.isFinite(float64(v)) { String.from(v) } else { floatText(float64(v)) } }
    return String.from(v)
  }
  panic("yaml: cannot encode ${t}")
}

func floatText(f: float64): string {
  if Math.isNaN(f) { ".nan" }
  else if f == Math.Infinity { ".inf" }
  else if f == -Math.Infinity { "-.inf" }
  else { String.from(f) }
}

// A string as a plain scalar when it reads back as that string in any context, else
// double-quoted with JSON's escapes, which YAML reads.
func quote(s: string): string {
  if needsQuotes(s) { Json.stringify(s) } else { s }
}

func needsQuotes(s: string): bool {
  if s == "" || s != String.trim(s) { return true }
  var lower = String.toLower(s)
  if isNullText(s) || lower == "null" || boolOf(s) != null { return true }
  if lower == "yes" || lower == "no" || lower == "on" || lower == "off" || lower == "y" || lower == "n" || lower == "true" || lower == "false" { return true }
  if intOf(s) != null || floatOf(s) != null || String.toLower(s) == ".inf" || lower == "-.inf" || lower == ".nan" { return true }
  var first = String.slice(s, 0, 1)
  if String.contains("-?:,[]{}#&*!|>'\"%@`", first) { return true }
  if String.contains(s, ": ") || String.contains(s, " #") || String.endsWith(s, ":") { return true }
  for c in s {
    if !String.isPrint(c) { return true }
  }
  false
}

func keyText(d: Reflect.Value): string {
  var s = Reflect.shape(Reflect.type(d))
  if s is Reflect.Array || s is Reflect.Set || s is Reflect.Map || s is Reflect.Record {
    panic("yaml: cannot encode a key of type ${Reflect.type(d)}")
  }
  inline(d)
}

// The named record members of a union type, or [] when t is not a union.
func recordMembers(t: Reflect.ErasedType): Array[Reflect.ErasedType] {
  var s = Reflect.shape(t)
  if !(s is Reflect.Union) { return [] }
  Array.filter(s.members, func(m: Reflect.ErasedType): bool {
    var ms = Reflect.shape(m)
    ms is Reflect.Record && ms.decl != null
  })
}

func declName(t: Reflect.ErasedType): string {
  var s = Reflect.shape(t)
  if s is Reflect.Record && s.decl != null { String.from(s.decl) } else { String.from(t) }
}

// The tag to write around a record whose slot is a union of several record types, since the
// fields alone may not tell the members apart. The reader resolved the union, so the slot type
// comes from the parent's shape, not from the value.
func unionTag(slot: Reflect.ErasedType, d: Reflect.Value): string | null {
  if len(recordMembers(slot)) < 2 { return null }
  var s = Reflect.shape(Reflect.type(d))
  if s is Reflect.Record { declName(Reflect.type(d)) } else { null }
}

// Lines for a non-empty collection or record at indent. path holds the containers above, so a
// value that contains itself panics instead of looping.
func block(d: Reflect.Value, indent: int, path: Array[Reflect.Value]): Array[string] {
  if Array.some(path, { Reflect.same(x, d) }) { panic("yaml: cannot encode a cyclic value") }
  var inner = [...path, d]
  var pad = String.repeat(" ", indent)
  var out: Array[string] = []
  var s = Reflect.shape(Reflect.type(d))
  if s is Reflect.Record {
    for f in s.fields { entry(out, pad + quote(f.name), Reflect.field(d, f.name), f.type, indent, inner) }
  } else if s is Reflect.Map {
    for e in Reflect.entries(d) { entry(out, pad + keyText(e.key), e.value, s.value, indent, inner) }
  } else if s is Reflect.Array || s is Reflect.Set {
    var elem = if s is Reflect.Array { s.element } else { s.member }
    for item in Reflect.items(d) {
      var tag = unionTag(elem, item)
      if tag == null && isInline(item) {
        Array.push(out, "${pad}- ${inline(item)}")
      } else {
        // The child's first line starts at indent + 2; put the dash in its place.
        var lines = if tag != null {
          var tagged: Array[string] = []
          entry(tagged, String.repeat(" ", indent + 2) + quote(tag), item, Reflect.type(item), indent + 2, inner)
          tagged
        } else {
          block(item, indent + 2, inner)
        }
        lines[0] = pad + "- " + String.slice(lines[0], indent + 2, String.length(lines[0]))
        Array.extend(out, lines)
      }
    }
  } else {
    panic("yaml: cannot encode ${Reflect.type(d)} as a block")
  }
  out
}

func entry(out: Array[string], key: string, v: Reflect.Value, slot: Reflect.ErasedType, indent: int, path: Array[Reflect.Value]): void {
  var tag = unionTag(slot, v)
  if tag != null {
    Array.push(out, "${key}:")
    entry(out, String.repeat(" ", indent + 2) + quote(tag), v, Reflect.type(v), indent + 2, path)
  } else if isInline(v) {
    Array.push(out, "${key}: ${inline(v)}")
  } else {
    Array.push(out, "${key}:")
    Array.extend(out, block(v, indent + 2, path))
  }
}
