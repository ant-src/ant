// spec: 4 Named primitive types
// Named primitive types (section 4): construction, unwrapping, operators on one tag, map keys,
// the constructor as a function value, and distinct tags over one base.
type UserId = string
type AccountId = string
type Meters = float64
type Count = int

var id = UserId("u-1")
println(string(id))
println(id == UserId("u-1"))
println(id == UserId("u-2"))
var v: UserId | string = id
println(v is UserId)
var plain: UserId | string = "plain"
println(plain is UserId)
println(plain is string)
var w: UserId | AccountId = AccountId("a-1")
println(w is AccountId)
println(w is UserId)
var d = Meters(3.0) * Meters(2.0)
println(d)
println(Meters(1.0) < Meters(2.0))
println(float64(d) + 1.0)
var m: Map[UserId, int] = Map{}
m[UserId("k")] = 1
println(m[UserId("k")])
println(m[UserId("x")])
var f: (func(string): UserId) | string = UserId
println(f is func)
var make = UserId
println(make("z"))
var c = Count(2) + Count(3)
println(c)
println(int(c) * 2)
println(-Meters(1.5))
println(Count(7) % Count(4))

// expect
// out: u-1
// out: true
// out: false
// out: true
// out: false
// out: true
// out: true
// out: false
// out: Meters(6.0)
// out: true
// out: 7.0
// out: 1
// out: null
// out: true
// out: UserId("z")
// out: Count(5)
// out: 10
// out: Meters(-1.5)
// out: Count(3)
