// spec: stdlib Url
// Url: parse divides a reference into its parts, opaque included, with the path decoded and
// the query raw; stringify assembles them again, an IPv6 host in brackets; escape and
// unescape handle one query value; parseQuery keeps keys in order of first appearance and a
// repeated key's values together, and stringifyQuery writes the map back in its order.
func main(): void {
  var u = Result.unwrap(Url.parse("https://alice:s3cret@example.com:8443/a%20b/c?q=ant&tag=a&tag=b#top"))
  print(u)
  print(Url.stringify(u))
  print(Url.parse("mailto:alice@example.com"))
  print(Url.stringify(Result.unwrap(Url.parse("mailto:alice@example.com"))))
  print(Url.parse("/relative/path?x=1"))
  print(Url.parse("http://[::1]:80/"))
  print(Url.stringify(Result.unwrap(Url.parse("http://[::1]:80/"))))
  print(Result.isOk(Url.parse("http://exa mple.com/")))
  print(Url.parse("%zz"))
  var p = Result.unwrap(Url.parse("http://example.com/x"))
  var q = Url.Parts{ ...p, path: "/y", query: Url.stringifyQuery(Map{ "q": ["a b"] }) }
  print(Url.stringify(q))
  print(Url.escape("a b&c=d/é"))
  print(Url.unescape("a+b%26c"))
  print(Url.unescape("%zz"))
  print(Url.parseQuery("tag=a&q=ant&tag=b&empty=&flag"))
  print(Url.parseQuery(""))
  print(Result.isOk(Url.parseQuery("a=%zz")))
  var params = Result.unwrap(Url.parseQuery("tag=a&q=ant&tag=b"))
  print(Url.stringifyQuery(params))
  print(Url.stringifyQuery(Map{ "k": ["v 1", "v&2"], "z": [] }))
  var none: Map[string, Array[string]] = Map{}
  print(Url.stringifyQuery(none))
}

// expect
// out: Url.Parts{ scheme: "https", opaque: "", user: "alice:s3cret", host: "example.com", port: "8443", path: "/a b/c", query: "q=ant&tag=a&tag=b", fragment: "top" }
// out: https://alice:s3cret@example.com:8443/a%20b/c?q=ant&tag=a&tag=b#top
// out: Ok{ value: Url.Parts{ scheme: "mailto", opaque: "alice@example.com", user: "", host: "", port: "", path: "", query: "", fragment: "" } }
// out: mailto:alice@example.com
// out: Ok{ value: Url.Parts{ scheme: "", opaque: "", user: "", host: "", port: "", path: "/relative/path", query: "x=1", fragment: "" } }
// out: Ok{ value: Url.Parts{ scheme: "http", opaque: "", user: "", host: "::1", port: "80", path: "/", query: "", fragment: "" } }
// out: http://[::1]:80/
// out: false
// out: Err{ error: Error{ message: "parse \"%zz\": invalid URL escape \"%zz\"" } }
// out: http://example.com/y?q=a+b
// out: a+b%26c%3Dd%2F%C3%A9
// out: Ok{ value: "a b&c" }
// out: Err{ error: Error{ message: "invalid URL escape \"%zz\"" } }
// out: Ok{ value: Map{ "tag": ["a", "b"], "q": ["ant"], "empty": [""], "flag": [""] } }
// out: Ok{ value: Map{} }
// out: false
// out: tag=a&tag=b&q=ant
// out: k=v+1&k=v%262
// out:
