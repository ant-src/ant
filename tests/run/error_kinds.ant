// out: NotExist
// out: NotExist
// out: NotExist
// out: NotExist
// out: NotExist
// out: NotExist
// out: NotExist
// out: Ok{ value: "defaults" }
// out: Exist
// out: Exist
// out: Exist
// out: Exist
// out: Exist
// out: Exist
// out: a
// out: null
// out: null
// out: null
// out: null
// out: Err{ error: Error{ message: "timeout", kind: null } }
// out: Error.NotExist{}
// out: NotExist
// out: null
// out: Err{ error: Error{ message: "no", kind: null } }
// out: Error{ message: "open x: not found", kind: Error.NotExist{} }
// out: Error{ message: "load: open x: not found", kind: Error.NotExist{} }
// out: false
// out: true
// out: {"message":"open x: not found","kind":{}}
// out: {"message":"plain","kind":null}
