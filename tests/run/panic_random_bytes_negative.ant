// spec: stdlib Crypto; 12 Runtime panics
// panics: Crypto.randomBytes; library-value
// A negative count of random bytes is a ◆ panic, as a negative count is for Array.filled.
func main(): void {
  print(Array.length(Crypto.randomBytes(4)))
  print(Crypto.randomBytes(-1))
}

// expect
// exit: 1
// out: 4
// err: Crypto.randomBytes needs a count of at least 0, got -1
