// spec: 9 Waiting; 11 Synchronization
// panics: Channel.send
// A channel closed while a send waits ends the send with the panic of a send on a closed channel,
// and a receive after a close takes what was buffered before it answers null.
func main(): void {
  var d: Channel[int] = Channel.new(2)
  var x = Channel.send(d, 1)
  x = Channel.send(d, 2)
  Channel.close(d)
  println([Channel.receive(d), Channel.receive(d), Channel.receive(d)])
  var c: Channel[int] = Channel.new(1)
  x = Channel.send(c, 1)
  go {
    Time.sleep(Time.duration(milliseconds: 20))
    Channel.close(c)
  }
  x = Channel.send(c, 2)
  println("unreachable")
}

// expect
// exit: 1
// out: [1, 2, null]
// err: Channel.send: the channel is closed
