// spec: 4 Assignability; 4 Types as values; 11 Reflect; 9
// Section 4: assignability has no depth limit and relates recursive aliases as == compares them,
// a pair already under test counting as assignable; and one alias with two arguments is two
// members of a union.
type F = func(): F | null
type G = func(): G | int | null
type Opt[T] = T | null

func stop(): F | null { null }
var f: F = stop
var g: G = f
println(Reflect.assignable(Reflect.erase(type(F)), Reflect.erase(type(G))))
println(Reflect.assignable(Reflect.erase(type(G)), Reflect.erase(type(F))))

