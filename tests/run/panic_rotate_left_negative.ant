// spec: 11 Math and Bits; 12 Runtime panics
// panics: Bits.rotateLeft; library-value
// A negative rotation count is a ◆ panic, as it is for the shifts.
func main(): void {
  print(Bits.rotateLeft(byte(1), 1))
  print(Bits.rotateLeft(byte(1), -1))
}

// expect
// exit: 1
// out: 2
// err: Bits.rotateLeft needs a count of at least 0, got -1
