// spec: stdlib Json
// Json at its edges: escapes, numbers that are not integers, duplicate keys, nesting,
// surrounding white space, malformed text as Err, and stringify of each kind and of a round
// trip.
func main(): void {
  print(Json.parse(`"\\u00e9\\n"`))
  print(Json.parse("1e30") | Result.map({ if x is float64 { Math.toInt(x) } else { -1 } }))
  print(Json.parse("-0") | Result.map({ x == 0.0 }))
  print(Json.parse(`{"a": 1, "a": 2}`))
  print(Json.parse("[[[[1]]]]"))
  print(Json.parse("  true  "))
  print(Json.parse("nul") is Err)
  print(Json.parse("[1,]") is Err)
  print(Json.parse(`{"a": [1, {"b": null}]}`))
  print(Json.stringify(1.5))
  print(Json.stringify("é\n\"\\"))
  print(Json.stringify(Map{ b: [true, null] }))
  print(Json.stringify([1, "x"]))
  print(Json.stringify(null))
  var roundTrip = Json.parse(Json.stringify(Map{ k: [1.5, "s", null, true] }))
  print(roundTrip)
  print(Json.stringify(Json.parse("{}") | Result.unwrapOr(null)))
  print(Json.stringify(Json.parse("[]") | Result.unwrapOr(null)))
}

// expect
// out: Ok{ value: "é\n" }
// out: Ok{ value: null }
// out: Ok{ value: true }
// out: Ok{ value: Map{ "a": 2.0 } }
// out: Ok{ value: [[[[1.0]]]] }
// out: Ok{ value: true }
// out: true
// out: true
// out: Ok{ value: Map{ "a": [1.0, Map{ "b": null }] } }
// out: 1.5
// out: "é\n\"\\"
// out: {"b":[true,null]}
// out: [1,"x"]
// out: null
// out: Ok{ value: Map{ "k": [1.5, "s", null, true] } }
// out: {}
// out: []
