// spec: 11 Array
// More Array functions: first and last; insert and removeAt in the middle; flatMap;
// the index and last forms of find; countWhere; lastIndexOf; min and max with null on an empty
// array and NaN when one is in it; minBy and maxBy taking the first of equal keys; unique and
// uniqueBy keeping the first of each; chunk with a shorter last chunk; and groupBy in
// first-seen order.
type P = { name: string, age: int }

func main(): void {
  var xs = [3, 1, 2]
  var empty: Array[int] = []
  print(Array.first(xs))
  print(Array.last(xs))
  print(Array.first(empty))
  print(Array.last(empty))
  Array.insert(xs, 0, 0)
  Array.insert(xs, 4, 9)
  Array.insert(xs, 2, 7)
  print(xs)
  print(Array.removeAt(xs, 2))
  print(Array.removeAt(xs, 0))
  print(Array.removeAt(xs, 3))
  print(xs)
  print(Array.flatMap([1, 2, 3], { [x, x * 10] }))
  print(Array.flatMap(["ab", "", "c"], { String.chars(x) }))
  print(Array.findIndex([5, 6, 7], { x > 5 }))
  print(Array.findIndex([5, 6, 7], { x > 9 }))
  print(Array.findLast([5, 6, 7], { x > 5 }))
  print(Array.findLastIndex([5, 6, 7], { x > 5 }))
  print(Array.findLast([5, 6, 7], { x > 9 }))
  print(Array.findLastIndex([5, 6, 7], { x > 9 }))
  print(Array.countWhere([1, 2, 3, 4], { x % 2 == 0 }))
  print(Array.countWhere(empty, { x > 0 }))
  print(Array.lastIndexOf([1, 2, 1, 3], 1))
  print(Array.lastIndexOf([1, 2, 1, 3], 9))
  print(Array.min([3, 1, 2]))
  print(Array.max([3, 1, 2]))
  print(Array.min(["b", "a", "c"]))
  print(Array.max(["b", "a", "c"]))
  print(Array.min(empty))
  print(Array.max(empty))
  print(Array.max([1.5, 0.0 / 0.0, 2.5]))
  print(Array.min([2.5, 1.5]))
  var people = [P{ name: "ann", age: 30 }, P{ name: "bo", age: 25 }, P{ name: "cy", age: 30 }]
  print(Array.minBy(people, { x.age }))
  print(Array.maxBy(people, { x.age }))
  print(Array.minBy(empty, { x }))
  print(Array.maxBy(["bb", "a", "cc"], { String.length(x) }))
  print(Array.unique([1, 2, 1, 3, 2]))
  print(Array.unique([[1], [1], [2]]))
  print(Array.unique(empty))
  print(Array.uniqueBy(people, { x.age }))
  print(Array.chunk([1, 2, 3, 4, 5], 2))
  print(Array.chunk([1, 2, 3, 4], 2))
  print(Array.chunk(empty, 2))
  print(Array.chunk([1, 2], 5))
  print(Array.groupBy([1, 2, 3, 4, 5], { x % 2 }))
  print(Array.groupBy(people, { x.age }))
  print(Array.groupBy(["apple", "avocado", "banana"], { String.slice(x, 0, 1) }))
  print(Array.groupBy(empty, { x }))
}

// expect
// out: 3
// out: 2
// out: null
// out: null
// out: [0, 3, 7, 1, 2, 9]
// out: 7
// out: 0
// out: 9
// out: [3, 1, 2]
// out: [1, 10, 2, 20, 3, 30]
// out: ["a", "b", "c"]
// out: 1
// out: null
// out: 7
// out: 2
// out: null
// out: null
// out: 2
// out: 0
// out: 2
// out: null
// out: 1
// out: 3
// out: a
// out: c
// out: null
// out: null
// out: NaN
// out: 1.5
// out: P{ name: "bo", age: 25 }
// out: P{ name: "ann", age: 30 }
// out: null
// out: bb
// out: [1, 2, 3]
// out: [[1], [2]]
// out: []
// out: [P{ name: "ann", age: 30 }, P{ name: "bo", age: 25 }]
// out: [[1, 2], [3, 4], [5]]
// out: [[1, 2], [3, 4]]
// out: []
// out: [[1, 2]]
// out: Map{ 1: [1, 3, 5], 0: [2, 4] }
// out: Map{ 30: [P{ name: "ann", age: 30 }, P{ name: "cy", age: 30 }], 25: [P{ name: "bo", age: 25 }] }
// out: Map{ "a": ["apple", "avocado"], "b": ["banana"] }
// out: Map{}
