// spec: 11 Synchronization; 12 Runtime panics
// panics: Select.send; library-value
// A send clause chosen on a closed channel is a ◆ panic, as a send is.
func main(): void {
  var c: Chan[int] = Chan.new(1)
  print(Select.wait([Select.send(c, 1, { "sent" })]))
  Chan.close(c)
  print(Select.wait([Select.send(c, 2, { "sent" })]))
}

// expect
// exit: 1
// out: sent
// err: Select.send: the channel is closed
