// spec: 3; 12 Names and scopes
// Scopes (sections 3, 12): an inner scope shadows an outer one, a closure reads the variable it
// captured and sees later assignments, and a local function calls itself through its own name
// once its type is stated.
var top = "module"

func shadow(): void {
  println(top)
  var top = "function"
  println(top)
  if true {
    var top = "block"
    println(top)
  }
  println(top)
}

func main(): void {
  shadow()
  var n = 1
  var get = func(): int { n }
  n = 2
  println(get())
  var fact: func(int): int = func(k: int): int { if k <= 1 { 1 } else { k * fact(k - 1) } }
  println(fact(5))
  var fs = [func(): int { 10 }, func(): int { 20 }]
  println(fs[1]())
}

// expect
// out: module
// out: function
// out: block
// out: function
// out: 2
// out: 120
// out: 20
