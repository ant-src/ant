// spec: 5 Operators
// The precedence table from tightest to loosest: postfix, prefix, multiplicative, additive,
// comparison with is, equality, && then ||, ??, pipe, assignment; left associativity; string
// concatenation; arithmetic on a named primitive keeps its tag; equality is structural.
type P = { x: int, y: int }
type Meters = float64

func half(r: Result[int, Error]): Result[int, Error] { Result.ok(try r / 2 + 1) }

func main(): void {
  println(-2 * 3 + 4)
  println(2 + 3 * 4)
  println(10 - 4 - 3)
  println(2 * 3 % 4)
  println(100 / 10 / 5)
  println(1 + 2 < 4 == true)
  println(!true == false)
  var p = P{ x: 3, y: 4 }
  var xs = [5, 6]
  println(-p.x + -xs[0])
  println(!Array.isEmpty(xs))
  println(half(Result.ok(8)))
  println(true && false || true && true)
  println(false || true && false)
  var none: int | null = null
  var some: int | null = 7
  println((none ?? 0) == 0 && (some ?? 0) == 7)
  println(none ?? none ?? 3)
  println(some ?? 0 | Math.max(9))
  println(xs | Array.map({ x * 2 }) | Array.sum())
  var v = 0
  v = 1 + 2 | Math.max(10)
  println(v)
  println("ant" + "-" + "lang")
  println("ant" < "bee" && "Z" < "a" && "" <= "")
  var d = Meters(2.0) + Meters(3.0) * Meters(2.0)
  println(d)
  println(Meters(1.0) < Meters(2.0))
  println(-Meters(1.5))
  println(P{ x: 1, y: 2 } == P{ x: 1, y: 2 } && [1, [2]] == [1, [2]] && Map{ a: 1 } == Map{ a: 1 })
  println(P{ x: 1, y: 2 } != P{ x: 2, y: 1 })
  println(some == null)
  println(none == null)
  var u: int | string = 3
  println(u is int == true)
  println(7 % 3 == 1 && -7 % 3 == -1 && 7 % -3 == 1 && 7.5 % 2.0 == 1.5)
  println(7 / 2 == 3 && -7 / 2 == -3)
}

// expect
// out: -2
// out: 14
// out: 3
// out: 2
// out: 2
// out: true
// out: true
// out: -8
// out: true
// out: Ok{ value: 5 }
// out: true
// out: false
// out: true
// out: 3
// out: 9
// out: 22
// out: 10
// out: ant-lang
// out: true
// out: Meters(8.0)
// out: true
// out: Meters(-1.5)
// out: true
// out: true
// out: false
// out: true
// out: true
// out: true
// out: true
