// spec: 11 String
// Each String function at its documented edges: lengths, indices and slices count code points;
// split keeps empty pieces; trim removes Unicode white space; fromBytes and fromCodePoints give
// null on invalid input; toInt takes a sign and nothing else.
func main(): void {
  var s = "héllo wörld"
  print(String.length(s))
  print(String.slice(s, 1, 4))
  print(String.indexOf(s, "l"))
  print(String.indexOf(s, "ö"))
  print(String.indexOf(s, "zz"))
  print(String.split("a,b,,c,", ","))
  print(String.split("abc", "abc"))
  print(String.join(["x", "y"], ", "))
  print(String.join([], "-") == "")
  print(String.concat(["a", "b", "c"]))
  print(String.repeat("ab", 0) == "" && String.repeat("ab", 3) == "ababab")
  print(String.trim("\u{2003} \t x y \n\u{00A0}"))
  print(String.contains(s, "wör") && String.startsWith(s, "hé") && String.endsWith(s, "rld"))
  print(String.replace("aaa", "a", "bb"))
  print(String.toUpper("héllo") + String.toLower("ÀB"))
  print(String.chars("a😀b"))
  print(String.toBytes("é"))
  print(String.fromBytes([byte(195), byte(169)]))
  print(String.fromBytes([byte(255)]))
  print(String.toCodePoints("a😀"))
  print(String.fromCodePoints([72, 105]))
  print(String.fromCodePoints([55296]))
  print(String.fromCodePoints([1114112]))
  print(String.toInt("+5"))
  print(String.toInt("-5"))
  print(String.toInt(" 5"))
  print(String.toInt("5.0"))
  print(String.toInt(""))
  print(String.toInt("1_0"))
  print(String.toFloat("1e3"))
  print(String.toFloat("-2.5"))
  print(String.toFloat("abc"))
  print(String.toFloat("1"))
  print(String.from("x") == "x" && String.from(["x"]) == "[\"x\"]")
  print(String.isEmpty("") && !String.isEmpty(" "))
  for ch in "aé" { print(String.toCodePoints(ch)) }
}

// expect
// out: 11
// out: éll
// out: 2
// out: 7
// out: null
// out: ["a", "b", "", "c", ""]
// out: ["", ""]
// out: x, y
// out: true
// out: abc
// out: true
// out: x y
// out: true
// out: bbbbbb
// out: HÉLLOàb
// out: ["a", "😀", "b"]
// out: [195, 169]
// out: é
// out: null
// out: [97, 128512]
// out: Hi
// out: null
// out: null
// out: 5
// out: -5
// out: null
// out: null
// out: null
// out: null
// out: 1000.0
// out: -2.5
// out: null
// out: 1.0
// out: true
// out: true
// out: [97]
// out: [233]
