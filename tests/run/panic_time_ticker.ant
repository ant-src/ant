// spec: stdlib Time; 12 Runtime panics
// panics: Time.ticker
// A ticker needs a period above zero, as Go's does.
var ctx = Context.new()
var ticks = Time.ticker(Time.duration(milliseconds: 10), ctx)
println(Channel.receive(ticks) != null)
Context.cancel(ctx)
var none = Time.ticker(Time.duration())

// expect
// exit: 1
// out: true
// err: Time.ticker needs a period above zero, got PT0S
