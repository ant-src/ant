// spec: 11 Math and Bits
// More Math functions: logarithms and exp, the trigonometry in radians, hypot and
// cbrt, the NaN and finiteness tests, clamp on any Ordered type with NaN passing through,
// randomInt in its half-open range, and the float constants. The float functions follow IEEE
// 754 and never panic.
func main(): void {
  print(Math.log(Math.E))
  print(Math.log(1.0))
  print(Math.log(0.0))
  print(Math.log(-1.0))
  print(Math.log2(8.0))
  print(Math.log10(1000.0))
  print(Math.exp(0.0))
  print(Math.exp(1.0) == Math.E)
  print(Math.sin(0.0))
  print(Math.cos(0.0))
  print(Math.tan(0.0))
  print(Math.round(Math.asin(1.0) * 1000.0))
  print(Math.acos(1.0))
  print(Math.atan(0.0))
  print(Math.round(Math.atan2(1.0, 1.0) * 1000000.0))
  print(Math.round(Math.atan2(0.0, -1.0) * 1000000.0))
  print(Math.hypot(3.0, 4.0))
  print(Math.hypot(Math.maxFloat64, Math.maxFloat64) == Math.Infinity)
  print(Math.cbrt(27.0))
  print(Math.cbrt(-8.0))
  print(Math.isNaN(0.0 / 0.0))
  print(Math.isNaN(Math.NaN))
  print(Math.isNaN(1.0))
  print(Math.isFinite(1.0))
  print(Math.isFinite(1.0 / 0.0))
  print(Math.isFinite(-Math.Infinity))
  print(Math.isFinite(Math.NaN))
  print(Math.clamp(5, 1, 3))
  print(Math.clamp(-5, 1, 3))
  print(Math.clamp(2, 1, 3))
  print(Math.clamp(2, 2, 2))
  print(Math.clamp(2.5, 1.0, 2.0))
  print(Math.clamp("m", "a", "f"))
  print(Math.clamp(Math.NaN, 1.0, 2.0))
  print(Math.clamp(byte(200), byte(0), byte(100)))
  print(Math.randomInt(5, 6))
  print(Array.every(Array.range(0, 200), { var r = Math.randomInt(-2, 2); r >= -2 && r < 2 }))
  print(Math.randomInt(Math.minInt, Math.maxInt) >= Math.minInt)
  print(Math.NaN)
  print(Math.Infinity)
  print(-Math.Infinity)
  print(Math.maxFloat64)
  print(Math.maxFloat64 * 2.0)
}

// expect
// out: 1.0
// out: 0.0
// out: -Infinity
// out: NaN
// out: 3.0
// out: 3.0
// out: 1.0
// out: true
// out: 0.0
// out: 1.0
// out: 0.0
// out: 1571.0
// out: 0.0
// out: 0.0
// out: 785398.0
// out: 3141593.0
// out: 5.0
// out: true
// out: 3.0
// out: -2.0
// out: true
// out: true
// out: false
// out: true
// out: false
// out: false
// out: false
// out: 3
// out: 1
// out: 2
// out: 2
// out: 2.0
// out: f
// out: NaN
// out: 100
// out: 5
// out: true
// out: true
// out: NaN
// out: Infinity
// out: -Infinity
// out: 1.7976931348623157e+308
// out: Infinity
