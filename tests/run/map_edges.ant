// spec: 11 Map
// Each Map function at its documented edges: fromEntries keeps the first insertion's position
// and the last value, map and filter keep the source order, merge appends the keys m lacks and
// lets n win, has tells a stored null from a missing key, remove returns the removed value, and
// same is identity.
func main(): void {
  var m = Map.fromEntries([Entry{ key: "a", value: 1 }, Entry{ key: "b", value: 2 }, Entry{ key: "a", value: 3 }])
  print(m)
  print(Map.map(m, { x.value * 10 }))
  print(Map.filter(m, { x.key != "a" }))
  print(Map.merge(Map{ a: 1, b: 2 }, Map{ c: 3, a: 9 }))
  var stored: Map[string, int | null] = Map{ k: null }
  print(Map.has(stored, "k"))
  print(Map.has(stored, "z"))
  print(stored["k"] == null && stored["z"] == null)
  var r = Map{ a: 1 }
  print(Map.remove(r, "a"))
  print(Map.remove(r, "a"))
  print(Map.keys(m))
  print(Map.values(m))
  print(Map.entries(m))
  print(Map.size(m))
  print(Map.isEmpty(m))
  var none: Map[string, int] = Map{}
  print(Map.isEmpty(none))
  Map.set(m, "c", 4)
  m["d"] = 5
  print(m)
  print(Map.get(m, "c"))
  print(Map.get(m, "zz"))
  var keyed: Map[Array[int], string] = Map{}
  keyed[[1, 2]] = "pair"
  print(keyed[[1, 2]])
  print(Map.has(keyed, [1, 2]))
  print(Map.same(m, m) && !Map.same(m, Map.merge(m, none)))
  print(Map.map(Map{ x: "a" }, { `${x.key}=${x.value}` }))
}

// expect
// out: Map{ "a": 3, "b": 2 }
// out: Map{ "a": 30, "b": 20 }
// out: Map{ "b": 2 }
// out: Map{ "a": 9, "b": 2, "c": 3 }
// out: true
// out: false
// out: true
// out: 1
// out: null
// out: ["a", "b"]
// out: [3, 2]
// out: [Entry{ key: "a", value: 3 }, Entry{ key: "b", value: 2 }]
// out: 2
// out: false
// out: true
// out: Map{ "a": 3, "b": 2, "c": 4, "d": 5 }
// out: 4
// out: null
// out: pair
// out: true
// out: true
// out: Map{ "x": "x=a" }
