// spec: 11 String
// String (section 11): every function; lengths, indices, and slices count code points.
func main(): void {
  var s = "añb"
  print(String.length(s))
  print(String.isEmpty(""))
  print(String.isEmpty(s))
  print(String.slice(s, 1, 3))
  print(String.slice(s, 0, 0))
  print(String.concat(["a", "b", "c"]))
  print(String.split("a,b,,c", ","))
  print(String.split("abc", "x"))
  print(String.join(["x", "y"], "-"))
  print(String.join([], "-"))
  print(String.repeat("ab", 3))
  print(String.repeat("ab", 0))
  print(String.trim("  \t hi \n "))
  print(String.contains("hello", "ell"))
  print(String.contains("hello", "z"))
  print(String.startsWith("hello", "he"))
  print(String.endsWith("hello", "lo"))
  print(String.endsWith("hello", "he"))
  print(String.indexOf("añb", "b"))
  print(String.indexOf("añb", "z"))
  print(String.replace("a-b-c", "-", "+"))
  print(String.toUpper("añb"))
  print(String.toLower("AÑB"))
  print(String.chars(s))
  print(String.toBytes("añ"))
  print(String.fromBytes([byte(104), byte(105)]))
  print(String.fromBytes([byte(255)]))
  print(String.toCodePoints("añ"))
  print(String.fromCodePoints([104, 241]))
  print(String.fromCodePoints([55296]))
  print(String.toInt("42"))
  print(String.toInt("-7"))
  print(String.toInt("+3"))
  print(String.toInt("4.5"))
  print(String.toInt("x"))
  print(String.toInt(""))
  print(String.toInt("99999999999999999999"))
  print(String.toFloat("2.5"))
  print(String.toFloat("1e3"))
  print(String.toFloat("abc"))
  print(String.from(42))
  print(String.from([1, "a"]))
  print(String.from("plain"))
}

// expect
// out: 3
// out: true
// out: false
// out: ñb
// out:
// out: abc
// out: ["a", "b", "", "c"]
// out: ["abc"]
