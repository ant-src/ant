// spec: 11 Synchronization; 12 Runtime panics
// panics: Mutex.unlock; library-value
// Unlocking a Mutex that is not locked panics (section 11).
var m = Mutex.new()
Mutex.lock(m)
Mutex.unlock(m)
println("unlocked once")
Mutex.unlock(m)

// expect
// out: unlocked once
// exit: 1
// err: Mutex.unlock: unlock of a Mutex that is not locked
