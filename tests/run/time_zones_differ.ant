// spec: stdlib Time
// panics: library-value
// A difference in days between zoned date-times in different zones is a ◆ panic.
func main(): void {
  var a = Result.unwrap(Time.parseZoned("2024-11-03T01:00:00-04:00[America/New_York]"))
  var b = Result.unwrap(Time.parseZoned("2024-11-04T01:00:00-05:00[America/Lima]"))
  print(Time.until(a, b, Time.Hour{}))
  print(Time.until(a, b, Time.Day{}))
}

// expect
// exit: 1
// out: PT25H
// err: Time.until: America/New_York and America/Lima are different zones; a difference in days or larger needs one zone
