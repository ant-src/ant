// spec: stdlib Http; stdlib Os; stdlib File; 9 Waiting
// A context on the I/O calls: an Http request gives up with the context's reason, timeout or
// cancelled, and a context done before the call sends nothing; with both a timeout and a
// context the earlier wins; Os.exec kills its child when the context ends; a read of a regular
// file never waits, so the context is looked at only before the read.
func main(): void {
  var base = Os.args()[0]
  print(Http.get(`${base}/slow`, ctx: Context.new(Time.duration(milliseconds: 100))))
  var ctx = Context.new()
  go { Time.sleep(Time.duration(milliseconds: 50)); Context.cancel(ctx) }
  print(Http.get(`${base}/slow`, ctx: ctx))
  var early = Context.new()
  Context.cancel(early)
  print(Http.get(`${base}/hello`, ctx: early))
  print(Http.request("GET", `${base}/slow`, timeout: Time.duration(seconds: 5), ctx: Context.new(Time.duration(milliseconds: 50))))
  print(Result.isOk(Http.get(`${base}/hello`, ctx: Context.new(Time.duration(seconds: 5)))))
  var before = Time.monotonic()
  print(Os.exec("sleep", ["10"], ctx: Context.new(Time.duration(milliseconds: 100))))
  print(Time.monotonic() - before < 5000)
  print(Os.exec("sleep", ["0"], ctx: Context.new(Time.duration(seconds: 5))))
  print(Os.exec("sleep", ["0"], ctx: early))
  var dir = Result.unwrap(File.tempDir("ctx"))
  var path = Path.join([dir, "a.txt"])
  Result.unwrap(File.write(path, "one\ntwo\n"))
  var f = Result.unwrap(File.open(path))
  print(File.readLine(f, Context.new(Time.duration(seconds: 5))))
  print(File.readLine(f, early))
  print(File.readAll(f))
  File.close(f)
  var out = Result.unwrap(File.create(Path.join([dir, "b.txt"])))
  var src = Result.unwrap(File.open(path))
  print(File.pipe(src, out, early))
  print(File.pipe(src, out))
  File.close(out)
  File.close(src)
  print(File.read(Path.join([dir, "b.txt"])))
  Result.unwrap(File.removeAll(dir))
}

// expect
// args: $HTTP
// out: Err{ error: Error{ message: "timeout" } }
// out: Err{ error: Error{ message: "cancelled" } }
// out: Err{ error: Error{ message: "cancelled" } }
// out: Err{ error: Error{ message: "timeout" } }
// out: true
// out: Err{ error: Error{ message: "timeout" } }
// out: true
// out: Ok{ value: Os.Output{ status: 0, stdout: "", stderr: "" } }
// out: Err{ error: Error{ message: "cancelled" } }
// out: Ok{ value: "one" }
// out: Err{ error: Error{ message: "cancelled" } }
// out: Ok{ value: "two\n" }
// out: Err{ error: Error{ message: "cancelled" } }
// out: Ok{ value: void }
// out: Ok{ value: "one\ntwo\n" }
