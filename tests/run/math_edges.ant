// spec: 11 Math and Bits
// Math at its documented edges: round is half away from zero, floor, ceil and trunc on
// negatives, toInt is int(x) without the panic, pow, sqrt of a negative is NaN, min and max on
// strings and sized integers, abs on floats, and the constants.
func main(): void {
  print(Math.round(2.5))
  print(Math.round(-2.5))
  print(Math.round(0.49))
  print(Math.floor(-1.5))
  print(Math.ceil(-1.5))
  print(Math.trunc(-1.5))
  print(Math.trunc(1.9))
  print(Math.toInt(3.0))
  print(Math.toInt(3.5))
  print(Math.toInt(1e30))
  print(Math.toInt(0.0 / 0.0))
  print(Math.toInt(1.0 / 0.0))
  print(Math.toInt(-9223372036854775808.0))
  print(Math.pow(2.0, 10.0))
  print(Math.sqrt(16.0))
  print(Math.sqrt(-1.0))
  print(Math.min("b", "a"))
  print(Math.max(1.5, -2.0))
  print(Math.min(int8(3), int8(-3)))
  print(Math.abs(-2.5))
  print(Math.abs(int8(-127)))
  print(Math.abs(-0.0) == 0.0)
  print(Math.PI > 3.14 && Math.PI < 3.15 && Math.E > 2.71 && Math.E < 2.72)
  print(Math.minInt)
  print(Math.maxInt)
  print(Math.minInt == -Math.maxInt - 1)
}

// expect
// out: 3.0
// out: -3.0
// out: 0.0
// out: -2.0
// out: -1.0
// out: -1.0
// out: 1.0
// out: 3
// out: null
// out: null
// out: null
// out: null
// out: -9223372036854775808
// out: 1024.0
// out: 4.0
// out: NaN
// out: a
// out: 1.5
// out: -3
// out: 2.5
// out: 127
// out: true
// out: true
// out: -9223372036854775808
// out: 9223372036854775807
// out: true
