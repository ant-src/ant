// spec: 11 String; 12 Runtime panics
// panics: String.replace; library-value
// String.replace with an empty old string panics (section 11).
func main(): void {
  print(String.replace("aXbX", "X", "-"))
  print(String.replace("ab", "", "-"))
}

// expect
// out: a-b-
// exit: 1
