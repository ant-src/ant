// spec: 11 Array
// Each Array function at its documented edges: get and pop give null, ranges are half-open
// and may be empty, concat, reverse and sort return new arrays, contains and indexOf compare
// with ==, sorts are stable, sortWith puts a before b when cmp is negative, filled repeats one
// value, sum of an empty array is null, and same is identity.
type P = { n: int }
type Item = { key: int, tag: string }

func main(): void {
  var xs = [3, 1, 2]
  print(Array.get(xs, 2))
  print(Array.get(xs, 3))
  print(Array.get(xs, -1))
  var e: Array[int] = []
  print(Array.pop(e))
  print(Array.isEmpty(e))
  print(Array.slice(xs, 3, 3))
  print(Array.slice(xs, 0, 0))
  print(Array.slice(xs, 1, 3))
  var c = Array.concat(xs, [9])
  print(c)
  print(xs)
  var ps = [P{ n: 1 }, P{ n: 2 }]
  print(Array.contains(ps, P{ n: 2 }))
  print(Array.indexOf(ps, P{ n: 2 }))
  print(Array.indexOf(ps, P{ n: 3 }))
  var items = [Item{ key: 2, tag: "a" }, Item{ key: 1, tag: "b" }, Item{ key: 2, tag: "c" }]
  print(Array.map(Array.sortBy(items, { x.key }), { x.tag }))
  print(Array.map(Array.sortWith(items, func(a: Item, b: Item): int { b.key - a.key }), { x.tag }))
  print(Array.map(items, { x.tag }))
  print(Array.sort([3, 1, 2]))
  print(Array.sort(["b", "a", "B"]))
  print(Array.sort([2.5, -1.0]))
  var r = Array.reverse(xs)
  print(r)
  print(xs)
  print(Array.entries(["a", "b"]))
  print(Array.range(0, 3))
  print(Array.range(3, 3))
  print(Array.range(3, 0))
  var filled = Array.filled(2, P{ n: 0 })
  print(Record.same(filled[0], filled[1]))
  print(Array.flatten([[1], [], [2, 3]]))
  print(Array.sum(e))
  print(Array.sum([1.5, 2.5]))
  print(Array.sum([int8(1), int8(2)]))
  print(Array.some(xs, { x > 2 }))
  print(Array.every(xs, { x > 2 }))
  print(Array.find(xs, { x < 3 }))
  print(Array.find(xs, { x > 9 }))
  print(Array.reduce(xs, "", func(acc: string, n: int): string { acc + String.from(n) }))
  print(Array.filter(xs, { x % 2 == 1 }))
  print(Array.same(xs, xs) && !Array.same(xs, Array.concat(xs, e)))
  print(Array.length(Array.filled(0, 1)))
}

// expect
// out: 2
// out: null
// out: null
// out: null
// out: true
// out: []
// out: []
// out: [1, 2]
// out: [3, 1, 2, 9]
// out: [3, 1, 2]
// out: true
// out: 1
// out: null
// out: ["b", "a", "c"]
// out: ["a", "c", "b"]
// out: ["a", "b", "c"]
// out: [1, 2, 3]
// out: ["B", "a", "b"]
// out: [-1.0, 2.5]
// out: [2, 1, 3]
// out: [3, 1, 2]
// out: [Indexed{ index: 0, value: "a" }, Indexed{ index: 1, value: "b" }]
// out: [0, 1, 2]
// out: []
// out: []
// out: true
// out: [1, 2, 3]
// out: null
// out: 4.0
// out: 3
// out: true
// out: false
// out: 1
// out: null
// out: 312
// out: [3, 1]
// out: true
// out: 0
