// spec: 11 Map; 12 Values
// A map key's hash depends on a bounded prefix of its structure, so hashing terminates on a
// cyclic value and agrees with ==: a cyclic record finds itself as a key, and a second cycle of
// the same shape is the same key (section 12).
type Node = { value: int, next: Node | null }

func main(): void {
  var a = Node{ value: 1, next: null }
  a.next = a
  var b = Node{ value: 1, next: null }
  b.next = b
  var m: Map[Node, string] = Map{}
  Map.set(m, a, "a")
  print(Map.get(m, a))
  print(Map.get(m, b))
  print(a == b)
  print(Map.size(m))
}

// expect
// out: a
// out: a
// out: true
// out: 1
