// spec: 11 String; 12 Values
// String.from on cyclic values (section 11): a value already being rendered renders as ..., so
// rendering terminates; a value rendered twice side by side is not a cycle.
type Node = { value: int, next: Node | null }
type Cell = { items: Array[Cell] }
type Nest = Array[Nest]
type Dict = Map[string, Dict]
type Bag = Set[Bag]

func main(): void {
  var a = Node{ value: 1, next: null }
  a.next = a
  print(a)
  var b = Node{ value: 2, next: Node{ value: 3, next: null } }
  print(b)
  var c = Cell{ items: [] }
  Array.push(c.items, c)
  print(c)
  print([c, c])
  var n: Nest = []
  Array.push(n, n)
  print(n)
  var d: Dict = Map{}
  d["self"] = d
  print(d)
  var g: Bag = Set.of([])
  Set.add(g, g)
  print(g)
}

// expect
// out: Node{ value: 1, next: ... }
// out: Node{ value: 2, next: Node{ value: 3, next: null } }
// out: Cell{ items: [...] }
// out: [Cell{ items: [...] }, Cell{ items: [...] }]
// out: [...]
// out: Map{ "self": ... }
// out: Set.of([...])
