// spec: 7; 7 Narrowing
// Nullability (section 7): ?. on fields, indexes, and calls skips the rest of the chain; ?? and
// its short circuit; narrowing by != null.
type Address = { city: string | null }
type User = { name: string, address: Address | null }

var count = 0

func bump(): int { count += 1; 0 }

func find(users: Array[User], name: string): User | null {
  for u in users { if u.name == name { return u } }
  null
}

func main(): void {
  var users = [User{ name: "ada", address: Address{ city: "london" } }, User{ name: "bob", address: null }]
  var ada = find(users, "ada")
  println(ada?.address?.city)
  println(find(users, "bob")?.address?.city)
  println(find(users, "zed")?.name ?? "anonymous")
  var m = Map{ a: 1 }
  println(m["missing"] ?? -1)
  println(m["a"] ?? -1)
  var f: (func(int): int) | null = null
  println(f?.(3))
  var ys: Array[int] | null = null
  println(ys?.[0])
  var v: int | null = null
  println(v ?? bump())
  var w: int | null = 9
  println(w ?? bump())
  println(count)
  var u = find(users, "ada")
  if u != null { println(u.name) }
  var c = u?.address
  if c == null { println("no address") } else { println(c.city ?? "no city") }
  println(null == null)
}

// expect
// out: london
// out: null
// out: anonymous
// out: -1
// out: 1
// out: null
// out: null
// out: 0
// out: 9
// out: 1
// out: ada
// out: london
// out: true
