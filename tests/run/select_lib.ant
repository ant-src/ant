// spec: 11 Synchronization; 9 Waiting
// Select: a clause per channel, channels of different types in one wait, the result type
// fixed by an annotation; a value stays in a channel whose clause was not chosen; a closed
// channel is ready with null; an otherwise clause runs when nothing is ready; a send clause;
// a context ends the wait with null; clauses that return void.
type Num = { n: int }
type Word = { w: string }
type Closed = {}
type Sent = {}
type Nothing = {}
type Outcome = Num | Word | Closed | Sent | Nothing

func main(): void {
  var nums: Chan[int] = Chan.new(1)
  var words: Chan[string] = Chan.new(1)
  Chan.send(words, "hi")
  var clauses: Array[Select.Case[Outcome]] = [
    Select.receive(nums, { if x == null { Closed{} } else { Num{ n: x } } }),
    Select.receive(words, { if x == null { Closed{} } else { Word{ w: x } } }),
  ]
  print(Select.wait(clauses))
  Chan.send(nums, 7)
  print(Select.wait(clauses))
  var withDefault: Array[Select.Case[Outcome]] = Array.concat(clauses, [Select.otherwise({ Nothing{} })])
  print(Select.wait(withDefault))
  Chan.send(nums, 8)
  Chan.send(words, "yo")
  var first = Select.wait(clauses)
  print(Chan.length(nums) + Chan.length(words))
  print(first is Num || first is Word)
  var second = Select.wait(clauses)
  print(Chan.length(nums) + Chan.length(words))
  print(second is Num || second is Word)
  Chan.close(words)
  print(Select.wait(clauses))
  var out: Chan[int] = Chan.new(1)
  var sending: Array[Select.Case[Outcome]] = [
    Select.send(out, 42, { Sent{} }),
    Select.receive(nums, { Num{ n: x ?? -1 } }),
  ]
  print(Select.wait(sending))
  print(Chan.receive(out))
  var ctx = Context.new(Time.duration(milliseconds: 20))
  var blocked: Array[Select.Case[Outcome]] = [Select.receive(nums, { Num{ n: x ?? -1 } })]
  print(Select.wait(blocked, ctx))
  Chan.send(nums, 1)
  var last = Select.wait([Select.receive(nums, { print(`took ${x ?? 0}`) })])
}

// expect
// out: Word{ w: "hi" }
// out: Num{ n: 7 }
// out: Nothing{}
// out: 1
// out: true
// out: 0
// out: true
// out: Closed{}
// out: Sent{}
// out: 42
// out: null
// out: took 1
