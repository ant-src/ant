// spec: 11 Array; 12 Runtime panics
// panics: Array.insert; library-value
// insert takes an index from 0 up to and including the length, where it appends; beyond that
// is a panic, as is a negative index.
func main(): void {
  var xs = [1, 2]
  Array.insert(xs, 2, 3)
  print(xs)
  Array.insert(xs, 4, 5)
  print(xs)
}

// expect
// exit: 1
// out: [1, 2, 3]
// err: Array.insert: the index 4 is not within 0..3
