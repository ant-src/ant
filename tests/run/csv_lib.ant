// spec: stdlib Csv
// Csv: parse reads rows of any width with quoted fields, doubled quotes, \r\n line ends and
// a quoted field across lines, drops a blank line, and is Err on a bare or unclosed quote;
// stringify quotes what needs it and ends every row with \n; both take another separator.
func main(): void {
  var text = "name,age\n\"Doe, Jane\",42\n\"say \"\"hi\"\"\",7\r\nx\n"
  print(Csv.parse(text))
  print(Csv.parse(""))
  print(Csv.parse("a;b\n", ";"))
  print(Csv.parse("a\tb", "\t"))
  print(Csv.parse("a,\"b\nc\",d"))
  print(Csv.parse("a,b\n\nc,d\n"))
  print(Result.isOk(Csv.parse("a,\"b")))
  print(Result.isOk(Csv.parse("a,b\"c")))
  print(Csv.stringify([["name", "age"], ["Doe, Jane", "42"], ["say \"hi\"", "7"], [" lead", "a\nb"]]))
  print(Csv.stringify([["a", "b;c"]], ";"))
  var none: Array[Array[string]] = []
  print(Csv.stringify(none))
  print(Csv.stringify([["ñ", ""]]))
  print(Csv.parse(Csv.stringify([["x,y", "z"]])))
}

// expect
// out: Ok{ value: [["name", "age"], ["Doe, Jane", "42"], ["say \"hi\"", "7"], ["x"]] }
// out: Ok{ value: [] }
// out: Ok{ value: [["a", "b"]] }
// out: Ok{ value: [["a", "b"]] }
// out: Ok{ value: [["a", "b\nc", "d"]] }
// out: Ok{ value: [["a", "b"], ["c", "d"]] }
// out: false
// out: false
// out: name,age
// out: "Doe, Jane",42
// out: "say ""hi""",7
// out: " lead","a
// out: b"
// out:
// out: a;"b;c"
