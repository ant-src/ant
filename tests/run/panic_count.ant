// spec: 12 Runtime panics
// panics: count
// A count above 2^31 − 1 panics, since the runtime could not hold the result: String.repeat
// here, and the same row for padStart, padEnd, Crypto.randomBytes and Chan.new.
func main(): void {
  print(String.length(String.repeat("ab", 3)))
  print(String.length(String.repeat("ab", 2147483648)))
}

// expect
// exit: 1
// out: 6
// err: String.repeat needs a count of at most 2147483647, got 2147483648
