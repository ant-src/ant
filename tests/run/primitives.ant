// spec: 4 Primitives
// int is int64 and byte is uint8; each numeric name is a conversion function and a value; a
// conversion to an integer kind is exact and one to a float kind rounds and never panics; string
// and bool are the identity on their own kind; void is a value; parsing is String.toInt and
// String.toFloat.
func main(): void {
  var a: int64 = 1
  var b: byte = uint8(2)
  print(a + 1)
  print(b + byte(1))
  print(Array.map([72, 105], byte))
  print(String.fromBytes(Array.map([72, 105], byte)))
  print(float32(16777217))
  print(float64(9007199254740993))
  print(float32(0.1) == float32(0.1) && float64(float32(0.1)) != 0.1)
  print(int(Math.trunc(3.9)))
  print(int(Math.trunc(-3.9)))
  print(int(-0.0))
  print(int64(2.0) + int64(3))
  print(string("x") + "y")
  print(bool(true) && !bool(false))
  print(String.toInt("42"))
  print(String.toInt("4x"))
  print(String.toFloat("2.5"))
  print(String.from(1.5) + String.from(true) + String.from(null))
  var r: Result[void, Error] = Result.ok(void)
  print(r)
  var v: void = print("side effect")
  print(v)
  print(int8(-128) - int8(0))
  print(uint16(65535))
  print(int32(2147483647))
  print(uint32(0) + uint32(1))
  print(uint64(4294967295) * uint64(4294967297))
  print(int64(5) == 5)
  print(float64(1) / 3.0)
  print(float32(1) / float32(3))
  var nothing: null = null
  print(nothing == null)
}

// expect
// out: 2
// out: 3
// out: [72, 105]
// out: Hi
// out: 16777216.0
// out: 9007199254740992.0
// out: true
// out: 3
// out: -3
// out: 0
// out: 5
// out: xy
// out: true
// out: 42
// out: null
// out: 2.5
// out: 1.5truenull
// out: Ok{ value: void }
// out: side effect
// out: void
// out: -128
// out: 65535
// out: 2147483647
// out: 1
// out: 18446744073709551615
// out: true
// out: 0.3333333333333333
// out: 0.33333334
// out: true
