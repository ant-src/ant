// spec: 5 select; 9 Waiting
// select: a clause per head with its result bound, channels of different types in one wait,
// the select an expression; a value stays in a channel whose clause was not chosen; a closed
// channel is ready with null; else runs when nothing is ready; a send head; Context.wait,
// Time.sleep and WaitGroup.wait as heads; blocks that return void; the heads' operands
// evaluated once, in order, before the wait.
type Num = { n: int }
type Word = { w: string }
type Closed = {}
type Sent = {}
type Nothing = {}
type Outcome = Num | Word | Closed | Sent | Nothing

func next(nums: Channel[int], words: Channel[string]): Outcome {
  select {
    var n = Channel.receive(nums) { if n == null { Closed{} } else { Num{ n } } }
    var w = Channel.receive(words) { if w == null { Closed{} } else { Word{ w } } }
  }
}

func noting(order: Array[string], name: string, c: Channel[int]): Channel[int] {
  Array.push(order, name)
  c
}

func main(): void {
  var nums: Channel[int] = Channel.new(1)
  var words: Channel[string] = Channel.new(1)
  Channel.send(words, "hi")
  print(next(nums, words))
  Channel.send(nums, 7)
  print(next(nums, words))
  var idle: Outcome = select {
    var n = Channel.receive(nums) { Num{ n: n ?? -1 } }
    else { Nothing{} }
  }
  print(idle)
  Channel.send(nums, 8)
  Channel.send(words, "yo")
  var first = next(nums, words)
  print(Channel.length(nums) + Channel.length(words))
  print(first is Num || first is Word)
  var second = next(nums, words)
  print(Channel.length(nums) + Channel.length(words))
  print(second is Num || second is Word)
  Channel.close(words)
  print(next(nums, words))
  var out: Channel[int] = Channel.new(1)
  var sent: Outcome = select {
    var ok = Channel.send(out, 42) { Sent{} }
    var n = Channel.receive(nums) { Num{ n: n ?? -1 } }
  }
  print(sent)
  print(Channel.receive(out))
  var ctx = Context.new(Time.duration(milliseconds: 20))
  var stopped: Outcome = select {
    var n = Channel.receive(nums) { Num{ n: n ?? -1 } }
    Context.wait(ctx) { Closed{} }
  }
  print(stopped)
  var slept: Outcome = select {
    var n = Channel.receive(nums) { Num{ n: n ?? -1 } }
    Time.sleep(Time.duration(milliseconds: 20)) { Nothing{} }
  }
  print(slept)
  var wg = WaitGroup.new()
  WaitGroup.add(wg, 1)
  go {
    Time.sleep(Time.duration(milliseconds: 10))
    WaitGroup.done(wg)
  }
  var joined: Outcome = select {
    var n = Channel.receive(nums) { Num{ n: n ?? -1 } }
    WaitGroup.wait(wg) { Sent{} }
  }
  print(joined)
  Channel.send(nums, 1)
  select {
    var n = Channel.receive(nums) { print(`took ${n ?? 0}`) }
    else { print("nothing") }
  }
  var order: Array[string] = []
  select {
    var a = Channel.receive(noting(order, "a", nums)) { print(a) }
    var b = Channel.receive(noting(order, "b", nums)) { print(b) }
    else { print("nothing ready") }
  }
  print(order)
}

// expect
// out: Word{ w: "hi" }
// out: Num{ n: 7 }
// out: Nothing{}
// out: 1
// out: true
// out: 0
// out: true
// out: Closed{}
// out: Sent{}
// out: 42
// out: Closed{}
// out: Nothing{}
// out: Sent{}
// out: took 1
// out: nothing ready
// out: ["a", "b"]
