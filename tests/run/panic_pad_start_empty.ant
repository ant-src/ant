// spec: 11 String; 12 Runtime panics
// panics: String.padStart; library-value
// An empty pad is a ◆ panic: the padding could never reach the width.
func main(): void {
  print(String.padStart("7", 3, "0"))
  print(String.padStart("7", 3, ""))
}

// expect
// exit: 1
// out: 007
// err: String.padStart needs a pad that is not empty
