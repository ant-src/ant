// spec: 8 defer; 12 Deferred blocks and panics
// defer (sections 8, 12): a deferred block runs when its block exits, by falling off the end,
// return, break, or continue, in reverse order of registration, in the scope it was registered
// in; return inside a deferred block returns from the deferred block only.
func f(): int {
  var x = 1
  defer { println(`deferred sees ${x}`) }
  x = 2
  return x
}

println(f())
for i in [1, 2] {
  defer { println(`end of iteration ${i}`) }
  if i == 1 { continue }
  println(`body ${i}`)
}
if true {
  defer { println("block done") }
  println("in block")
}
println("after block")
var g = func(): int {
  defer { return }
  5
}
println(g())
var h = func(): int {
  defer { println("first registered") }
  defer { println("last registered") }
  1
}
println(h())
var n = 0
while n < 3 {
  n += 1
  defer { println(`loop ${n}`) }
  if n == 2 { break }
}
println("done")

// expect
// out: deferred sees 2
// out: 2
// out: end of iteration 1
// out: body 2
// out: end of iteration 2
// out: in block
// out: block done
// out: after block
// out: 5
// out: last registered
// out: first registered
// out: 1
// out: loop 1
// out: loop 2
// out: done
