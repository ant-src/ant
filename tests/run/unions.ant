// spec: 4 Unions; 4 Tagged unions; 4 Function types
// A field read through a union when every member declares it; an enumeration of empty records
// whose members are types of their own; a sync type in a union narrowed by testing the other
// member; a function type's return type extends to the right; parameter names in a function
// type only document.
type A = { id: int, name: string }
type B = { id: string, name: string }
type Empty = {}
type Pending = {}
type Status = Empty | Pending
type Handler = func(request: int): string

func describe(u: A | B): string { "${u.id} ${u.name}" }

func onlyEmpty(e: Empty): string { "empty" }

func maybeLock(m: Mutex | null): string {
  if m != null { Mutex.withLock(m, { "locked" }) } else { "none" }
}

func parse(s: string): int | string {
  var n = String.toInt(s)
  if n != null { n } else { s }
}

func positive(): func(int): int | null { { if x > 0 { x } else { null } } }

println(describe(A{ id: 1, name: "a" }))
println(describe(B{ id: "x", name: "b" }))
var u: A | B = B{ id: "x", name: "b" }
var id = u.id
println(id is string)
println(onlyEmpty(Empty{}))
var st: Status = Pending{}
println(st is Pending)
println(st is Empty)
println(maybeLock(Mutex.new()))
println(maybeLock(null))
println(parse("12"))
println(parse("x"))
var f = positive()
println(f(1))
println(f(-1))
var h: Handler = { "request ${x}" }
println(h(7))
var n: int | float64 = 2.5
println(n is float64)
var nested: int | string | null = null
println(nested == null)

// expect
// out: 1 a
// out: x b
// out: true
// out: empty
// out: true
// out: false
// out: locked
// out: none
// out: 12
// out: x
// out: 1
// out: null
// out: request 7
// out: true
// out: true
