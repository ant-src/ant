// spec: 12 Runtime panics; 11 Math and Bits
// panics: shift; Bits.shiftLeft
// A shift count outside the operand's width panics (section 11).
func main(): void {
  var n = 64
  print(Bits.shiftLeft(1, 63) != 0)
  print(Bits.shiftLeft(1, n))
}

// expect
// out: true
// exit: 1
// err: Bits.shiftLeft needs a count from 0 up to but excluding 64, got 64
