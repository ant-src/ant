// spec: 2 Identifiers and keywords
// Case distinguishes identifiers; _ is bound or assigned to discard a value; a keyword or a
// reserved word is a plain name after . and before : in a record type, a literal, or a record
// destructuring, and the key of Map{ null: 1 } is the string "null"; prelude names are ordinary
// identifiers whose values can be bound.
type Event = { type: string, class: int }

// A parameter named _ discards its argument and leaves the others where they are.
func third(a: int, _: int, b: int = 7): int { a * 100 + b }

var value = 1
var Value = 2
var VALUE = 3
println(value + Value + VALUE)
var _ = value
_ = value + 1
var event = Event{ type: "click", class: 3 }
println(event.type)
println(event.class)
var { type: kind, class: level } = event
println("${kind} ${level}")
var byClass = Map{ class: "a", if: "b" }
println(byClass["class"])
println(byClass["if"])
var nullKey = Map{ null: 1 }
println(Map.keys(nullKey))
println(nullKey["null"])
var maybe: Event | null = event
println(maybe?.type)
var length: func(Array[int]): int = Array.length
println(length([1, 2]))
var _private = 1
var x_1 = 2
var __ = 3
var camelCase9 = 4
println(_private + x_1 + __ + camelCase9)
println(third(1, 2))
println(third(1, 2, 3))
var ignore = func(_: int): int { 1 }
println(ignore(5))

// expect
// out: 6
// out: click
// out: 3
// out: click 3
// out: a
// out: b
// out: ["null"]
// out: 1
// out: click
// out: 2
// out: 10
// out: 107
// out: 103
// out: 1
