// spec: 11 String; 12 Runtime panics
// panics: String.count; library-value
// Counting the empty substring is a ◆ panic, as splitting on it is.
func main(): void {
  print(String.count("banana", "an"))
  print(String.count("banana", ""))
}

// expect
// exit: 1
// out: 2
// err: String.count needs a substring that is not empty
