// spec: 11 String
// String.from on arrays, maps, and records (section 11): arrays render as [1, 2], maps as
// Map{ "a": 1 } with string keys always quoted, records as Point{ x: 1.0, y: 2.0 } with the name
// of their tag and the fields in declaration order; entries are separated by ", "; an empty
// array, map, or record renders as [], Map{}, or Empty{} with nothing inside.
type Point = { x: float64, y: float64 }
type Empty = {}
type Pair = { first: Point, second: Array[int] }

println([1, 2, 3])
println([[1], [], [2, 3]])
println(Map{ a: 1, b: 2 })
println(Map{ 1: "one", 2: "two" })
var byPoint: Map[Point, string] = Map{}
byPoint[Point{ x: 0.0, y: 0.0 }] = "origin"
println(byPoint)
println(Point{ x: 1.0, y: 2.0 })
println(Point{ y: 2.0, x: 1.0 })
println(Pair{ first: Point{ x: 0.5, y: 0.0 }, second: [7] })
var empty: Array[int] = []
println(empty)
var emptyMap: Map[string, int] = Map{}
println(emptyMap)
println(Empty{})
println([Empty{}, Empty{}])

// expect
// out: [1, 2, 3]
// out: [[1], [], [2, 3]]
// out: Map{ "a": 1, "b": 2 }
// out: Map{ 1: "one", 2: "two" }
// out: Map{ Point{ x: 0.0, y: 0.0 }: "origin" }
// out: Point{ x: 1.0, y: 2.0 }
// out: Point{ x: 1.0, y: 2.0 }
// out: Pair{ first: Point{ x: 0.5, y: 0.0 }, second: [7] }
// out: []
// out: Map{}
// out: Empty{}
// out: [Empty{}, Empty{}]
