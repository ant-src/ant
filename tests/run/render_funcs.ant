// spec: 11 String
// String.from on functions, constructors, and sync objects (section 11): a function renders as
// func, a constructor as its type's name, and a sync object as its namespace name.
type UserId = string

func helper(): int { 1 }

func main(): void {
  println(helper)
  println(func(a: int): int { a })
  var double: func(int): int = { x * 2 }
  println(double)
  println(UserId)
  println([double, double])
  println(Mutex.new())
  println(RwMutex.new())
  println(WaitGroup.new())
  println(Once.new())
  println(Cond.new(Mutex.new()))
  println(Atomic.new(0))
}

// expect
// out: func
// out: func
// out: func
// out: UserId
// out: [func, func]
// out: Mutex
// out: RwMutex
// out: WaitGroup
// out: Once
// out: Cond
// out: Atomic
