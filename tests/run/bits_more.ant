// spec: 11 Math and Bits
// The Bits functions Plan 5 added: the rotations within each kind's width, by a count modulo
// the width, and the zero counts, which are the width for zero and count the two's complement
// bits of a negative value.
func main(): void {
  print(Bits.rotateLeft(byte(129), 1))
  print(Bits.rotateRight(byte(129), 1))
  print(Bits.rotateLeft(byte(1), 8))
  print(Bits.rotateLeft(byte(1), 9))
  print(Bits.rotateRight(byte(1), 9))
  print(Bits.rotateLeft(1, 63))
  print(Bits.rotateLeft(1, 64))
  print(Bits.rotateRight(1, 1))
  print(Bits.rotateLeft(int8(-128), 1))
  print(Bits.rotateRight(uint64(1), 1))
  print(Bits.rotateLeft(uint16(43981), 4))
  print(Bits.rotateLeft(0, 5))
  print(Bits.leadingZeros(byte(1)))
  print(Bits.leadingZeros(byte(0)))
  print(Bits.leadingZeros(1))
  print(Bits.leadingZeros(-1))
  print(Bits.leadingZeros(int8(-1)))
  print(Bits.leadingZeros(int8(1)))
  print(Bits.leadingZeros(uint64(0)))
  print(Bits.leadingZeros(uint32(1)))
  print(Bits.trailingZeros(byte(8)))
  print(Bits.trailingZeros(byte(0)))
  print(Bits.trailingZeros(0))
  print(Bits.trailingZeros(int16(-32768)))
  print(Bits.trailingZeros(uint32(1)))
  print(Bits.trailingZeros(-1))
}

// expect
// out: 3
// out: 192
// out: 1
// out: 2
// out: 128
// out: -9223372036854775808
// out: 1
// out: -9223372036854775808
// out: 1
// out: 9223372036854775808
// out: 48346
// out: 0
// out: 7
// out: 8
// out: 63
// out: 0
// out: 0
// out: 7
// out: 64
// out: 31
// out: 3
// out: 8
// out: 64
// out: 15
// out: 0
// out: 0
