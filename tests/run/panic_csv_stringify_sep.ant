// spec: stdlib Csv; 12 Runtime panics
// panics: Csv.stringify; library-value
// stringify applies the same separator rule as parse, before any row is written.
func main(): void {
  print(Csv.stringify([["a", "b"]], "|"))
  print(Csv.stringify([["a", "b"]], "\n"))
}

// expect
// exit: 1
// out: a|b
// out:
// err: Csv.stringify needs a separator of one character other than a quote, a line break, U+0000 or U+FFFD, got "\n"
