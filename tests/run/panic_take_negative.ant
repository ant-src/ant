// spec: 11 Iter; 12 Runtime panics
// panics: Iter.take; library-value
// Iter.take with a negative count panics (section 11).
func main(): void {
  print(Iter.toArray(Iter.take(Iter.range(0, 10), 2)))
  print(Iter.toArray(Iter.take(Iter.range(0, 10), -1)))
}

// expect
// out: [0, 1]
// exit: 1
// err: Iter.take
