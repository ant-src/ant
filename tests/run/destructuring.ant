// spec: 5 Destructuring
// Destructuring (section 5): in var and for, records and arrays, nesting, the rest, the
// write-only _, and the array destructuring assignment into any places.
type Point = { x: int, y: int }
type Line = { from: Point, to: Point }

var { x, y } = Point{ x: 1, y: 2 }
println(x + y)
var { from: { x: fx }, to: { y: ty } } = Line{ from: Point{ x: 5, y: 6 }, to: Point{ x: 7, y: 8 } }
println(fx * ty)
var [a, b, ...rest] = [1, 2, 3, 4]
println(a)
println(b)
println(rest)
var [c, _, d] = [9, 8, 7]
println(c + d)
[a, b] = [b, a]
println(`${a} ${b}`)
var [[p], [q]] = [[10], [20]]
println(p + q)
var [first] = [1, 2, 3]
println(first)
var xs = [0, 0]
[xs[0], xs[1]] = [4, 5]
println(xs)
var [...all] = [6, 7]
println(all)
var pt = Point{ x: 0, y: 0 }
[pt.x, pt.y, ...xs] = [1, 2, 3, 4]
println(pt)
println(xs)
[[pt.x], [pt.y]] = [[5], [6]]
println(pt)
for { x: px, y: py } in [Point{ x: 1, y: 1 }, Point{ x: 2, y: 3 }] { println(px * py) }
for [m, n] in [[1, 2], [3, 4]] { println(m + n) }

// expect
// out: 3
// out: 40
// out: 1
// out: 2
// out: [3, 4]
// out: 16
// out: 2 1
// out: 30
// out: 1
// out: [4, 5]
// out: [6, 7]
// out: Point{ x: 1, y: 2 }
// out: [3, 4]
// out: Point{ x: 5, y: 6 }
// out: 1
// out: 6
// out: 3
// out: 7
