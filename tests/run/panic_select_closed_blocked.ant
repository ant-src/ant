// spec: 5 select; 12 Runtime panics
// panics: select-closed
// A channel closed while a select's send clause waits ends the select with the ◆, as it ends a
// send; a receive clause on a closed channel takes what was buffered before it binds null.
func main(): void {
  var d: Chan[int] = Chan.new(1)
  var x = Chan.send(d, 7)
  Chan.close(d)
  var got: Array[int | null] = []
  for i in [1, 2] {
    select {
      var v = Chan.receive(d) { Array.push(got, v) }
    }
  }
  print(got)
  var c: Chan[int] = Chan.new(1)
  x = Chan.send(c, 1)
  go {
    Time.sleep(Time.duration(milliseconds: 20))
    Chan.close(c)
  }
  select {
    Chan.send(c, 2) { print("unreachable") }
  }
}

// expect
// exit: 1
// out: [7, null]
// err: select: a send clause was chosen on a closed channel
