// spec: 11 Synchronization; 9 Waiting
// Chan: an unbuffered channel hands a value over, a buffered one holds its capacity and a
// send beyond that gives up when its context ends; closing lets receivers drain and then get
// null; values ends at a close or when its context ends; a null value and a close conflate
// when T includes null; isClosed and length.
func main(): void {
  var c: Chan[int] = Chan.new()
  go { Chan.send(c, 1); Chan.send(c, 2); Chan.close(c) }
  print(Chan.receive(c))
  print(Chan.receive(c))
  print(Chan.receive(c))
  print(Chan.isClosed(c))
  var b: Chan[string] = Chan.new(2)
  print(Chan.send(b, "a"))
  print(Chan.send(b, "b"))
  print(Chan.length(b))
  var quick = Context.new(Time.duration(milliseconds: 20))
  print(Chan.send(b, "c", quick))
  print(Context.isDone(quick))
  Chan.close(b)
  print(Iter.toArray(Chan.values(b)))
  print(Chan.receive(b))
  var empty: Chan[int] = Chan.new()
  var bounded = Context.new(Time.duration(milliseconds: 20))
  print(Chan.receive(empty, bounded))
  print(Context.isDone(bounded))
  print(Chan.isClosed(empty))
  var vals: Chan[int] = Chan.new(3)
  Chan.send(vals, 1); Chan.send(vals, 2); Chan.send(vals, 3)
  var stop = Context.new()
  var seen: Array[int] = []
  go { Time.sleep(Time.duration(milliseconds: 20)); Context.cancel(stop) }
  for v in Chan.values(vals, stop) { Array.push(seen, v) }
  print(seen)
  print(Context.isDone(stop))
  var maybe: Chan[int | null] = Chan.new(1)
  Chan.send(maybe, null)
  print(Chan.receive(maybe))
  print(Chan.isClosed(maybe))
  var hand: Chan[string] = Chan.new()
  var wg = WaitGroup.new()
  WaitGroup.add(wg, 1)
  go {
    defer { WaitGroup.done(wg) }
    print("got " + (Chan.receive(hand) ?? "nothing"))
  }
  Chan.send(hand, "x")
  WaitGroup.wait(wg)
  print("handed")
}

// expect
// out: 1
// out: 2
// out: null
// out: true
// out: true
// out: true
// out: 2
// out: false
// out: true
// out: ["a", "b"]
// out: null
// out: null
// out: true
// out: false
// out: [1, 2, 3]
// out: true
// out: null
// out: false
// out: got x
// out: handed
