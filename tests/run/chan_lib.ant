// spec: 11 Synchronization; 9 Waiting
// Channel: an unbuffered channel hands a value over, a buffered one holds its capacity and a
// send beyond that gives up when its context ends; closing lets receivers drain and then get
// null; values ends at a close or when its context ends; a null value and a close conflate
// when T includes null; isClosed and length.
func main(): void {
  var c: Channel[int] = Channel.new()
  go { Channel.send(c, 1); Channel.send(c, 2); Channel.close(c) }
  print(Channel.receive(c))
  print(Channel.receive(c))
  print(Channel.receive(c))
  print(Channel.isClosed(c))
  var b: Channel[string] = Channel.new(2)
  print(Channel.send(b, "a"))
  print(Channel.send(b, "b"))
  print(Channel.length(b))
  var quick = Context.new(Time.duration(milliseconds: 20))
  print(Channel.send(b, "c", quick))
  print(Context.isDone(quick))
  Channel.close(b)
  print(Iter.toArray(Channel.values(b)))
  print(Channel.receive(b))
  var empty: Channel[int] = Channel.new()
  var bounded = Context.new(Time.duration(milliseconds: 20))
  print(Channel.receive(empty, bounded))
  print(Context.isDone(bounded))
  print(Channel.isClosed(empty))
  var vals: Channel[int] = Channel.new(3)
  Channel.send(vals, 1); Channel.send(vals, 2); Channel.send(vals, 3)
  var stop = Context.new()
  var seen: Array[int] = []
  go { Time.sleep(Time.duration(milliseconds: 20)); Context.cancel(stop) }
  for v in Channel.values(vals, stop) { Array.push(seen, v) }
  print(seen)
  print(Context.isDone(stop))
  var maybe: Channel[int | null] = Channel.new(1)
  Channel.send(maybe, null)
  print(Channel.receive(maybe))
  print(Channel.isClosed(maybe))
  var hand: Channel[string] = Channel.new()
  var wg = WaitGroup.new()
  WaitGroup.add(wg, 1)
  go {
    defer { WaitGroup.done(wg) }
    print("got " + (Channel.receive(hand) ?? "nothing"))
  }
  Channel.send(hand, "x")
  WaitGroup.wait(wg)
  print("handed")
}

// expect
// out: 1
// out: 2
// out: null
// out: true
// out: true
// out: true
// out: 2
// out: false
// out: true
// out: ["a", "b"]
// out: null
// out: null
// out: true
// out: false
// out: [1, 2, 3]
// out: true
// out: null
// out: false
// out: got x
// out: handed
