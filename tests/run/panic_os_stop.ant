// spec: stdlib Os; 12 Runtime panics
// panics: Os.stop
// Os.stop's grace is a span of time: zero kills at once, and years, months or weeks, which have no
// fixed length, panic.
var now = Result.unwrap(Os.start("sleep", ["30"]))
println(Os.stop(now, grace: Time.duration()))
var later = Result.unwrap(Os.start("sleep", ["30"]))
defer { Os.stop(later, grace: Time.duration()) }
Os.stop(later, grace: Time.duration(months: 1))

// expect
// exit: 1
// out: Ok{ value: 137 }
// err: Os.stop needs a duration without years, months or weeks
