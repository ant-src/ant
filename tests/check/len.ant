// spec: 11 Prelude
// len takes one positional argument that has a size: an array, a map, a set, a string, a
// channel, a named primitive over string, or a union or bounded type parameter of these. As a
// value, the expected function type's parameter must be one of them.
type Count = int
type Label = string

func bad[T](x: T): int { len(x) } // ERR: len needs an array, a map, a set, a string, or a channel, got T

func main(): void {
  print(len(3))        // ERR: len needs an array, a map, a set, a string, or a channel, got int
  print(len(Count(1))) // ERR: got Count
  print(len(Label("a")))
  var u: string | int = 1
  print(len(u))               // ERR: got string | int
  print(len())                // ERR: len takes exactly one positional argument
  print(len("a", "b"))        // ERR: len takes exactly one positional argument
  print(len(x: "a"))          // ERR: len takes exactly one positional argument
  var f: func(int): int = len // ERR: cannot use len where func(int): int is expected
  var g: func(Array[bool]): int = len
  var n: string = len("a") // ERR: cannot use int where string is expected
  print(f)
  print(g)
  print(n)
}
