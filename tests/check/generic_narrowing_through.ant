// spec: 4 Generics; 5 is; 7 Narrowing
// Sections 4, 5 and 7: a bounded T is tested as a value of its bound is, through an interface or
// an anonymous record type, and also as a member of a union; a test its bound cannot fail or
// cannot pass is an error; a member that never holds the target leaves the test to the others,
// unless it might hold one it cannot name; a target that takes type arguments, or the kind of the
// arrays, needs every type parameter of the union to hold it, with the same ones; a union bound
// admits a single type that fits one of its members; a named record joins into the anonymous
// record type it fits; and a rejected test is the only error, with none for the branch it guards.
interface Shape {
  area(s: Self): float64
}

type Circle = { radius: float64 }
type P = { foo: int }
type R = { bar: int }
type Box[T] = { value: T }
type Wrap[T] = { value: Array[T] }
type UserId = string

func Circle.area(c: Circle): float64 { 3.0 * c.radius * c.radius }

func viaInterface[T: Shape](t: T): bool { t is Circle }
func viaRecord[T: { foo: int }](t: T): bool { t is P }
func viaUnionBound[T: { foo: int } | int](t: T): bool { t is P }
func inUnion[T: string | int](t: T | null): bool { t is string }
func noField[T: { foo: int }](t: T): bool { t is R }            // ERR: R has no field foo
func nothing[T: { foo: int } | int](t: T): bool { t is string } // ERR: T is never a string
func only[T: int](t: T): bool { t is int }                      // ERR: the test is always true: T is already int
func otherMember[T: { bar: int }](x: T | P): bool { x is P }
func otherParam[T: { foo: int }, U: { bar: int }](x: T | U): bool { x is P }
func namedPrimitive[T: Shape](x: T | UserId): bool { x is UserId }
func openParam[T: { value: int }, U: {}](x: T | U): bool { x is Box } // ERR: {} does not determine the type parameter T of Box
func noMember[T: { bar: int }](x: T | UserId): bool { x is P }        // ERR: P has no field bar
func nullableShape[T: Shape | null](t: T): bool { t is Circle }
func sameArguments[T: { value: int }, U: { value: int } | null](x: T | U): int { if x is Box { x.value + 1 } else { 0 } }
func otherArguments[T: { value: int }, U: { value: string }](x: T | U): bool { x is Box }     // ERR: is cannot tell a Box[int] from a Box[string], and T holds one and U the other
func noBound[T, U: { value: int }](x: T | U): bool { x is Box }                               // ERR: is cannot tell a Box[int] from another Box, so every type parameter of T | U must hold one, and T does not
func noBox[T: { bar: int }, U: { value: int }](x: T | U): bool { x is Box }                   // ERR: every type parameter of T | U must hold one, and T does not
func boundOnParam[V, T: { value: V }, U: { value: Array[int] }](x: T | U): bool { x is Wrap } // ERR: is cannot tell a Wrap[int] from another Wrap
func sameArray[T: Array[int] | null, U: Array[int] | string](x: T | U): int { if x is Array { x[0] + 1 } else { 0 } }
func otherArray[T: Array[int] | null, U: Array[string] | null](x: T | U): bool { x is Array }       // ERR: is cannot tell an Array[int] from an Array[string]
func anyArray[T, U: Array[int] | null](x: T | U): bool { x is Array }                               // ERR: is cannot tell an Array[int] from another Array
func anyFunc[T, U: (func(int): int) | null](x: T | U): bool { x is func }                           // ERR: so every type parameter of T | U must hold one, and T does not
func onlyError[T, U: { value: int }](x: T | U): int { if x is Box { x.value + 1 } else { 0 } }      // ERR: is cannot tell a Box[int] from another Box
func onlyNever[T: { foo: int } | int](t: T): int { if t is string { String.length(t) } else { 0 } } // ERR: T is never a string

func joined(x: { foo: int } | int): { foo: int } | int {
  let y = if x is P { x } else { x }
  y
}

println(viaInterface(Circle{ radius: 1.0 }))
println(viaRecord(P{ foo: 1 }))
println(viaUnionBound(P{ foo: 1 }))
println(viaUnionBound(R{ bar: 1 })) // ERR: T would be R, which is not a member of its bound
println(inUnion("s"))
println(nullableShape(Circle{ radius: 1.0 }))
println(noField(P{ foo: 1 }) || nothing(1) || only(1))
println(joined(1))
