// spec: 4 Type declarations; 4 Unions
// Section 4: an alias may be a member of a union inside a function or record type that its own
// body reaches, and checking it ends. A generic alias that reaches itself that way, through a
// plain alias that instantiates it, is on a cycle through no record's field and is rejected once,
// at the generic alias, however deep the instantiation; the same through a record's field is fine,
// as are two plain function aliases that unfold to the same type, which are one member of a union.
type A = B[B[B[int]]]
type B[T] = (func(null): A | null | T) // ERR: type B refers to itself through A without passing through a record's field
type C = Nest[Nest[Nest[Nest[Nest[Nest[int]]]]]]
type Nest[T] = Array[C | null | T] // ERR: type Nest refers to itself through C without passing through a record's field
type F = Via[Via[Via[int]]]
type Via[T] = Fn[T] // ERR: type Via refers to itself through Fn and F without passing through a record's field
type Fn[T] = (func(null): F | null | T)
type G = Pair[Pair[int]]
type Pair[T] = (func(Pair[T], T): G | null) // ERR: type Pair refers to itself without passing through a record's field
type H = { r: Rec[Rec[Rec[int]]] | null }
type Rec[T] = { f: H | null | T }
type I = (func(null): J | null)
type J = (func(null): I | null)
type K = Call[int] | null
type Call[T] = { f: func(Call[T], T): K | null }
var k: K | Call[int] | null = null
var bad: K | Call[Call[int]] | null = null // ERR: a union may contain each discriminator at most once: Call[int] and Call[Call[int]] are both tag Call

var h = H{ r: Rec{ f: Rec{ f: Rec{ f: 1 } } } }
var ij: I | J | null = null
println(h)
println(ij)
println(k)
println(bad)
