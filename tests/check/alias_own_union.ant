// spec: 4 Type declarations; 4 Unions
// Section 4: an alias may be a member of a union inside a function or array type that its own body
// instantiates, and checking it ends. With A = B[B[B[int]]], B's union A | null | B[B[int]] holds
// two functions that are not the same type, a compile error at the use, and B's body puts a type
// parameter beside a function, an error at its declaration; the same through a deeper nesting, an
// array, a union body, and an alias between. Where the members are one type, or have distinct
// discriminators, the declarations are fine.
type A = B[B[B[int]]]                            // ERR: type A: B[B[B[int]]]: a union may contain each discriminator at most once: A and B[B[int]] are both a function
type B[T] = (func(null): A | null | T)           // ERR: type B: a type parameter may share a union only with null, void, other type parameters, and named types without type arguments, not with A
type C = Nest[Nest[Nest[Nest[Nest[Nest[int]]]]]] // ERR: C and Nest[Nest[Nest[Nest[Nest[int]]]]] are both an array
type Nest[T] = Array[C | null | T]               // ERR: type Nest: a type parameter may share a union only with null, void, other type parameters, and named types without type arguments, not with C
type E = Wrap[Wrap[Wrap[int]]] | null            // ERR: Wrap[Wrap[Wrap[int]]] and Wrap[Wrap[int]] are both a function
type Wrap[T] = (func(null): E | T)               // ERR: type Wrap: a type parameter may share
type F = Via[Via[Via[int]]]                      // ERR: in Fn[Via[Via[int]]]: a union may contain each discriminator at most once: F and Via[Via[int]] are both a function
type Via[T] = Fn[T]                              // ERR: type Via: Fn[T]: a type parameter may share
type Fn[T] = (func(null): F | null | T)          // ERR: type Fn: a type parameter may share
type G = Pair[Pair[int]]
type Pair[T] = (func(Pair[T], T): G | null)
type H = { r: Rec[Rec[Rec[int]]] | null }
type Rec[T] = { f: H | null | T }
type I = (func(null): J | null)
type J = (func(null): I | null)
type K = Pair[int]
var k: K | Pair[int] | null = null
var bad: K | Pair[Pair[int]] | null = null // ERR: a union may contain each discriminator at most once: K and Pair[Pair[int]] are both a function

var g: G | null = null
var h = H{ r: Rec{ f: Rec{ f: Rec{ f: 1 } } } }
var ij: I | J | null = null
println(g)
println(h)
println(ij)
println(k)
println(bad)
