// spec: 4 Unions
// Section 4: unions need distinguishable members; anonymous and named record types do not
// mix; a type parameter shares a union only with null, void, other parameters, and named
// types without arguments; aliases cannot form cycles.
type Box[T] = { value: T }
type Circle = { radius: float64 }
type Rect = { width: float64, height: float64 }
type Shape = Circle | Rect
type Both = Array[int] | Array[string]    // ERR: a union may contain each discriminator at most once
type Mixed = Box[int] | { value: string } // ERR: a union may not contain an anonymous record type
type Shared[T] = T | Array[int]           // ERR: a type parameter may share a union only with
type Loop = Loop | null                   // ERR: refers to itself without passing through
type Either[A, B] = A | B
type Tree = { value: int, children: Array[Tree] }
type Fine[T] = T | null | Circle

func area(s: Shape): float64 {
  if s is Circle { 3.14 * s.radius * s.radius } else { s.width * s.height }
}

func pick(c: bool): Array[int] | Array[string] { // ERR: a union may contain each discriminator at most once
  if c { [1] } else { ["a"] }
}

// Inference that forms an invalid union through an alias is caught at the call, as writing it is.
func either[A, B](a: A, b: B): Either[A, B] { b }
type Wrapped[A, B] = Array[Either[A, B]]
func wrapped[A, B](a: A, b: B): Wrapped[A, B] { [b] }

func main(): void {
  var inferred = either([1], ["s"]) // ERR: Array[int] and Array[string] are both an array
  var nested = wrapped([1], ["s"])  // ERR: Array[int] and Array[string] are both an array
  println(either(1, "s"))
  var e: Either[Box[int], Box[string]] = Box{ value: 1 } // ERR: Either[Box[int], Box[string]]
  var shapes: Array[Shape] = [Circle{ radius: 1.0 }, Rect{ width: 1.0, height: 2.0 }]
  println(Array.length(shapes))
  var mixed = if true { [1] } else { ["a"] } // ERR: the branches of this if do not form a valid type
  var t = Tree{ value: 1, children: [] }
  println(t)
  var s: Shape = Circle{ radius: 2.0 }
  s.radius = 1.0 // ERR: cannot assign a field through the union
  println(area(s))
}
type Sets = Set[int] | Set[string] // ERR: a union may contain each discriminator at most once
type SetOrArray = Set[int] | Array[int]
