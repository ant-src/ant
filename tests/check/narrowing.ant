// spec: 7 Narrowing
// Section 7: a narrowing lasts until the next assignment, an assignment anywhere in a loop body
// cancels it from the loop head on, even inside the place of another assignment, a while with a
// break does not narrow after it, a top-level var never narrows, and the else branch gets the
// complement.
type Config = { name: string }

var attempts = 0
var global: int | null = 1

func load(): Config | null { attempts += 1; if attempts > 2 { Config{ name: "c" } } else { null } }

func fromGlobal(): int {
  if global != null { global + 1 } else { 0 } // ERR: + needs both operands of one type, got int | null and int
}

var v: int | null = 1
var i = 0
while i < 3 {
  println(v + 1) // ERR: + needs both operands of one type, got int | null and int
  v = null
  i += 1
}
var c: Config | null = null
while c == null {
  c = load()
  if attempts > 5 { break }
}
println(c.name) // ERR: narrow the value first
var w: int | null = 1
if w != null {
  println(w + 1)
  w = null
  println(w + 1) // ERR: + needs both operands of one type, got null and int
}
var x: int | string = 1
if x is int { println(x + 1) } else { println(String.length(x)); println(x + 1) } // ERR: + needs both operands of one type
if !(x is int) { println(String.length(x)) }
var d: Config | null = null
while d == null { d = load() }
println(d.name)
var u: int | null = 1
var keep = func(): int { u ?? 0 }
if u != null {
  var inner = func(): int { u + 1 }
  println(inner() + keep())
}

func inPlace(c: Config | null): void {
  if c == null { return }
  var seen: Map[void, int] = Map{}
  var k = 0
  while k < 2 {
    k += 1
    println(c.name) // ERR: Config | null has no field name
    seen[(c = null)] = k
  }
}

// A break leaves the loop with the state at the break, not with the complement of the condition
// or the state at the end of the body.
func breakState(done: bool): int {
  var x: int | null = null
  while x == null {
    if done { break }
    x = 1
  }
  x + 1 // ERR: got int | null and int
}

func breakStateFor(done: bool): int {
  var y: int | null = 1
  for i in [1] {
    y = 2
    if done { y = null; break }
  }
  y + 1 // ERR: got int | null and int
}

// After a complete chain of tests whose branches all return, the local is never, which takes
// any type.
type Left = {}
type Right = {}
func afterChain(s: Left | Right): int {
  if s is Left { return 1 }
  if s is Right { return 2 }
  s
}
