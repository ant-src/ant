// spec: 5 select
// Section 5, select: a head is typed as the call it names and binds its result; a head that
// returns void has nothing to bind; a head takes no context, which is a clause of its own; each
// body is checked against the expected type, or the select has the union of its bodies' types;
// the bound variable narrows in its body; break and return in a body act on the loop and the
// function around the select.
type Line = { text: string }
type Closed = {}
type Tick = {}
type Event = Line | Closed | Tick

func events(lines: Channel[string], ctx: Context): Event {
  select {
    var line = Channel.receive(lines) { if line == null { Closed{} } else { Line{ text: line } } }
    Time.sleep(Time.duration(seconds: 1)) { Tick{} }
    Context.wait(ctx) { Closed{} }
  }
}

func wrong(lines: Channel[string], out: Channel[int], ctx: Context): int {
  var n: int = select {
    var line = Channel.receive(lines) { line } // ERR: cannot use string | null where int is expected
    var done = Context.wait(ctx) { 0 }         // ERR: Context.wait returns void, so there is nothing to bind to done
    Channel.receive(lines, ctx) { 1 }          // ERR: a select clause's head takes no context
    var sent = Channel.send(out, "x") { 2 }    // ERR: cannot use string where int is expected
  }
  n
}

func union(lines: Channel[string]): string | int {
  select {
    var line = Channel.receive(lines) { line ?? "" }
    else { 0 }
  }
}

func loop(lines: Channel[string], ctx: Context): int {
  var count = 0
  while true {
    select {
      var line = Channel.receive(lines) {
        if line == null { break }
        count += String.length(line)
      }
      Context.wait(ctx) { return count }
    }
  }
  count
}

func main(): void {
  var lines: Channel[string] = Channel.new()
  var ctx = Context.new()
  println(events(lines, ctx))
  println(union(lines))
  println(loop(lines, ctx))
}
