// spec: 6 Calling; 6 Anonymous functions
// Section 6: parameters are annotated; a lambda needs an expected function type with at most
// one parameter; a recursive or exported function states its return type; named arguments
// apply only to declared functions; there are no methods; defaults run in parameter order, so a
// default reads only earlier parameters and those without a default.
type Point = { x: float64, y: float64 }

func early(a: int = b, b: int = 1): int { a } // ERR: b is a parameter whose default has not run yet
func self(a: int = a): int { a }              // ERR: a is a parameter whose default has not run yet
func required(a: int = b, b: int): int { a }
func ordered(a: int = 1, b: int = a + 1, later: func(): int = { c }, c: int = 3): int { b + later() }

func Point.distance(a: Point, b: Point): float64 { a.x - b.x + a.y - b.y }

export func exported(a: int) { a } // ERR: must state its return type

func fact(n: int) { if n <= 1 { 1 } else { n * fact(n - 1) } } // ERR: fact is recursive; state its return type

func apply(f: func(int, int): int): int { f(1, 2) }

// A lambda of arity zero has no x, and an outer x does not show through: at run time its x is void.
func outerX(x: int): void {
  var noArg: func(): int = { x + 1 }     // ERR: x is not defined
  var noArgSet: func(): void = { x = 3 } // ERR: x is not defined
  var oneArg: func(int): int = { x + 1 }
}

func main(): void {
  var double = { x * 2 } // ERR: a lambda needs an expected function type
  var ok: func(int): int = { x * 2 }
  println(apply({ x })) // ERR: a lambda has at most one parameter
  println(apply(func(a: int, b: int): int { a + b }))
  var p = Point{ x: 1.0, y: 2.0 }
  println(p.distance(p)) // ERR: Point has no field distance
  println(Point.distance(a: p, b: p))
  var dist = Point.distance
  println(dist(a: p, b: p)) // ERR: a call through a function value is positional
  println(dist(p, p))
  var once = Once.new()
  Once.do(once, { println(x) })    // ERR: x is not defined
  println(Point.distance(p))       // ERR: Point.distance needs an argument for b
  println(Point.distance(p, p, p)) // ERR: Point.distance takes 2 arguments
  println(Point.distance(p, c: p)) // ERR: Point.distance has no parameter c
  var early = func(): int {
    return // ERR: cannot use void where int is expected
  }
  println(early())
  var g: func(int): int = func(a: int, b: int): int { a + b } // ERR: cannot use func(int, int): int where func(int): int is expected
  println(ok(1))
  println(required(b: 2) + ordered())
  var lit = func(a: int = b, b: int = 2): int { a } // ERR: b is a parameter whose default has not run yet
}
