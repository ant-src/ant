// spec: 4 Type declarations; 4 Unions
// Section 4: a union that names an alias of its own cycle is checked once the alias's body is
// known, so members that share a discriminator through the alias are a compile error at the
// declaration, directly, through another alias, and through a mutual cycle; the same shapes with
// distinct discriminators are fine, and using one does not loop. A generic alias in such a cycle is
// rejected before its unions are checked, and recurs through a record's field instead.
type Box[T] = { value: T }
type Bad = Array[Bad | Array[int]]  // ERR: type Bad: a union may contain each discriminator at most once: Bad and Array[int] are both an array
type Via = Array[Name | Array[int]] // ERR: type Via: a union may contain each discriminator at most once: Name and Array[int] are both an array
type Name = Via
type Even = Array[Odd | Map[string, int]] // ERR: Odd and Map[string, int] are both a map
type Odd = Map[string, Even | int]
type Nested = Array[Nested | int]
type Tree = Array[Tree | Box[int]]
type Config = Map[string, Config | bool]
type Deep = Array[Map[string, Deep | Set[int]] | Box[int]]
type Generic[T] = Array[Generic[T] | Array[int]] // ERR: type Generic refers to itself without passing through a record's field
type Items[T] = { items: Array[Forest[T] | int] }
type Forest[T] = Array[Items[T] | Box[T]]

var n: Nested = [1, [2]]
var t: Tree = [Box{ value: 1 }, []]
var c: Config = Map{ "a": true }
var d: Deep = [Map{ "k": [] }]
var f: Forest[int] = [Box{ value: 1 }, Items{ items: [2, []] }]
var wrong: Tree = [1] // ERR: cannot use
println(n)
println(t)
println(c)
println(d)
println(f)
println(wrong)
