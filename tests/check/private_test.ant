// spec: 10 Tests; 11 Test
// Section 10, Tests: a test file imports a module's private names, through a list or a
// namespace, but not the names that module imports; a test body returns void or an Err, and a
// subtest's name is a string.
import "./private.ant" { Counter, secret, open }
import "./private.ant" Private
import "./private.ant" { Point } // ERR: Point is not exported by ./private.ant
import "../run/lib/geometry.ant" { distance }

test "private names" {
  var c = Counter{ n: 0 }
  Counter.bump(c)
  Private.Counter.bump(c)
  assert(secret() == open())
  assert(Private.secret() == 42)
  var p = Private.origin()
  assert(distance(p, p) == 0.0)
  var name: string = Test.name()
  var ctx: Context = Test.context()
  var dir: string = Test.tempDir()
  println("${name} ${dir} ${Context.isDone(ctx)}")
}

test "try returns an Err" {
  var text = try File.read("x")
  println(text)
}

test "a value is not a result" {
  return 5 // ERR: a test returns void or an Err, not int
}

test "subtest names" {
  var n = 3
  test "${n}" {
    assert(n == 3)
  }
}

test "skip is never" {
  var home: string = Os.env("HOME") ?? Test.skip("no HOME")
  println(home)
  Test.parallel()
}
