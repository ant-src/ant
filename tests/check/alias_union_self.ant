// spec: 4 Type declarations; 4 Unions
// Section 4: an alias whose body is a union or names a type may not name itself in a union
// inside that body, directly or through another alias: flattening the outer union would need the
// inner one, which needs the alias expanded again. Recursion through an array, map, set, function
// or record type that is the whole body, through a named record type, or outside any inner union
// is fine. A generic alias in such a cycle is rejected for its type parameters first.
type Opt[X] = X | null
type R = Array[R | int] | null // ERR: type R names itself in the union R | int
type U = Opt[Array[U | int]]   // ERR: type U names itself in the union U | int
type V = Array[W | int] | null // ERR: type V names itself in the union W | int
type W = V
type P = Array[P | int] | null         // ERR: type P names itself in the union P | int
type RG[T] = Array[RG[T] | int] | null // ERR: type RG refers to itself without passing through a record's field
type L = Array[L | int]
type G = Array[G] | null
type Node = { value: int, children: Array[Node | int] }
type Tree = Node | null

var l: L = [[1], 2]
var g: G = [[null]]
var t: Tree = Node{ value: 1, children: [2] }
println(l)
println(g)
println(t)
