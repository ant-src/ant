// spec: 4 Assignability; 7
// Section 4: the assignability rules one by one: same type only for primitives, union members,
// never and void and null, anonymous record width with exact field types, invariant type
// arguments, no top type; and T | null | null is T | null. Field order is not part of an
// anonymous record type's shape, so the same fields in another order are the same type.
type Circle = { radius: float64 }
type Rect = { width: float64 }
type Shape = Circle | Rect
type Person = { name: string, age: int }
func named(): { name: string, age: int } { Person{ name: "a", age: 1 } }

func main(): void {
  var a: int = int8(1) // ERR: cannot use int8 where int is expected
  var b: int | null = 1
  var c: int | string = 1
  var d: int | string | null = c
  var e: int = c // ERR: cannot use int | string where int is expected
  var f: int | void = 1
  var g: void = null // ERR: cannot use null where void is expected
  var h: int | null = null
  var n: int = panic("never")
  var t: any = 1 // ERR: unknown type any
  var circles: Map[string, Circle] = Map{ a: Circle{ radius: 1.0 } }
  var shapes: Map[string, Shape] = circles // ERR: cannot use Map[string, Circle] where Map[string, Shape] is expected
  var widened: Map[string, Shape] = Map.merge(Map{}, circles) // ERR: cannot use Map[string, Circle] where Map[string, Shape] is expected
  var p: { name: string | null } = Person{ name: "a", age: 1 } // ERR: cannot use Person where { name: string | null } is expected
  var q: { name: string } = Person{ name: "a", age: 1 }
  var x: int | null | null = null
  var y: int | null = x
  var z: Shape = Circle{ radius: 1.0 }
  var w: Shape | null = z
  var people: Array[{ name: string, age: int }] = [named()]
  var reordered: Array[{ age: int, name: string }] = people
  print(a + n)
  print(b)
  print(d)
  print(e)
  print(f)
  print(h)
  print(t)
  print(shapes)
  print(widened)
  print(p)
  print(q)
  print(y)
  print(w)
  print(reordered)
}
