// spec: 4 Type declarations; 4 Unions
// Section 4: an alias whose body is a union may not name itself in a union inside that body
// through another alias, whichever of the two is declared first: the error is at the alias whose
// body is the union, and checking ends. Where the other alias instantiates a generic one, the
// generic alias is on a cycle and rejected for its type parameters instead.
type A = B[int]
type B[T] = (func(): A | int) | null // ERR: type B refers to itself through A without passing through a record's field
type C = D
type D = (func(): C | int) | null // ERR: type D names itself in the union C | int
type E = F[F[int]]
type F[T] = (func(): E | T) | null   // ERR: type F refers to itself through E without passing through a record's field
type H[T] = (func(): G | int) | null // ERR: type H refers to itself through G without passing through a record's field
type G = H[int]
type M = (func(): N | int) | null // ERR: type M names itself in the union N | int
type N = M
type I = (func(): I | int)
type J = Array[K | int] | null
type K = { j: J }

var i: I = { 1 }
var j: J = [K{ j: null }, 2]
println(i)
println(j)
