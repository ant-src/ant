// spec: 4 Generics
// Section 4: inside a generic body T is known only through its bound: an operator applies when
// it applies to every member, T is assignable to its bound, a union bound included, the fields
// of a record bound are usable, a bounded T may be tested against a member of its bound, and an
// unbounded T is opaque except for == and map keys; a solution must satisfy the bound, read with
// the solutions of the type parameters it names; a type parameter a primitive body does not
// mention gives distinct static types over one tag.
type Id[T] = string
type User = {}
type Account = {}
type Both = Id[User] | Id[Account] // ERR: a union may contain each discriminator at most once

func diff[T: Ordered](a: T, b: T): T { a - b } // ERR: - applies to
func plus[T: Ordered](a: T, b: T): T { a + b }
func same[T](a: T, b: T): bool { a == b }
func opaqueAdd[T](a: T, b: T): T { a + b } // ERR: + applies to
func keyed[T](k: T): Map[T, int] { Map{ (k): 1 } }
func show[T: Ordered](x: T): string { if x is string { x } else { String.from(x) } }
func isStr[T](x: T): bool { x is string } // ERR: is
func rename[T: { name: string }](x: T): T { x.name = "n"; x }
func ageOf[T: { name: string }](x: T): int { x.age } // ERR: has no field age
func bigger[T: Ordered](a: T, b: T): T { if a > b { a } else { b } }
func widen[T: Ordered](x: T): Ordered { x }
func widenNull[T: Ordered](x: T): Ordered | null { x }
func narrowBack[T: Ordered](x: Ordered): T { x } // ERR: cannot use Ordered where T is expected

type Named = { name: string }

println(plus(1, 2) + plus(3, 4))
println(plus("a", "b"))
println(same(1, 1) && same("a", "a"))
println(keyed("k"))
println(show(1) + show("s"))
println(rename(Named{ name: "x" }))
println(widen(1))
println(widenNull("s"))
println(bigger("a", 1))      // ERR: cannot use int where string is expected
println(bigger(true, false)) // ERR: T would be bool
var o: Ordered = 1
println(bigger(o, o)) // ERR: T would be Ordered
var u: Id[User] = Id("u")
var a: Id[Account] = u // ERR: cannot use Id[User] where Id[Account] is expected
println(string(u))

// A bound may name the function's other type parameters, and is read with their solutions.
func first[T, U: Array[T]](x: T, u: U): T { x }
func later[U: Array[T], T](u: U, x: T): T { x }
func nested[T: Array[T]](x: T): int { 0 }
func wrap[T, U: Array[T]](x: T): U { [x] } // ERR: cannot use Array[T] where U is expected
println(first(1, [2]))
println(first(1, ["a"]))                      // ERR: U would be Array[string], which is not assignable to its bound Array[int]
println(later(["a"], 2))                      // ERR: U would be Array[string], which is not assignable to its bound Array[int]
println(nested([1]))                          // ERR: T would be Array[int], which is not assignable to its bound Array[Array[int]]
var ws: Array[string] = wrap(1)               // ERR: U would be Array[string], which is not assignable to its bound Array[int]
var fw: func(int, Array[string]): int = first // ERR: U would be Array[string], which is not assignable to its bound Array[int]

// A bound may not itself be a type parameter, its own or another's, nor an alias that expands to
// one, in a function, a type, or a block.
type Same[X] = X
func self[T: T](x: T): int { 0 }          // ERR: the bound of T is the type parameter T; a bound may not be a type parameter
func pair[T: U, U: int](x: T): int { 0 }  // ERR: the bound of T is the type parameter U
func loop[T: U, U: T](x: T): int { 0 }    // ERR: the bound of T is the type parameter U ;; the bound of U is the type parameter T
func aliased[T: Same[T]](x: T): int { 0 } // ERR: the bound of T is the type parameter T
func around[T: T | null, U: Array[U]](x: T): int { 0 }
type SelfBound[T: T] = { v: T }        // ERR: the bound of T is the type parameter T
type AliasBound[T: Same[T]] = { v: T } // ERR: the bound of T is the type parameter T
func block(): int {
  type Local[A: B, B] = { a: A } // ERR: the bound of A is the type parameter B
  0
}
