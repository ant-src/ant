// spec: 4 Generics; 4 Inference
// Inside a generic function its own type parameter is a type the caller chooses, so a call
// there cannot bind it: a lambda whose body has another type is an error, as a var of that type
// already was, and a lambda whose body is the parameter's own value is fine.
func wrap[T](x: T, f: func(T): Array[T]): Array[T] { f(x) }
func apply[T](x: T, f: func(T): T): T { f(x) }

func wrong[T](a: T): Array[T] {
  wrap(a, { [1] }) // ERR: the lambda returns Array[int] where Array[T] is expected
}

func wrongToo[T](a: T): T {
  apply(a, { "oops" }) // ERR: the lambda returns string where T is expected
}

func fine[T](a: T): Array[T] { wrap(a, { [x] }) }
func fineToo[T](a: T): T { apply(a, { x }) }
func fixed(a: int): Array[int] { wrap(a, { [1] }) }

func main(): void {
  println(fine("s"))
  println(fineToo(true))
  println(fixed(2))
}

// A function whose return type is inferred on demand from inside a generic body has none of that
// body's type parameters in scope, whichever order the two are declared in.
func wrapDeep[T](x: T, depth: int): Array[T] {
  if depth > 0 { countDeep() }
  [x]
}

func countDeep() { println(len(wrapDeep(1, 0))) }
