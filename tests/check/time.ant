// spec: 4 Unions; 5 is
// Sections 4 and 5 for the time types of stdlib.md: a union of time types is legal, since each
// carries a tag; is tests one and narrows; an alias of them is not a target; a bound stands for
// one member; the comparison operators do not apply; a sync type may share a union with them.
func describe(t: Time.Dated): string {
  if t is Time.PlainDate { "date" }
  else if t is Time.ZonedDateTime { "zoned" }
  else { "date-time" }
}

var d = Time.plainDate(2026, 10, 22)
var i = Time.now()
var some: Time.Instant | Time.PlainDate | null = d
println(some is Time.PlainDate)
println(some is Time.Dated) // ERR: is an alias and has no run-time identity
println(d < d)              // ERR: < applies to a single numeric kind
println(Time.year(some))    // ERR: cannot use Time.Instant | Time.PlainDate | null where Time.Dated is expected
var mixed: Time.Dated = d
println(Time.year(mixed))
println(Time.compare(mixed, mixed))                          // ERR: not a single member of its bound
println(Time.round(d, Time.Day{}))                           // ERR: not a single member of its bound Time.Instant | Time.Timed
println(Time.with(i, year: 2020))                            // ERR: not a single member of its bound Time.Wall
println(Time.add(mixed, Time.duration(days: 1)))             // ERR: not a single member of its bound Time.Point
println(Time.until(d, i))                                    // ERR: cannot use Time.Instant where Time.PlainDate is expected
println(Time.round(i, Time.Hour{}, mode: Time.Compatible{})) // ERR: cannot use Time.Compatible where Time.RoundingMode is expected
var shared: Mutex | Time.Instant = i
println(shared is Time.Instant)
println(describe(d))
