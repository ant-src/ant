// spec: 4 Type declarations; 4 Unions
// Section 4: an alias that reaches itself without passing through a record's field takes no type
// parameters, and neither does any alias on its cycle, whatever type arguments the cycle passes
// and whichever order it is declared in; a record's type arguments do not break the cycle. The
// same recursion through a record's field is fine when the record passes its own type parameters
// unchanged and in order, directly or through other generic types, and a compile error at the
// record when it does not. A use that names a later generic alias is checked against its body
// all the same.
type Box[T] = { value: T }
type N[A, B] = Array[N[B, Box[A]]] | Map[string, A | B] // ERR: type N refers to itself without passing through a record's field; an alias with type parameters may not, so wrap the recursion in a named record type
type Swap[A, B] = Array[Swap[B, A]] | Map[A, B]         // ERR: type Swap refers to itself without passing through a record's field
type Calls[T] = func(Calls[Array[T]]): T                // ERR: type Calls refers to itself without passing through a record's field
type Nest[T] = Array[Nest[T]] | Box[T]                  // ERR: type Nest refers to itself without passing through a record's field
type Tree[T] = Box[Tree[T]] | null                      // ERR: type Tree refers to itself without passing through a record's field
type Outer[X, Y] = Array[Inner[X]] | Map[X, Y]          // ERR: type Outer refers to itself through Inner without passing through a record's field
type Inner[T] = Map[string, Outer[T, int]] | Box[T]
type Plain = Ring[int]
type Ring[T] = Array[Plain] | Box[T]  // ERR: type Ring refers to itself through Plain without passing through a record's field
type Even[T] = Array[Odd[T]] | Box[T] // ERR: type Even refers to itself through Odd without passing through a record's field
type Odd[U] = Map[string, Even[U]] | Set[U]
type Chain[T] = { next: Chain[Box[T]] | null } // ERR: type Chain refers to itself as Chain[Box[T]]; a generic type must refer to itself as Chain[T], with its own type parameters in order
type Link[T] = { next: Link[T] | null, value: T }
type Forest[T] = Branch[T] | Box[T]
type Branch[T] = { kids: Array[Forest[T]] }
type Grow[T] = Leaf | Node[Box[T]]
type Node[T] = { kids: Array[Grow[T]] } // ERR: type Node refers to itself through Grow with other type arguments; a generic type must refer to itself as Node[T], with its own type parameters in order
type Leaf = { n: int }
type Pairs = Wrap[Box[int], Box[string]] // ERR: Wrap[Box[int], Box[string]]: in Either[Box[int], Box[string]]: a union may contain each discriminator at most once
type Wrap[A, B] = Array[Either[A, B]]
type Either[A, B] = A | B

var c: Link[int] = Link{ next: null, value: 1 }
var f: Forest[int] = Branch{ kids: [Box{ value: 1 }, Branch{ kids: [] }] }
println(c)
println(f)
