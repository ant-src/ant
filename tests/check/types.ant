// spec: 4 Records; 4 Named primitive types; 4 Type declarations
// Section 4: records are nominal, anonymous record types are structural, named primitive types
// are distinct from their base, and a type is not a value.
type Named = { name: string }
type Person = { name: string, age: int }
type Point = { x: float64, y: float64 }
type Copy = Point // ERR: would mint a second tag
type UserId = string
type AccountId = string
type Meters = float64
type Alias = int | string

func greet(n: { name: string }): string { `hi ${n.name}` }

func main(): void {
  var user = Person{ name: "ada", age: 36 }
  print(greet(user))
  var n: Named = user // ERR: cannot use Person where Named is expected
  print(greet(Named{ name: "ada", age: 36 })) // ERR: Named has no field age
  print(Person{ name: "bob" }) // ERR: Person literal is missing the field age
  var p = Point{ x: 1.0, y: 2.0 }
  print(p["x"]) // ERR: a record has no dynamic access
  var id = UserId("u-1")
  var other: AccountId = id // ERR: cannot use UserId where AccountId is expected
  var raw: string = id // ERR: cannot use UserId where string is expected
  var bad: UserId = "u-1" // ERR: cannot use string where UserId is expected
  var d = Meters(3.0) * Meters(2.0)
  var e = Meters(3.0) * 2.0 // ERR: * needs both operands of one type, got Meters and float64
  print(String.length(id)) // ERR: cannot use UserId where string is expected
  print(Point) // ERR: Point is a type, not a value
  print(Alias) // ERR: Alias is a type, not a value
  var q: Alias = 1
  var w: Point = Point{ x: 1.0, y: "2" } // ERR: cannot use string where float64 is expected
  print(user.name)
  var small = int8(300)
  print(small)
  print(int8(user)) // ERR: int8 converts a number or a named primitive type over a number, got Person
  var count = Meters(1.0)
  print(float64(count) + 1.0)
  print(int(count)) 
}
