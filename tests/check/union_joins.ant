// spec: 4 Unions; 4 Tagged unions
// Section 4: a field read through a union needs every member to declare it with types that form
// a valid union; an anonymous record type is at most one member and never beside a named one; a
// type parameter shares a union only with null, void, other parameters, and named types without
// arguments; at most one sync type; an exhaustive chain breaks when a member is added; the
// result of a generic call and a field of a generic record are unions formed again from the
// type arguments.
type Box[T] = { value: T }
type Point = { x: int }
type NotFound = {}
type U1 = { items: Array[int], name: string }
type U2 = { items: Array[string] }
type Circle = { radius: float64 }
type Rect = { width: float64 }
type Tri = { base: float64 }
type Shape = Circle | Rect | Tri
type Either[A, B] = A | B
type Bad = { name: string } | Point // ERR: anonymous record type
type Bad2 = { a: int } | { b: int } // ERR: are both an anonymous record
type P2[T] = T | Box[int]           // ERR: a type parameter may not share a union with Box[int]
type Fine[T] = T | NotFound | null
type R[T, E] = Ok[T] | Err[E]
type S = Mutex | WaitGroup // ERR: at most one sync type
type OneOfEach = Array[int] | Map[string, int] | (func(): int) | null | int | float64 | string | bool | Point

func items(u: U1 | U2): int { Array.length(u.items) } // ERR: a union may contain each discriminator at most once
func name(u: U1 | U2): string { u.name }              // ERR: U2 has no field name
func area(s: Shape): float64 {
  if s is Circle { s.radius } else if s is Rect { s.width } // ERR: an if without else has type void
}
type Mix[A, B] = { a: A, b: B, either: A | B }
func mix[A, B](a: A, b: B): Mix[A, B] { Mix{ a, b, either: a } }
func written(m: Mix[Box[int], Box[string]]): void {} // ERR: Mix[Box[int], Box[string]]: a union may contain each discriminator at most once
func pick[A, B](a: A, b: B, first: bool): A | B { if first { a } else { b } }

var same = pick(1, 2, true)
var mixed = pick(1, "a", true)
var boxes = pick(Box{ value: 1 }, Box{ value: "s" }, false) // ERR: the result of pick: a union may contain each discriminator at most once
var m = mix(Box{ value: 1 }, Box{ value: "s" })
println(m.a.value + 1)
var either = m.either  // ERR: reading either through Mix[Box[int], Box[string]]
var { either: e2 } = m // ERR: reading either through Mix[Box[int], Box[string]]
println(mix(1, "s").either)
println(same + 1)
println(mixed)
var e: Either[Box[int], { value: string }] = Box{ value: 1 } // ERR: anonymous record type
var f: Fine[int] = NotFound{}
var r: R[int, string] = Result.ok(1)
var o: OneOfEach = null
println(f)
println(r)
println(o)
println(area(Tri{ base: 1.0 }))
