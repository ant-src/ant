// spec: 10
// An exported function whose parameters, result, or bounds name a private interface of the
// module is a compile error, and so is an exported interface whose functions name one and an
// exported variable whose type does. A private type of another kind may appear in an exported
// signature, and a private interface in a field of an exported type.
interface Shape {
  area(s: Self): float64
}

export interface Named {
  name(s: Self): string
}

type Token = { value: string }

export func one(s: Shape): float64 { s.area() }                                            // ERR: one is exported but its signature names the interface Shape, which is not
export func total(shapes: Array[Shape]): float64 { shapes.map({ x.area() }).sum() ?? 0.0 } // ERR: total is exported but its signature names the interface Shape
export func biggest[T: Shape](xs: Array[T]): T | null { xs.first() }                       // ERR: biggest is exported but its signature names the interface Shape
export func label(n: Named): string { n.name() }
export func issue(): Token { Token{ value: "abc" } }
func inner(s: Shape): float64 { s.area() }
type Shapes = Array[Shape]
export func sum(xs: Shapes): float64 { 0.0 } // ERR: sum is exported but its signature names the interface Shape
export interface Scene {                     // ERR: Scene is exported but its body names the interface Shape, which is not
  first(s: Self): Shape
}
export interface Labeled {
  label(s: Self): Named
}
export let draw = func(s: Shape): float64 { s.area() } // ERR: draw is exported but its type names the interface Shape, which is not
export let title = func(n: Named): string { n.name() }
export type Box = { shape: Shape }
