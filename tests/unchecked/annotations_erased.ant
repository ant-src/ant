// spec: 4 Checking and running
// ant run parses and discards annotations: a program the checker rejects runs when its values
// are consistent at run time, since every runtime rule is defined on values.
func double(n: string): int { n * 2 }

var x: string = 21
println(double(x))
var y: Array[bool] = Map{ a: 1 }
println(y["a"])

// expect
// out: 42
// out: 1
