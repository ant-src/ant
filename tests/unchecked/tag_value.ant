// spec: 12 Values; 12 Expressions
// A type declaration binds a tag, which is a value at run time: it renders, compares by
// identity, carries the functions declared on its type as fields, and a variable holding it
// serves as the right side of is.
type Point = { x: int }

func Point.origin(): Point { Point{ x: 0 } }

var t = Point
println(t == Point)
println(t.origin())
var p = Point{ x: 1 }
println(p is t)
println(1 is t)
println(t)

// expect
// out: true
// out: Point{ x: 0 }
// out: true
// out: false
// out: Point
