// spec: 12 Runtime panics; 4 Types as values; 4 Unions
// panics: type-expr
// An unchecked run rejects an alias that is a member of a union inside the function type its own
// body instantiates, once the union holds two functions that are not the same type, when a type
// expression first reaches it, and ends; with one function, the type expression is fine.
type A = B[B[B[int]]]
type B[T] = (func(null): A | null | T)
type C = D[int]
type D[T] = (func(null): C | null | T)
println(type(C | D[int]))
println(Panic.catch({ type(Array[C | D[D[int]]]) }) is Err)
println(type(A))

// expect
// out: C
// out: true
// exit: 1
// err: a union may contain each discriminator at most once: A and B[int] are both a function
