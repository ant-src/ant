// spec: 12 Runtime panics; 4 Types as values; 4 Type declarations
// panics: type-expr
// An unchecked run rejects a generic type that refers to itself with other type arguments as
// soon as a type expression completes its declaration, before a union that names the type
// compares its ever-growing instantiations.
type D[T] = { x: string }
type B[T] = Array[B[D[T]]] | null
println(Panic.catch({ type(B[int] | null) }) is Err)
println(type(B[int] | string))

// expect
// out: true
// exit: 1
// err: type B refers to itself as B[D[T]]; a generic type must refer to itself as B[T], with its own type parameters in order
