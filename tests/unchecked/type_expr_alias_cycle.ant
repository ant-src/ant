// spec: 12 Runtime panics; 4 Types as values; 4 Type declarations
// panics: type-expr
// An unchecked run rejects an alias that reaches itself through unions alone, as the checker
// does, when a type expression first reaches it, so comparing its instantiations ends.
type A[T] = B[T] | null
type B[T] = A[T] | null
println(Reflect.erase(type(A[int])) == Reflect.erase(type(A[string])))

// expect
// exit: 1
// err: type A refers to itself through B without passing through a record, array, map, set, or function
