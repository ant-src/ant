// The prelude, in Ant notation: every type and function signature the checker binds in every
// module (section 11 and stdlib.md). The runtime binds the same names to Go implementations;
// a test keeps the two in step. Parsed in declarations mode: a func has no body, a type may be
// opaque, and var Name.CONSTANT: T declares a namespace constant.

type Ok[T] = { value: T }
type Err[E] = { error: E }
type Result[T, E] = Ok[T] | Err[E]
type Error = { message: string }
type Entry[K, V] = { key: K, value: V }
type Indexed[T] = { index: int, value: T }
type Seq[T] = func(func(T): bool): void
type Integer = int8 | int16 | int32 | int64 | uint8 | uint16 | uint32 | uint64
type Number = Integer | float32 | float64
type Ordered = Number | string

func print[T](value: T): void
func panic(message: string): never

// The twelve conversion names are built into the checker; these give their shape. Each also
// accepts a named primitive whose base is a kind it takes, and unwraps it.
func int8[T: Number](x: T): int8
func int16[T: Number](x: T): int16
func int32[T: Number](x: T): int32
func int64[T: Number](x: T): int64
func uint8[T: Number](x: T): uint8
func uint16[T: Number](x: T): uint16
func uint32[T: Number](x: T): uint32
func uint64[T: Number](x: T): uint64
func float32[T: Number](x: T): float32
func float64[T: Number](x: T): float64
func int[T: Number](x: T): int
func byte[T: Number](x: T): byte
func string(x: string): string
func bool(x: bool): bool

// Array

func Array.length[T](xs: Array[T]): int
func Array.isEmpty[T](xs: Array[T]): bool
func Array.get[T](xs: Array[T], i: int): T | null
func Array.first[T](xs: Array[T]): T | null
func Array.last[T](xs: Array[T]): T | null
func Array.push[T](xs: Array[T], v: T): void
func Array.pop[T](xs: Array[T]): T | null
func Array.insert[T](xs: Array[T], i: int, v: T): void
func Array.removeAt[T](xs: Array[T], i: int): T
func Array.slice[T](xs: Array[T], from: int, to: int): Array[T]
func Array.concat[T](xs: Array[T], ys: Array[T]): Array[T]
func Array.map[T, U](xs: Array[T], f: func(T): U): Array[U]
func Array.flatMap[T, U](xs: Array[T], f: func(T): Array[U]): Array[U]
func Array.filter[T](xs: Array[T], f: func(T): bool): Array[T]
func Array.reduce[T, A](xs: Array[T], init: A, f: func(A, T): A): A
func Array.find[T](xs: Array[T], f: func(T): bool): T | null
func Array.findIndex[T](xs: Array[T], f: func(T): bool): int | null
func Array.findLast[T](xs: Array[T], f: func(T): bool): T | null
func Array.findLastIndex[T](xs: Array[T], f: func(T): bool): int | null
func Array.some[T](xs: Array[T], f: func(T): bool): bool
func Array.every[T](xs: Array[T], f: func(T): bool): bool
func Array.countWhere[T](xs: Array[T], f: func(T): bool): int
func Array.contains[T](xs: Array[T], v: T): bool
func Array.indexOf[T](xs: Array[T], v: T): int | null
func Array.lastIndexOf[T](xs: Array[T], v: T): int | null
func Array.min[T: Ordered](xs: Array[T]): T | null
func Array.max[T: Ordered](xs: Array[T]): T | null
func Array.minBy[T, K: Ordered](xs: Array[T], key: func(T): K): T | null
func Array.maxBy[T, K: Ordered](xs: Array[T], key: func(T): K): T | null
func Array.sort[T: Ordered](xs: Array[T]): Array[T]
func Array.sortBy[T, K: Ordered](xs: Array[T], key: func(T): K): Array[T]
func Array.sortWith[T](xs: Array[T], cmp: func(T, T): int): Array[T]
func Array.reverse[T](xs: Array[T]): Array[T]
func Array.unique[T](xs: Array[T]): Array[T]
func Array.uniqueBy[T, K](xs: Array[T], key: func(T): K): Array[T]
func Array.chunk[T](xs: Array[T], n: int): Array[Array[T]]
func Array.groupBy[T, K](xs: Array[T], key: func(T): K): Map[K, Array[T]]
func Array.entries[T](xs: Array[T]): Array[Indexed[T]]
func Array.range(from: int, to: int): Array[int]
func Array.filled[T](n: int, v: T): Array[T]
func Array.flatten[T](xs: Array[Array[T]]): Array[T]
func Array.sum[T: Number](xs: Array[T]): T | null
func Array.same[T](xs: Array[T], ys: Array[T]): bool

// Map

func Map.size[K, V](m: Map[K, V]): int
func Map.isEmpty[K, V](m: Map[K, V]): bool
func Map.has[K, V](m: Map[K, V], k: K): bool
func Map.get[K, V](m: Map[K, V], k: K): V | null
func Map.set[K, V](m: Map[K, V], k: K, v: V): void
func Map.remove[K, V](m: Map[K, V], k: K): V | null
func Map.keys[K, V](m: Map[K, V]): Array[K]
func Map.values[K, V](m: Map[K, V]): Array[V]
func Map.entries[K, V](m: Map[K, V]): Array[Entry[K, V]]
func Map.fromEntries[K, V](entries: Array[Entry[K, V]]): Map[K, V]
func Map.map[K, V, W](m: Map[K, V], f: func(Entry[K, V]): W): Map[K, W]
func Map.filter[K, V](m: Map[K, V], f: func(Entry[K, V]): bool): Map[K, V]
func Map.merge[K, V](m: Map[K, V], n: Map[K, V]): Map[K, V]
func Map.same[K, V](m: Map[K, V], n: Map[K, V]): bool

// String

type String.Cut = { before: string, after: string }

func String.length(s: string): int
func String.isEmpty(s: string): bool
func String.slice(s: string, from: int, to: int): string
func String.concat(parts: Array[string]): string
func String.split(s: string, sep: string): Array[string]
func String.join(parts: Array[string], sep: string): string
func String.repeat(s: string, n: int): string
func String.trim(s: string): string
func String.trimStart(s: string): string
func String.trimEnd(s: string): string
func String.trimPrefix(s: string, prefix: string): string
func String.trimSuffix(s: string, suffix: string): string
func String.padStart(s: string, width: int, pad: string = " "): string
func String.padEnd(s: string, width: int, pad: string = " "): string
func String.contains(s: string, t: string): bool
func String.startsWith(s: string, t: string): bool
func String.endsWith(s: string, t: string): bool
func String.indexOf(s: string, t: string): int | null
func String.lastIndexOf(s: string, t: string): int | null
func String.count(s: string, t: string): int
func String.replace(s: string, old: string, new: string): string
func String.replaceFirst(s: string, old: string, new: string): string
func String.cut(s: string, sep: string): String.Cut | null
func String.fields(s: string): Array[string]
func String.lines(s: string): Array[string]
func String.toUpper(s: string): string
func String.toLower(s: string): string
func String.isDigit(s: string): bool
func String.isLetter(s: string): bool
func String.isSpace(s: string): bool
func String.isUpper(s: string): bool
func String.isLower(s: string): bool
func String.chars(s: string): Array[string]
func String.toBytes(s: string): Array[byte]
func String.fromBytes(bytes: Array[byte]): string | null
func String.toCodePoints(s: string): Array[int]
func String.fromCodePoints(points: Array[int]): string | null
func String.toInt(s: string, base: int = 10): int | null
func String.toFloat(s: string): float64 | null
func String.fromInt[T: Integer](x: T, base: int = 10): string
func String.fromFloat(x: float64, digits: int): string
func String.from[T](value: T): string

// Regex

type Regex.Pattern
type Regex.Match = { text: string, start: int, end: int, groups: Array[string | null], named: Map[string, string | null] }

func Regex.compile(source: string, flags: string = ""): Result[Regex.Pattern, Error]
func Regex.test(p: Regex.Pattern, s: string): bool
func Regex.find(p: Regex.Pattern, s: string): Regex.Match | null
func Regex.findAll(p: Regex.Pattern, s: string): Array[Regex.Match]
func Regex.replace(p: Regex.Pattern, s: string, replacement: string): string
func Regex.replaceFirst(p: Regex.Pattern, s: string, replacement: string): string
func Regex.replaceWith(p: Regex.Pattern, s: string, f: func(Regex.Match): string): string
func Regex.split(p: Regex.Pattern, s: string): Array[string]
func Regex.escape(s: string): string
func Regex.source(p: Regex.Pattern): string
func Regex.flags(p: Regex.Pattern): string

// Iter

func Iter.range(from: int, to: int): Seq[int]
func Iter.fromArray[T](xs: Array[T]): Seq[T]
func Iter.map[T, U](s: Seq[T], f: func(T): U): Seq[U]
func Iter.filter[T](s: Seq[T], f: func(T): bool): Seq[T]
func Iter.take[T](s: Seq[T], n: int): Seq[T]
func Iter.toArray[T](s: Seq[T]): Array[T]

