func Time.round[T: Time.Instant | Time.Timed](t: T, smallestUnit: Time.Unit, increment: int = 1, mode: Time.RoundingMode = Time.HalfExpand{}): T
func Time.compare[T: Time.Point](a: T, b: T): int
func Time.part(d: Time.Duration, unit: Time.Unit): int
func Time.sign(d: Time.Duration): int
func Time.negate(d: Time.Duration): Time.Duration
func Time.abs(d: Time.Duration): Time.Duration
func Time.addDuration(a: Time.Duration, b: Time.Duration): Time.Duration
func Time.compareDuration(a: Time.Duration, b: Time.Duration, relativeTo: Time.Dated | null = null): int
func Time.total(d: Time.Duration, unit: Time.Unit, relativeTo: Time.Dated | null = null): float64
func Time.roundDuration(d: Time.Duration, smallestUnit: Time.Unit | null = null, largestUnit: Time.Unit | null = null, increment: int = 1, mode: Time.RoundingMode = Time.HalfExpand{}, relativeTo: Time.Dated | null = null): Time.Duration

