// Result and Record

func Result.ok[T, E](value: T): Result[T, E]
func Result.err[T, E](error: E): Result[T, E]
func Result.isOk[T, E](r: Result[T, E]): bool
func Result.map[T, U, E](r: Result[T, E], f: func(T): U): Result[U, E]
func Result.mapErr[T, E, F](r: Result[T, E], f: func(E): F): Result[T, F]
func Result.unwrap[T, E](r: Result[T, E]): T
func Result.unwrapOr[T, E](r: Result[T, E], fallback: T): T
func Result.all[T, E](rs: Array[Result[T, E]]): Result[Array[T], E]

func Record.same[T: {}](a: T, b: T): bool

// Synchronization

type Mutex
func Mutex.new(): Mutex
func Mutex.lock(m: Mutex): void
func Mutex.unlock(m: Mutex): void
func Mutex.withLock[T](m: Mutex, f: func(): T): T

type RwMutex
func RwMutex.new(): RwMutex
func RwMutex.readLock(m: RwMutex): void
func RwMutex.readUnlock(m: RwMutex): void
func RwMutex.writeLock(m: RwMutex): void
func RwMutex.writeUnlock(m: RwMutex): void
func RwMutex.withRead[T](m: RwMutex, f: func(): T): T
func RwMutex.withWrite[T](m: RwMutex, f: func(): T): T

type WaitGroup
func WaitGroup.new(): WaitGroup
func WaitGroup.add(wg: WaitGroup, n: int): void
func WaitGroup.done(wg: WaitGroup): void
func WaitGroup.wait(wg: WaitGroup, ctx: Context | null = null): void

type Once
func Once.new(): Once
func Once.do[T](once: Once, f: func(): T): void
func Once.value[T](f: func(): T): func(): T

type Cond
func Cond.new(m: Mutex): Cond
func Cond.wait(c: Cond): void
func Cond.signal(c: Cond): void
func Cond.broadcast(c: Cond): void

type Atomic[T]
func Atomic.new[T](v: T): Atomic[T]
func Atomic.load[T](a: Atomic[T]): T
func Atomic.store[T](a: Atomic[T], v: T): void
func Atomic.add[T: Number](a: Atomic[T], d: T): T
func Atomic.compareAndSwap[T](a: Atomic[T], expected: T, v: T): bool

type Context
func Context.new(timeout: Time.Duration | null = null, parent: Context | null = null): Context
func Context.cancel(ctx: Context): void
func Context.isDone(ctx: Context): bool
func Context.reason(ctx: Context): string | null
func Context.deadline(ctx: Context): Time.Instant | null
func Context.wait(ctx: Context): void

