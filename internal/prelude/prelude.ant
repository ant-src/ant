// Http

type Http.Response = { status: int, headers: Map[string, string], body: string }
func Http.request(method: string, url: string, body: string = "", headers: Map[string, string] = Map{}, timeout: Time.Duration | null = null): Result[Http.Response, Error]
func Http.get(url: string, headers: Map[string, string] = Map{}, timeout: Time.Duration | null = null): Result[Http.Response, Error]
func Http.post(url: string, body: string, headers: Map[string, string] = Map{}, timeout: Time.Duration | null = null): Result[Http.Response, Error]

// Time (stdlib.md): the types are opaque and carry a tag is tests; the options are
// enumerations of empty records.

type Time.Zone
type Time.Instant
type Time.ZonedDateTime
type Time.PlainDate
type Time.PlainTime
type Time.PlainDateTime
type Time.Point = Time.Instant | Time.ZonedDateTime | Time.PlainDate | Time.PlainTime | Time.PlainDateTime
type Time.Wall = Time.ZonedDateTime | Time.PlainDate | Time.PlainTime | Time.PlainDateTime
type Time.Dated = Time.ZonedDateTime | Time.PlainDate | Time.PlainDateTime
type Time.Timed = Time.ZonedDateTime | Time.PlainTime | Time.PlainDateTime
type Time.Duration
type Time.Compatible = {}
type Time.Earlier = {}
type Time.Later = {}
type Time.Disambiguation = Time.Compatible | Time.Earlier | Time.Later
type Time.Year = {}
type Time.Month = {}
type Time.Week = {}
type Time.Day = {}
type Time.Hour = {}
type Time.Minute = {}
type Time.Second = {}
type Time.Millisecond = {}
type Time.Microsecond = {}
type Time.Nanosecond = {}
type Time.Unit = Time.Year | Time.Month | Time.Week | Time.Day | Time.Hour | Time.Minute | Time.Second | Time.Millisecond | Time.Microsecond | Time.Nanosecond
type Time.Ceil = {}
type Time.Floor = {}
type Time.Expand = {}
type Time.Trunc = {}
type Time.HalfCeil = {}
type Time.HalfFloor = {}
type Time.HalfExpand = {}
type Time.HalfTrunc = {}
type Time.HalfEven = {}
type Time.RoundingMode = Time.Ceil | Time.Floor | Time.Expand | Time.Trunc | Time.HalfCeil | Time.HalfFloor | Time.HalfExpand | Time.HalfTrunc | Time.HalfEven

var Time.utc: Time.Zone
func Time.zone(id: string): Result[Time.Zone, Error]
func Time.localZone(): Time.Zone
func Time.zoneId(z: Time.Zone): string

func Time.now(): Time.Instant
func Time.nowIn(z: Time.Zone): Time.ZonedDateTime
func Time.sleep(ms: int, ctx: Context | null = null): void
func Time.monotonic(): int
func Time.fromEpochMillis(ms: int): Time.Instant
func Time.fromEpochNanos(ns: int): Time.Instant
func Time.epochMillis(t: Time.Instant | Time.ZonedDateTime): int
func Time.epochNanos(t: Time.Instant | Time.ZonedDateTime): int

func Time.plainDate(year: int, month: int, day: int): Time.PlainDate
func Time.plainTime(hour: int = 0, minute: int = 0, second: int = 0, millisecond: int = 0, microsecond: int = 0, nanosecond: int = 0): Time.PlainTime
func Time.plainDateTime(date: Time.PlainDate, time: Time.PlainTime): Time.PlainDateTime
func Time.duration(years: int = 0, months: int = 0, weeks: int = 0, days: int = 0, hours: int = 0, minutes: int = 0, seconds: int = 0, milliseconds: int = 0, microseconds: int = 0, nanoseconds: int = 0): Time.Duration

func Time.parseInstant(s: string): Result[Time.Instant, Error]
func Time.parseZoned(s: string, disambiguation: Time.Disambiguation = Time.Compatible{}): Result[Time.ZonedDateTime, Error]
func Time.parsePlainDate(s: string): Result[Time.PlainDate, Error]
func Time.parsePlainTime(s: string): Result[Time.PlainTime, Error]
func Time.parsePlainDateTime(s: string): Result[Time.PlainDateTime, Error]
func Time.parseDuration(s: string): Result[Time.Duration, Error]

func Time.inZone(t: Time.Instant, z: Time.Zone): Time.ZonedDateTime
func Time.withZone(t: Time.ZonedDateTime, z: Time.Zone): Time.ZonedDateTime
func Time.toZoned(t: Time.PlainDateTime, z: Time.Zone, disambiguation: Time.Disambiguation = Time.Compatible{}): Time.ZonedDateTime
