// spec: fmt 4.2 Blank lines
// Runs of blank lines become one; none after an opening bracket or before a closing one.
type A = { x: int }

type B = { y: int }
func main() {
  var a = 1

  var b = 2

  println([
    a,

    b,
  ])
}

// A line that held only a dropped ; or , is not a blank line.
func separators(a: int, b: int): void {
  var x = 1
  var y = 2
  separators(
    a,
    b,
  )
}

// a comment kept from documenting by a ;

func after(): void {}
