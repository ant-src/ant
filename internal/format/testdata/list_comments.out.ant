// spec: fmt 4.4 Lists
// A comma goes before the comment that follows its item, whichever side the author put it.
func f(a: int, b: int): int { a + b }

func main() {
  println(f(
    1, // one
    2,
  ))
  println(f(
    1, // one
    2, // two
  ))
  println(f(1, /* inline */ 2))
  println(f( // after the bracket
    1, 2,
  ))
  println(f(
    /* leads the first item */ 1,
    2,
  ))
  println(f(/* flat */ 1, 2))
  // an empty list that holds a comment is broken, and the comment takes the place of an item
  println(f(
    /* none */
  ))
  var none = [
    /* not yet */
  ]
  var empty = Map{
    /* later */
  }
  // a comment that ends the bracket's line stays there, as a trailing comment does
  var line = [ // none yet
  ]
  var block = [ /* none yet */
  ]
  var both = [
    /* first */ // second
  ]
}
