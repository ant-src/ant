// spec: fmt 4.3 Statements and blocks
func counter(): func(): int {
  var n = 0
  func() { n += 1; n }
}

func main() {
  var a = 1
  var b = 2
  if a < b { println(a) } else {}
  var f = Array.map([1], { x * 2 })
  Array.forEach(f, {
    println(x)
    println(x)
  })
  var g = { // keeps the block broken
    1
  }
  println(a) // the semicolon goes
  var h = func(): int { println(a); /* leads the next statement */ 1 }
  var pat = func(): Regex.Pattern { println(a); /x/ }
  var pat2 = func(): Regex.Pattern {
    println(a);
    /y/
  }
}

// At the top level too, the semicolon before a pattern stays.
println(1);
/z/
